local function entry(key: string): Entry?
	return S[key]
end

function Locale.Has(key: string): boolean
	return S[key] ~= nil
end

-- Normalises a Roblox LocaleId ("uk-ua", "ru-ru", "en-us") or a saved code to one of our languages.
function Locale.Resolve(code: any): Lang
	if type(code) ~= "string" then
		return Locale.Default
	end
	local prefix = string.lower(string.sub(code, 1, 2))
	if prefix == "uk" or prefix == "ru" or prefix == "en" then
		return prefix :: Lang
	end
	return Locale.Default
end

function Locale.IsLanguage(code: any): boolean
	return code == "uk" or code == "ru" or code == "en"
end

-- Argument references, resolved in the reader's language.
function Locale.Item(itemId: string): { [string]: any }
	return { ref = "item." .. itemId .. ".name" }
end

function Locale.Upgrade(upgradeId: string): { [string]: any }
	return { ref = "upgrade." .. upgradeId .. ".name" }
end

function Locale.Cost(cost: { [string]: number }): { [string]: any }
	return { cost = cost }
end

local function raw(lang: Lang, key: string): string
	local e = entry(key)
	if not e then
		return key
	end
	return (e :: any)[lang] or e.en
end

local function resolveArg(lang: Lang, arg: any): any
	if type(arg) ~= "table" then
		return arg
	end
	if type(arg.ref) == "string" then
		return raw(lang, arg.ref)
	end
	if type(arg.cost) == "table" then
		local parts = {}
		for _, itemId in ItemDefinitions.Order do
			local amount = arg.cost[itemId]
			if type(amount) == "number" then
				table.insert(parts, ("%d %s"):format(amount, raw(lang, "item." .. itemId .. ".name")))
			end
		end
		return table.concat(parts, " + ")
	end
	return ""
end

function Locale.T(lang: Lang, key: string, ...: any): string
	local text = raw(lang, key)
	local count = select("#", ...)
	if count == 0 then
		return text
	end
	local args = table.pack(...)
	for i = 1, count do
		args[i] = resolveArg(lang, args[i])
	end
	local ok, result = pcall(string.format, text, table.unpack(args, 1, count))
	return if ok then result else text
end

-- Renders a message sent by the server: a key, or { key, arg1, arg2, ... }.
function Locale.Format(lang: Lang, message: any): string
	if type(message) == "string" then
		return Locale.T(lang, message)
	end
	if type(message) == "table" and type(message[1]) == "string" then
		return Locale.T(lang, message[1], table.unpack(message, 2))
	end
	return ""
end

function Locale.ItemName(lang: Lang, itemId: string): string
	return raw(lang, "item." .. itemId .. ".name")
end

function Locale.ItemDesc(lang: Lang, itemId: string): string
	return raw(lang, "item." .. itemId .. ".desc")
end

function Locale.UpgradeName(lang: Lang, upgradeId: string): string
	return raw(lang, "upgrade." .. upgradeId .. ".name")
end

-- The language a player reads in: the one picked in the Roblox menu (Player.LocaleId), English otherwise.
function Locale.ForPlayer(player: Player): Lang
	return Locale.Resolve(player.LocaleId)
end

return Locale
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="63">
        <Properties>
          <string name="Name">MonetizationConfig</string>
          <string name="Source">--!strict
-- Monetization is OFF for the MVP. This file is the single place to switch it on later.
-- Planned direction (not final): cosmetic / light-convenience Game Passes and a
-- "backpack insurance" Developer Product. No paid resources and no paid floor skips.

export type PassDef = {
	id: number, -- Game Pass asset id from the Creator Dashboard (0 = not created yet)
	-- Effects the game understands. Leave a field nil for no effect.
	inventoryBonus: number?,
	cosmetic: string?,
}

export type ProductDef = {
	id: number, -- Developer Product id (0 = not created yet)
	-- Name of a handler registered in MonetizationService.RegisterProductHandler.
	handler: string,
}

local MonetizationConfig = {
	Enabled = false,

	GamePasses = {
		-- BiggerBackpack = { id = 0, inventoryBonus = 5 },
		-- LanternColors = { id = 0, cosmetic = "LanternColors" },
	} :: { [string]: PassDef },

	DeveloperProducts = {
		-- BackpackInsurance = { id = 0, handler = "BackpackInsurance" },
		-- SelfRevive = { id = 0, handler = "SelfRevive" }, -- get up from downed without a teammate
		-- Donation100 = { id = 0, handler = "Donation" },
	} :: { [string]: ProductDef },
}

return MonetizationConfig
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="64">
        <Properties>
          <string name="Name">MusicConfig</string>
          <string name="Source">--!strict
-- Background music. All tracks are free licensed audio from the Roblox Creator Store
-- (uploaded by the verified DistroKid / APM accounts), so they play in any experience.
-- Swap ids here to change the soundtrack.

local MusicConfig = {
	Volume = 0.12, -- quiet background so sound effects stay clear
	FadeSeconds = 3,

	-- Calm, melancholic tracks for the roof base and the neighbour tower.
	Roof = {
		124181322816807, -- Deserted Embers
		123927270887272, -- Fading World Strings
		71882714223295, -- Silent Ruins Motif
		103760117708996, -- Post Apocalyptic Lullaby
	},

	-- Tense drones for the floors below.
	Below = {
		106752035160966, -- Siberian Wasteland Underscore (Ambient Only)
		139935905572584, -- Corroded Industrial Drone
		140252461454906, -- Subterranean Steel Drones
	},
}

return MusicConfig
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="65">
        <Properties>
          <string name="Name">PlacesConfig</string>
          <string name="Source">--!strict
-- Place ids of the experience. Fill these in after publishing both places
-- (Creator Dashboard &gt; your experience &gt; Places). 0 = not published yet: teleports are disabled
-- and the tower runs every server as solo.

local PlacesConfig = {
	-- Shown in the lobby and printed on start, so it is easy to see which build is published.
	Build = "b15 · drop-chest-hud-zombies",

	LobbyPlaceId = 128619231370772,
	TowerPlaceId = 104145307601846,

	-- Lobby owns live lifts; mirrored here for PlaceIds / build stamp only.
	Lifts = {
		{ id = "LiftA", countdown = 20, fullCountdown = 5 },
		{ id = "LiftB", countdown = 20, fullCountdown = 5 },
	},
	MinPartySize = 2,
	MaxPartySize = 6,

	-- Party hand-off from the lobby to the reserved tower server.
	PartyMapName = "SkylineZero_Parties",
	PartyTtlSeconds = 600,
	TeleportRetries = 3,

	-- Leaderboard shown in the lobby: towers completed per player.
	LeaderboardStoreName = "SkylineZero_TowersCompleted",
	LeaderboardSize = 10,
	LeaderboardRefreshSeconds = 60,
}

return PlacesConfig
</string>
