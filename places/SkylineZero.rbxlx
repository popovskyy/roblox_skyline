      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">GameConfig</string>
          <string name="Source">--!strict
-- Balance and shared settings. Every tunable number lives here.

local GameConfig = {
	-- Inventory and storage
	MaxInventoryWeight = 20,
	StorageCapacity = 60,

	-- Health
	StartingHealth = 100,
	MedkitHeal = 35,

	-- Hazards
	FallDamageThreshold = 18,
	FallDamagePerStud = 2,
	ToxicDamagePerSecond = 8,
	ToxicGraceSeconds = 2,
	AirFilterToxicReduction = 0.75,
	HazardTickSeconds = 0.25,

	-- Hunger meter: empties over time (faster below the roof), Food refills it, empty = slow health loss.
	-- Full to empty takes about 6 min below the roof and about 11 min resting on it.
	HungerMax = 100,
	HungerDrainBelow = 0.28,
	HungerDrainRoof = 0.15,
	HungerWarnAt = 25,
	FoodRestore = 35,
	HungerDamagePerSecond = 1,

	-- Flashlight: battery drains while switched on, charges next to a built Generator.
	FlashlightBatterySeconds = 240,
	FlashlightChargePerSecond = 20,
	FlashlightChargeRadius = 16,

	-- Interaction
	InteractionDistance = 12,
	InteractionCooldown = 0.35,
	PromptActivationDistance = 10,

	-- Resource nodes. Per player; normal nodes refill when the player returns to the roof.
	-- Unique nodes (Crowbar, Flashlight, notes) never refill.
	ResourceRespawnSeconds = 0,
	ResetNodesOnRoofReturn = true,

	-- Death: carried items except protected ones drop as a personal backpack at the death spot.
	DeathProtectedItems = {
		Crowbar = true,
		Flashlight = true,
		Club = true,
		Pipe = true,
		Machete = true,
	} :: { [string]: boolean },
	BackpackDropLifetimeSeconds = 900,
	-- Intentional party drops (not death backpacks).
	GroundDropLifetimeSeconds = 120,
	RespawnDelaySeconds = 3,

	-- Combat and zombies
	Zombie = {
		MaxHealth = 60,
		WalkSpeed = 11, -- players run at 16, so running away works
		Damage = 12,
		AttackCooldown = 1.2,
		AttackRange = 4.5,
		AggroRange = 45,
		RespawnSeconds = 45, -- backlog: stop respawn after floor clear (ZombieService)
		-- Design targets: tutorial 4–6, mid 12–18, deep 18–24 (scaled for 240 plate).
		PerFloor = { 5, 14, 16, 20 }, -- floors 1..4; the roof is always safe
	},

	-- Downed instead of dead: you lie there until a teammate with a Bandage lifts you up.
	-- Everyone down = the match is lost; after GameOverSeconds the party goes back to the lobby.
	ReviveHealth = 35,
	GameOverSeconds = 8,
	ReviveHoldSeconds = 3,

	-- Loot crates: each roll picks "count" from min..max; "chance" makes the item optional.
	LootTables = {
		Common = {
			{ item = "Scrap", min = 1, max = 3 },
			{ item = "Food", min = 1, max = 2, chance = 0.7 },
			{ item = "Bandage", min = 1, max = 1, chance = 0.25 },
		},
		Rare = {
			{ item = "Scrap", min = 2, max = 4 },
			{ item = "Electronics", min = 1, max = 2 },
			{ item = "Bandage", min = 1, max = 1, chance = 0.5 },
			{ item = "Medkit", min = 1, max = 1, chance = 0.3 },
			{ item = "Pipe", min = 1, max = 1, chance = 0.2 },
		},
		Gold = {
			{ item = "Electronics", min = 2, max = 3 },
			{ item = "Bandage", min = 1, max = 2 },
			{ item = "Medkit", min = 1, max = 1 },
			{ item = "Pipe", min = 1, max = 1, chance = 0.35 },
			{ item = "Machete", min = 1, max = 1, chance = 0.2 },
		},
		Diamond = {
			{ item = "Electronics", min = 3, max = 4 },
			{ item = "Cable", min = 1, max = 1 },
			{ item = "Bandage", min = 2, max = 2 },
			{ item = "Medkit", min = 1, max = 1 },
			{ item = "Machete", min = 1, max = 1, chance = 0.6 },
		},
	} :: { [string]: { { item: string, min: number, max: number, chance: number? } } },

	-- Workbench on the roof.
	Recipes = {
		{ id = "Bandage", cost = { Food = 1, Scrap = 1 } },
		{ id = "Pipe", cost = { Scrap = 4 } },
		{ id = "Machete", cost = { Scrap = 5, Electronics = 2 } },
	} :: { { id: string, cost: { [string]: number } } },

	-- Testing: every upgrade costs 1 of each listed item. Never ship with this on.
	TestPrices = false,

	-- Server and saving
	MaxPlayersPerServer = 6,
	-- false: every match starts from zero (only the lobby leaderboard survives). true: progress is saved.
	PersistProgress = false,
	AutosaveIntervalSeconds = 120,
	DataStoreName = "SkylineZero_PlayerData_v1",
	SchemaVersion = 1,
	DataRetryAttempts = 3,
	DataRetryDelaySeconds = 2,

	-- World layout (studs). Locked plate: 240×240 (~10–12s sprint cross). See game-design-loops.md.
	-- Layout coords in WorldBuilder were authored at REF_FLOOR_SIZE=70; scale with World.FloorSize/70.
	World = {
		Mode = "Generated" :: "Generated" | "Manual",
		FolderName = "GeneratedWorld",
		RoofY = 396, -- top surface of the roof slab
		FloorSpacing = 24,
		FloorCount = 4,
		RoofSize = 280,
		FloorSize = 240,
		RefFloorSize = 70, -- authoring reference for layout scale helper
		SlabThickness = 2,
		NeighborOffsetX = 400, -- centre of the neighbour tower roof
	},
}

return GameConfig
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">ItemDefinitions</string>
          <string name="Source">--!strict
-- Every item the game knows about. Unknown IDs are rejected everywhere.

export type ItemDef = {
	id: string,
	displayName: string,
	weight: number,
	startAmount: number,
	description: string,
	storable: boolean, -- tools stay with the player and never go into storage
	icon: string, -- emoji placeholder until real icons are drawn
	iconImage: string?, -- rbxassetid://... once an icon is uploaded; wins over the emoji
	color: Color3, -- slot accent colour
	weapon: WeaponStats?, -- melee weapons; the best one carried is the one in the player's hands
}

export type WeaponStats = {
	damage: number,
	cooldown: number, -- seconds between swings
	range: number, -- studs in front of the player
	rank: number, -- higher rank wins when several are carried
}

local Items: { [string]: ItemDef } = {
	Club = {
		id = "Club",
		icon = "🏏",
		color = Color3.fromRGB(150, 110, 70),
		displayName = "Дубина",
		weight = 0,
		startAmount = 1,
		description = "",
		storable = false,
		weapon = { damage = 12, cooldown = 0.7, range = 6, rank = 1 },
	},
	Pipe = {
		id = "Pipe",
		icon = "🔨",
		color = Color3.fromRGB(140, 145, 155),
		displayName = "Труба",
		weight = 2,
		startAmount = 0,
		description = "",
		storable = false,
		weapon = { damage = 22, cooldown = 0.75, range = 6.5, rank = 2 },
	},
	Machete = {
		id = "Machete",
		icon = "🔪",
		color = Color3.fromRGB(200, 205, 215),
		displayName = "Мачете",
		weight = 2,
		startAmount = 0,
		description = "",
		storable = false,
		weapon = { damage = 34, cooldown = 0.6, range = 7, rank = 3 },
	},
	Bandage = {
		id = "Bandage",
		icon = "🩹",
		color = Color3.fromRGB(235, 220, 200),
		displayName = "Бинт",
		weight = 1,
		startAmount = 0,
		description = "",
		storable = true,
	},
	Scrap = {
		id = "Scrap",
		icon = "🔩",
		color = Color3.fromRGB(150, 110, 80),
		displayName = "Металобрухт",
		weight = 1,
		startAmount = 0,
		description = "Основа для будь-якого поліпшення.",
		storable = true,
	},
	Electronics = {
		id = "Electronics",
		icon = "💾",
		color = Color3.fromRGB(70, 170, 110),
		displayName = "Електронні деталі",
		weight = 1,
		startAmount = 0,
		description = "Потрібні для генератора й фільтра.",
		storable = true,
	},
	Food = {
		id = "Food",
		icon = "🥫",
		color = Color3.fromRGB(220, 140, 50),
		displayName = "Їжа",
		weight = 1,
		startAmount = 3,
		description = "Кожен спуск з'їдає 1 їжу. Без неї через 3 хв почнеш слабшати.",
		storable = true,
	},
	Medkit = {
		id = "Medkit",
		icon = "💉",
		color = Color3.fromRGB(220, 70, 70),
		displayName = "Аптечка",
		weight = 2,
		startAmount = 1,
		description = "Відновлює 35 здоров'я.",
		storable = true,
	},
	Cable = {
		id = "Cable",
		icon = "🧵",
		color = Color3.fromRGB(90, 90, 100),
		displayName = "Кабель",
		weight = 2,
		startAmount = 0,
		description = "Рідкісний. Лежить у руїнах 4 поверху. Потрібен для мосту.",
		storable = true,
	},
	Motor = {
		id = "Motor",
		icon = "⚙️",
		color = Color3.fromRGB(100, 130, 170),
		displayName = "Мотор",
		weight = 3,
		startAmount = 0,
		description = "Рідкісний. Захований за завалами 4 поверху. Потрібен для мосту.",
		storable = true,
	},
	Crowbar = {
		id = "Crowbar",
		icon = "🔧",
		color = Color3.fromRGB(180, 60, 50),
		displayName = "Лом",
		weight = 3,
		startAmount = 0,
		description = "Розбирає завали з позначкою «Лом».",
		storable = false,
	},
	Flashlight = {
		id = "Flashlight",
		icon = "🔦",
		color = Color3.fromRGB(230, 200, 60),
		displayName = "Ліхтарик",
		weight = 1,
		startAmount = 0,
		description = "Клавіша F. Заряджається біля генератора.",
		storable = false,
	},
}

-- Display order in the UI.
local Order = {
	"Club",
	"Pipe",
	"Machete",
	"Scrap",
	"Electronics",
	"Food",
	"Medkit",
	"Bandage",
	"Cable",
	"Motor",
	"Crowbar",
	"Flashlight",
}

local ItemDefinitions = {
	Items = Items,
	Order = Order,
}

function ItemDefinitions.Get(id: string): ItemDef?
	return Items[id]
end

-- The strongest weapon among the carried items, or nil.
function ItemDefinitions.BestWeapon(inventory: { [string]: number }): ItemDef?
	local best: ItemDef? = nil
	for id, count in inventory do
		local def = Items[id]
		if def and def.weapon and count &gt; 0 and (not best or def.weapon.rank &gt; (best.weapon :: WeaponStats).rank) then
			best = def
		end
	end
	return best
end

function ItemDefinitions.IsValid(id: any): boolean
	return type(id) == "string" and Items[id] ~= nil
end

return ItemDefinitions
