    <Item class="StarterCharacterScripts" referent="102">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="Script" referent="103">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source">-- Replaces Roblox's default "Health" script, which regenerates 1% health per second.
-- Skyline Zero heals only through Medkits, so this script is intentionally empty.
</string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="104">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="105">
        <Properties>
          <string name="Name">ClientMain</string>
          <string name="Source">--!strict
-- Client entry point. Controllers only draw UI and local visuals; the server owns all game state.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Make sure the shared modules have replicated before anything requires them.
local Shared = ReplicatedStorage:WaitForChild("Shared")
for _, name in
	{ "GameConfig", "ItemDefinitions", "UpgradeDefinitions", "RemoteNames", "Types", "MusicConfig", "Locale", "Theme" }
do
	Shared:WaitForChild(name)
end

local RemoteNames = require(Shared:WaitForChild("RemoteNames"))
local Controllers = script.Parent:WaitForChild("Controllers")

local ClientState = require(Controllers:WaitForChild("ClientState"))
local Lang = require(Controllers:WaitForChild("Lang"))
local HUDController = require(Controllers:WaitForChild("HUDController"))
local InventoryController = require(Controllers:WaitForChild("InventoryController"))
local InteractionController = require(Controllers:WaitForChild("InteractionController"))
local MusicController = require(Controllers:WaitForChild("MusicController"))
local ObjectiveMarkerController = require(Controllers:WaitForChild("ObjectiveMarkerController"))
local DownedMarkerController = require(Controllers:WaitForChild("DownedMarkerController"))
local CombatController = require(Controllers:WaitForChild("CombatController"))
local IntroController = require(Controllers:WaitForChild("IntroController"))
local TutorialController = require(Controllers:WaitForChild("TutorialController"))
local WorldVisualsController = require(Controllers:WaitForChild("WorldVisualsController"))

local remotes = ReplicatedStorage:WaitForChild("Remotes") :: Folder
local function remote(name: string): RemoteEvent
	return remotes:WaitForChild(name) :: RemoteEvent
end

HUDController.Start()
InventoryController.Start(remotes)
InteractionController.Start(remotes)
TutorialController.Start()
WorldVisualsController.Start()
MusicController.Start()
ObjectiveMarkerController.Start()
DownedMarkerController.Start()
CombatController.Start(remotes)
IntroController.Start()

remote(RemoteNames.StateChanged).OnClientEvent:Connect(function(snapshot)
	if type(snapshot) == "table" then
		ClientState.Set(snapshot)
	end
end)
remote(RemoteNames.Notify).OnClientEvent:Connect(function(message, kind)
	local text = Lang.Format(message)
	if text ~= "" then
		HUDController.Toast(text, if type(kind) == "string" then kind else nil)
	end
end)

-- Redraw everything in the new language.
Lang.Changed:Connect(function()
	local snapshot = ClientState.Get()
	if snapshot then
		ClientState.Set(snapshot)
	end
end)
remote(RemoteNames.ShowNote).OnClientEvent:Connect(TutorialController.ShowNote)
remote(RemoteNames.OpenStorage).OnClientEvent:Connect(InventoryController.OpenStorage)
remote(RemoteNames.OpenCraft).OnClientEvent:Connect(CombatController.OpenCraft)

-- Ask for the current state in case the first snapshot arrived before these listeners existed.
remote(RemoteNames.RequestState):FireServer()
</string>
        </Properties>
      </Item>
      <Item class="Folder" referent="106">
        <Properties>
          <string name="Name">Controllers</string>
        </Properties>
        <Item class="ModuleScript" referent="107">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source">--!strict
-- Latest state snapshot from the server plus a Changed signal. The client never edits it.

local ClientState = {}

local changed = Instance.new("BindableEvent")
local snapshot: { [string]: any }? = nil

ClientState.Changed = changed.Event

function ClientState.Set(newSnapshot: { [string]: any })
	snapshot = newSnapshot
	changed:Fire(newSnapshot)
end

function ClientState.Get(): { [string]: any }?
	return snapshot
end

return ClientState
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="108">
          <Properties>
            <string name="Name">CombatController</string>
            <string name="Source">--!strict
-- Client side of combat: swing input, the "you are down" screen, revive prompts and the workbench window.
-- Every decision (hits, damage, revives, crafting) is made by the server.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local ItemDefinitions = require(ReplicatedStorage.Shared.ItemDefinitions)
local Locale = require(ReplicatedStorage.Shared.Locale)
local RemoteNames = require(ReplicatedStorage.Shared.RemoteNames)
local Theme = require(ReplicatedStorage.Shared.Theme)
local ClientState = require(script.Parent.ClientState)
local Lang = require(script.Parent.Lang)
local UIKit = require(script.Parent.UIKit)

local CombatController = {}

local player = Players.LocalPlayer
local C = UIKit.Colors
local remotes: Folder

local function remote(name: string): RemoteEvent
	return remotes:FindFirstChild(name) :: RemoteEvent
end

local function attack()
	remote(RemoteNames.Attack):FireServer()
end

-- Our own hotbar replaces the Roblox backpack bar.
local function hideDefaultBackpack()
	for _ = 1, 20 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		end)
		if ok then
			return
		end
		task.wait(0.5)
	end
end

local function watchTool(character: Model)
	local function hook(child: Instance)
		if child:IsA("Tool") and child.Name == "Weapon" then
			child.Activated:Connect(attack)
		end
	end
	for _, child in character:GetChildren() do
		hook(child)
	end
	character.ChildAdded:Connect(hook)
end

-- Downed overlay -------------------------------------------------------------------------------------------
local downedFrame: Frame
local downedTimer: TextLabel

local function buildDowned(screen: ScreenGui)
	downedFrame = UIKit.New("Frame", {
		Name = "Downed",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(90, 0, 0),
		BackgroundTransparency = 0.6,
		Visible = false,
		ZIndex = 5,
		Parent = screen,
	})
	local title = UIKit.Label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.new(0.8, 0, 0, 70),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = Theme.Display,
		TextSize = 56,
		TextColor3 = Color3.fromRGB(255, 120, 110),
		ZIndex = 6,
		Parent = downedFrame,
	})
	Lang.Bind(title, "downed.title")
	downedTimer = UIKit.Label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.4, 44),
		Size = UDim2.new(0.8, 0, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 20,
		ZIndex = 6,
		Parent = downedFrame,
	})
end

local function updateDowned()
	local down = player:GetAttribute("Downed") == true
	downedFrame.Visible = down
	downedTimer.Text = Lang.T("downed.waitTeam")
end

-- Workbench window ---------------------------------------------------------------------------------------
local craftPanel: Frame
local craftList: ScrollingFrame

local function renderCraft()
	for _, child in craftList:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local s = ClientState.Get() or {}
	for order, recipe in GameConfig.Recipes do
		local def = ItemDefinitions.Items[recipe.id]
		local affordable = true
		for itemId, amount in recipe.cost do
			local have = (s.inventory and s.inventory[itemId] or 0) + (s.storage and s.storage[itemId] or 0)
			if have &lt; amount then
				affordable = false
			end
		end
		local row = UIKit.New("Frame", {
			Size = UDim2.new(1, -8, 0, 72),
			BackgroundColor3 = C.panelLight,
			BorderSizePixel = 0,
			LayoutOrder = order,
			Parent = craftList,
		}, { UIKit.Corner(8), UIKit.Padding(8) })
		UIKit.Label({
			Size = UDim2.fromOffset(56, 56),
			Text = def.icon,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = row,
		})
		UIKit.Label({
			Position = UDim2.fromOffset(66, 0),
			Size = UDim2.new(1, -200, 0, 28),
			Text = Lang.T("item." .. recipe.id .. ".name"),
			FontFace = Theme.Heading,
			TextSize = 22,
			Parent = row,
		})
		UIKit.Label({
			Position = UDim2.fromOffset(66, 28),
			Size = UDim2.new(1, -200, 0, 26),
			Text = Lang.T("prompt.needs", Locale.Cost(recipe.cost)),
			TextSize = 15,
			TextColor3 = if affordable then C.text else C.bad,
			Parent = row,
		})
		local button = UIKit.Button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.fromOffset(120, 48),
			Text = Lang.T("craft.button"),
			BackgroundColor3 = if affordable then Color3.fromRGB(60, 110, 60) else C.panel,
			TextColor3 = if affordable then C.text else C.muted,
			Parent = row,
		})
		button.Activated:Connect(function()
			remote(RemoteNames.Craft):FireServer(recipe.id)
		end)
	end
end

local function buildCraft(screen: ScreenGui)
	craftPanel = UIKit.Panel({
		Name = "Workbench",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(520, 360),
		BackgroundTransparency = 0.05,
		Visible = false,
		Parent = screen,
	})
	UIKit.Padding(14).Parent = craftPanel
	local title =
		UIKit.Label({ Size = UDim2.new(1, -44, 0, 30), FontFace = Theme.Display, TextSize = 26, Parent = craftPanel })
	Lang.Bind(title, "craft.title")
	local close = UIKit.Button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(36, 36),
		Text = "✕",
		Parent = craftPanel,
	})
	close.Activated:Connect(function()
		craftPanel.Visible = false
	end)
	craftList = UIKit.New("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 44),
		Size = UDim2.new(1, 0, 1, -44),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = craftPanel,
	})
	UIKit.New("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = craftList })
end

function CombatController.OpenCraft()
	craftPanel.Visible = true
	renderCraft()
end

function CombatController.Start(remoteFolder: Folder)
	remotes = remoteFolder
	local screen = UIKit.Screen()
	task.spawn(hideDefaultBackpack)
	buildDowned(screen)
	buildCraft(screen)

	if player.Character then
		watchTool(player.Character)
	end
	player.CharacterAdded:Connect(watchTool)
	player:GetAttributeChangedSignal("Downed"):Connect(updateDowned)
	updateDowned()

	-- Revive prompts: translate them, and never show players their own.
	ProximityPromptService.PromptShown:Connect(function(prompt)
		if prompt:GetAttribute("ReviveUserId") == nil then
			return
		end
		if prompt:GetAttribute("ReviveUserId") == player.UserId then
			prompt.Enabled = false
			return
		end
		prompt.ActionText = Lang.T("revive.action")
	end)

	-- A big hit button for touch screens (tapping the world also swings).
	if UserInputService.TouchEnabled then
		local hit = UIKit.Button({
			Name = "AttackButton",
			AnchorPoint = Vector2.new(1, 1),
			-- Left of the jump button, above the hotbar's right end.
			Position = UDim2.new(1, -118, 1, -16),
			Size = UDim2.fromOffset(84, 84),
			Text = "",
			TextSize = 20,
			BackgroundColor3 = Color3.fromRGB(150, 60, 50),
			Parent = screen,
		})
		-- Round button, only while a weapon is in hand.
		local corner = hit:FindFirstChildOfClass("UICorner")
		if corner then
			corner.CornerRadius = UDim.new(1, 0)
		end
		Lang.Bind(hit, "ui.attack")
		hit.Activated:Connect(attack)
		local function updateHit()
			hit.Visible = player:GetAttribute("Equipped") ~= nil
		end
		player:GetAttributeChangedSignal("Equipped"):Connect(updateHit)
		updateHit()
	end

	ClientState.Changed:Connect(function()
		if craftPanel.Visible then
			renderCraft()
		end
	end)
	Lang.Changed:Connect(function()
		updateDowned()
		if craftPanel.Visible then
			renderCraft()
		end
	end)

	-- Close the workbench window when walking away from it.
	task.spawn(function()
		while true do
			task.wait(0.5)
			if craftPanel.Visible then
				local world = workspace:FindFirstChild(GameConfig.World.FolderName)
				local interactables = world and world:FindFirstChild("Interactables")
				local bench = interactables and interactables:FindFirstChild("Workbench")
				local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				if
					not bench
					or not root
					or ((bench :: BasePart).Position - (root :: BasePart).Position).Magnitude &gt; 20
				then
					craftPanel.Visible = false
				end
			end
		end
	end)
end

return CombatController
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="109">
          <Properties>
            <string name="Name">HUDController</string>
            <string name="Source">--!strict
-- HUD: health, carry weight, flashlight battery, hazard warnings, objective and short messages.
-- Kept to the screen edges so the centre stays clear while exploring.

local Theme = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Theme"))
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local ClientState = require(script.Parent.ClientState)
local Lang = require(script.Parent.Lang)
local UIKit = require(script.Parent.UIKit)

local HUDController = {}

local player = Players.LocalPlayer
local C = UIKit.Colors

local healthFill: Frame
local healthText: TextLabel
local hungerFill: Frame
local hungerText: TextLabel
local flashlightText: TextLabel
local warningText: TextLabel
local objectiveText: TextLabel
local actsText: TextLabel
local toastHolder: Frame

local function buildStatusPanel(screen: ScreenGui)
	local panel = UIKit.Panel({
		Name = "Status",
		-- PC/console: bottom-left (chat sits top-left). Touch: top-left, because the thumbstick owns bottom-left.
		AnchorPoint = if UserInputService.TouchEnabled then Vector2.new(0, 0) else Vector2.new(0, 1),
		Position = if UserInputService.TouchEnabled then UDim2.fromOffset(12, 56) else UDim2.new(0, 12, 1, -12),
		Size = UDim2.fromOffset(230, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = screen,
	})
	UIKit.Padding(10).Parent = panel
	UIKit.New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = panel })

	local bar = UIKit.New("Frame", {
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundColor3 = C.panelLight,
		BorderSizePixel = 0,
		LayoutOrder = 1,
		Parent = panel,
	}, { UIKit.Corner(6) })
	healthFill = UIKit.New("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.health,
		BorderSizePixel = 0,
		Parent = bar,
	}, { UIKit.Corner(6) })
	healthText = UIKit.Label({
		Size = UDim2.fromScale(1, 1),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = Theme.Bold,
		TextSize = 14,
		ZIndex = 2,
		Parent = bar,
	})
	local hungerBar = UIKit.New("Frame", {
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundColor3 = C.panelLight,
		BorderSizePixel = 0,
		LayoutOrder = 2,
		Parent = panel,
	}, { UIKit.Corner(6) })
	hungerFill = UIKit.New("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(214, 150, 60),
		BorderSizePixel = 0,
		Parent = hungerBar,
	}, { UIKit.Corner(6) })
	hungerText = UIKit.Label({
		Size = UDim2.fromScale(1, 1),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = Theme.Bold,
		TextSize = 14,
		ZIndex = 2,
		Parent = hungerBar,
	})
	flashlightText = UIKit.Label({
		Size = UDim2.new(1, 0, 0, 20),
		Text = "",
		TextColor3 = C.muted,
		LayoutOrder = 4,
		Visible = false,
		Parent = panel,
	})
	warningText = UIKit.Label({
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = "",
		FontFace = Theme.Bold,
		TextColor3 = C.warn,
		LayoutOrder = 5,
		Parent = panel,
	})
end

local function buildObjective(screen: ScreenGui)
	local panel = UIKit.Panel({
		Name = "Objective",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		-- Narrow enough to never reach the buttons in the top-right corner.
		Size = UDim2.fromScale(0.42, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = screen,
	})
	UIKit.New("UISizeConstraint", { MaxSize = Vector2.new(460, 120), Parent = panel })
	UIKit.Padding(8).Parent = panel
	objectiveText = UIKit.Label({
		Size = UDim2.new(1, -78, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = "",
		TextSize = 15,
		Parent = panel,
	})
	actsText = UIKit.Label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(74, 20),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = C.accent,
		TextSize = 14,
		Parent = panel,
	})
end

local function buildToasts(screen: ScreenGui)
	toastHolder = UIKit.New("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 72),
		Size = UDim2.fromOffset(320, 300),
		BackgroundTransparency = 1,
		Parent = screen,
	})
	UIKit.New("UIListLayout", {
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		Parent = toastHolder,
	})
end

local toastCounter = 0
local KIND_COLORS = {
	info = C.text,
	success = C.good,
	warning = C.warn,
	error = C.bad,
}

function HUDController.Toast(text: string, kind: string?)
	toastCounter += 1
	local children = toastHolder:GetChildren()
	local toasts = {}
	for _, child in children do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	if #toasts &gt;= 4 then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder &lt; b.LayoutOrder
		end)
		toasts[1]:Destroy()
	end
	local toast = UIKit.Panel({
		Size = UDim2.fromOffset(320, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = toastCounter,
		Parent = toastHolder,
	})
	UIKit.Padding(8).Parent = toast
	local label = UIKit.Label({
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = text,
		TextSize = 15,
		TextColor3 = KIND_COLORS[kind or "info"] or C.text,
		Parent = toast,
	})
	task.delay(3.5, function()
		if toast.Parent then
			local info = TweenInfo.new(0.4)
			TweenService:Create(toast, info, { BackgroundTransparency = 1 }):Play()
			TweenService:Create(label, info, { TextTransparency = 1 }):Play()
			task.wait(0.45)
			toast:Destroy()
		end
	end)
end

local function updateHunger()
	local value = player:GetAttribute("Hunger")
	local hunger = if type(value) == "number" then value else 100
	hungerFill.Size = UDim2.fromScale(math.clamp(hunger / 100, 0, 1), 1)
	hungerFill.BackgroundColor3 = if hunger &lt;= 25 then C.bad else Color3.fromRGB(214, 150, 60)
	hungerText.Text = Lang.T("hud.hunger", math.floor(hunger))
end

local function updateHealth()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local ratio = if humanoid.MaxHealth &gt; 0 then math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1) else 0
	healthFill.Size = UDim2.fromScale(ratio, 1)
	healthText.Text = Lang.T("hud.health", math.ceil(humanoid.Health), humanoid.MaxHealth)
end

local function updateWarnings()
	local lines = {}
	if player:GetAttribute("InToxic") == true then
		table.insert(lines, Lang.T("hud.toxic"))
	end
	if player:GetAttribute("Hungry") == true then
		table.insert(lines, Lang.T("hud.hungry"))
	end
	warningText.Text = table.concat(lines, "\n")
end

local function updateFlashlight()
	local s = ClientState.Get()
	local has = s ~= nil and s.inventory ~= nil and (s.inventory.Flashlight or 0) &gt; 0
	flashlightText.Visible = has
	if not has then
		return
	end
	local charge = player:GetAttribute("FlashlightCharge")
	local seconds = if type(charge) == "number" then charge else (s and s.flashlightCharge or 0)
	local on = player:GetAttribute("FlashlightOn") == true
	flashlightText.Text = Lang.T("hud.flashlight", Lang.T(if on then "hud.on" else "hud.off"), seconds) .. "  [F]"
	flashlightText.TextColor3 = if seconds &lt;= 0 then C.bad elseif on then C.accent else C.muted
end

local function objectiveLine(s: { [string]: any }): string
	local tutorial = s.tutorial
	if not tutorial then
		return ""
	end
	if tutorial.done then
		return Lang.T("hud.objective", { ref = "tutorial.done" })
	end
	local step = tutorial.step
	local inv = s.inventory or {}
	local storage = s.storage or {}
	local function total(id: string): number
		return (inv[id] or 0) + (storage[id] or 0)
	end
	-- Live n/m for loot steps (gap-report G1.1 / first-session-ux §3).
	if step == 2 then
		return Lang.T("hud.objective", Lang.T("tutorial.scrapProgress", math.min(total("Scrap"), 3), 3))
	elseif step == 5 then
		return Lang.T("hud.objective", Lang.T("tutorial.elecProgress", math.min(total("Electronics"), 4), 4))
	end
	return Lang.T("hud.objective", { ref = tutorial.text })
end

local function onState(s: { [string]: any })
	objectiveText.Text = objectiveLine(s)
	actsText.Text = Lang.T("hud.systems", s.acts or 0)
	updateFlashlight()
end

local function watchCharacter(character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid and humanoid:IsA("Humanoid") then
		humanoid.HealthChanged:Connect(updateHealth)
		humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(updateHealth)
		updateHealth()
	end
end

-- Only shown once the lobby place exists (PlacesConfig.LobbyPlaceId).
local function buildLobbyButton(screen: ScreenGui)
	local PlacesConfig = require(game:GetService("ReplicatedStorage").Shared.PlacesConfig)
	if PlacesConfig.LobbyPlaceId == 0 then
		return
	end
	local button = UIKit.Button({
		Name = "LobbyButton",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -64, 0, 8),
		Size = UDim2.fromOffset(84, 44),
		Text = "",
		TextSize = 15,
		Parent = screen,
	})
	Lang.Bind(button, "ui.toLobby")
	button.Activated:Connect(function()
		local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
		local remote = remotes and remotes:FindFirstChild("ReturnToLobby")
		if remote and remote:IsA("RemoteEvent") then
			remote:FireServer()
		end
	end)
end

function HUDController.Start()
	local screen = UIKit.Screen()
	buildLobbyButton(screen)
	buildStatusPanel(screen)
	buildObjective(screen)
	buildToasts(screen)

	ClientState.Changed:Connect(onState)
	Lang.Changed:Connect(function()
		updateHealth()
		updateWarnings()
	end)
	player:GetAttributeChangedSignal("InToxic"):Connect(updateWarnings)
	player:GetAttributeChangedSignal("Hungry"):Connect(updateWarnings)
	player:GetAttributeChangedSignal("Hunger"):Connect(updateHunger)
	Lang.Changed:Connect(updateHunger)
	updateHunger()
	player:GetAttributeChangedSignal("FlashlightCharge"):Connect(updateFlashlight)
	player:GetAttributeChangedSignal("FlashlightOn"):Connect(updateFlashlight)
	if player.Character then
		task.spawn(watchCharacter, player.Character)
	end
	player.CharacterAdded:Connect(watchCharacter)
end

return HUDController
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="110">
          <Properties>
            <string name="Name">InteractionController</string>
            <string name="Source">--!strict
-- Input for interactions: ProximityPrompts handle E / gamepad / tapping the prompt; touch devices also get
-- a big "Взаємодія" button for the closest prompt. F (or a touch button) toggles the flashlight.

local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local RemoteNames = require(ReplicatedStorage.Shared.RemoteNames)
local ClientState = require(script.Parent.ClientState)
local Lang = require(script.Parent.Lang)
local UIKit = require(script.Parent.UIKit)

local InteractionController = {}

local shownPrompts: { ProximityPrompt } = {}
local holding: ProximityPrompt? = nil
local interactButton: TextButton? = nil
local flashlightButton: TextButton? = nil

local function currentPrompt(): ProximityPrompt?
	-- The most recently shown prompt is the one the player is facing.
	for i = #shownPrompts, 1, -1 do
		local prompt = shownPrompts[i]
		if prompt.Parent and prompt.Enabled then
			return prompt
		end
	end
	return nil
end

local function refreshButton()
	local button = interactButton
	if not button then
		return
	end
	local prompt = currentPrompt()
	button.Visible = prompt ~= nil
	if prompt then
		button.Text = prompt.ActionText
	end
end

local function toggleFlashlight(remotes: Folder)
	(remotes:FindFirstChild(RemoteNames.ToggleFlashlight) :: RemoteEvent):FireServer()
end

function InteractionController.Start(remotes: Folder)
	ProximityPromptService.PromptShown:Connect(function(prompt)
		table.insert(shownPrompts, prompt)
		refreshButton()
	end)
	ProximityPromptService.PromptHidden:Connect(function(prompt)
		local index = table.find(shownPrompts, prompt)
		if index then
			table.remove(shownPrompts, index)
		end
		if holding == prompt then
			holding = nil
		end
		refreshButton()
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		-- F on keyboard, Y on a gamepad.
		if not processed and (input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.ButtonY) then
			toggleFlashlight(remotes)
		end
	end)

	if UserInputService.TouchEnabled then
		local screen = UIKit.Screen()
		local button = UIKit.Button({
			Name = "InteractButton",
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -24, 1, -120),
			Size = UDim2.fromOffset(150, 60),
			Text = "",
			TextSize = 18,
			BackgroundColor3 = Color3.fromRGB(70, 110, 160),
			Visible = false,
			Parent = screen,
		})
		button.InputBegan:Connect(function(input)
			if
				input.UserInputType == Enum.UserInputType.Touch
				or input.UserInputType == Enum.UserInputType.MouseButton1
			then
				local prompt = currentPrompt()
				if prompt then
					holding = prompt
					prompt:InputHoldBegin()
				end
			end
		end)
		button.InputEnded:Connect(function(input)
			if
				input.UserInputType == Enum.UserInputType.Touch
				or input.UserInputType == Enum.UserInputType.MouseButton1
			then
				local prompt = holding
				holding = nil
				if prompt and prompt.Parent then
					prompt:InputHoldEnd()
				end
			end
		end)
		Lang.Bind(button, "ui.interact")
		interactButton = button

		local flash = UIKit.Button({
			Name = "FlashlightButton",
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -24, 1, -190),
			Size = UDim2.fromOffset(110, 48),
			Text = "",
			Visible = false,
			Parent = screen,
		})
		flash.Activated:Connect(function()
			toggleFlashlight(remotes)
		end)
		Lang.Bind(flash, "ui.flashlight")
		flashlightButton = flash
		ClientState.Changed:Connect(function(s)
			if flashlightButton then
				flashlightButton.Visible = s.inventory ~= nil and (s.inventory.Flashlight or 0) &gt; 0
			end
		end)
	end

	-- Prompt texts change when the state changes (e.g. an upgrade gets built).
	ClientState.Changed:Connect(refreshButton)
end

return InteractionController
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="111">
          <Properties>
            <string name="Name">IntroController</string>
            <string name="Source">--!strict
-- Story screen shown once per match, right after the lift brings the player up to the roof:
-- what happened, what to do, how to win. Closed with the START button (or A / Enter).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Theme = require(ReplicatedStorage.Shared.Theme)
local Lang = require(script.Parent.Lang)
local UIKit = require(script.Parent.UIKit)

local IntroController = {}

local C = UIKit.Colors
local GOALS = {
	{ icon = "🔩", key = "intro.goal1" },
	{ icon = "📦", key = "intro.goal2" },
	{ icon = "⚡", key = "intro.goal3" },
	{ icon = "🌉", key = "intro.goal4" },
	{ icon = "🩹", key = "intro.goal5" },
}

local overlay: Frame
-- Phones in landscape are short: tighter type so the whole card fits without scrolling.
local COMPACT = UserInputService.TouchEnabled
local function size(normal: number, compact: number): number
	return if COMPACT then compact else normal
end

local function close()
	if not overlay.Visible then
		return
	end
	local info = TweenInfo.new(0.35)
	TweenService:Create(overlay, info, { BackgroundTransparency = 1 }):Play()
	task.delay(0.35, function()
		overlay.Visible = false
	end)
end

local function build(screen: ScreenGui)
	overlay = UIKit.New("Frame", {
		Name = "Intro",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(10, 10, 8),
		BackgroundTransparency = 0.25,
		ZIndex = 20,
		Parent = screen,
	})
	local card = UIKit.Panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(620, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.fromRGB(26, 26, 22),
		BackgroundTransparency = 0.02,
		ZIndex = 21,
		Parent = overlay,
	})
	UIKit.New("UISizeConstraint", { MaxSize = Vector2.new(620, 900), Parent = card })
	UIKit.New("UIStroke", { Color = C.accent, Thickness = 2, Transparency = 0.4, Parent = card })
	UIKit.Padding(size(22, 12)).Parent = card
	UIKit.New("UIListLayout", {
		Padding = UDim.new(0, size(10, 5)),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = card,
	})

	local function label(
		order: number,
		key: string,
		textSize: number,
		font: Font,
		color: Color3,
		center: boolean
	): TextLabel
		local l = UIKit.Label({
			Size = UDim2.fromScale(1, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextSize = textSize,
			FontFace = font,
			TextColor3 = color,
			TextXAlignment = if center then Enum.TextXAlignment.Center else Enum.TextXAlignment.Left,
			LayoutOrder = order,
			ZIndex = 22,
			Parent = card,
		})
		Lang.Bind(l, key)
		return l
	end
	label(1, "intro.kicker", size(16, 13), Theme.Heading, C.muted, true)
	label(2, "intro.title", size(52, 34), Theme.Display, C.accent, true)
	label(3, "intro.body", size(17, 14), Theme.Body, C.text, false)

	local goals = UIKit.New("Frame", {
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 4,
		ZIndex = 22,
		Parent = card,
	})
	UIKit.New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = goals })
	for i, goal in GOALS do
		local row = UIKit.New("Frame", {
			Size = UDim2.new(1, 0, 0, size(30, 22)),
			BackgroundTransparency = 1,
			LayoutOrder = i,
			ZIndex = 22,
			Parent = goals,
		})
		UIKit.Label({
			Size = UDim2.fromOffset(34, 30),
			Text = goal.icon,
			TextSize = 22,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 22,
			Parent = row,
		})
		local text = UIKit.Label({
			Position = UDim2.fromOffset(42, 0),
			Size = UDim2.new(1, -42, 1, 0),
			TextSize = size(16, 13),
			FontFace = Theme.Bold,
			ZIndex = 22,
			Parent = row,
		})
		Lang.Bind(text, goal.key)
	end

	local start = UIKit.Button({
		Size = UDim2.fromOffset(240, size(56, 42)),
		FontFace = Theme.Display,
		TextSize = size(26, 20),
		BackgroundColor3 = Color3.fromRGB(196, 140, 40),
		TextColor3 = Color3.fromRGB(20, 18, 14),
		LayoutOrder = 5,
		ZIndex = 22,
		Parent = card,
	})
	Lang.Bind(start, "intro.start")
	start.Activated:Connect(close)
end

function IntroController.Start()
	build(UIKit.Screen())
	-- One showing per match: the ScreenGui survives respawns, so it is not shown again after being closed.
	overlay.Visible = true
	UserInputService.InputBegan:Connect(function(input)
		local key = input.KeyCode
		if overlay.Visible and (key == Enum.KeyCode.ButtonA or key == Enum.KeyCode.Return) then
			close()
		end
	end)
end

return IntroController
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="112">
          <Properties>
            <string name="Name">InventoryController</string>
            <string name="Source">--!strict
-- Always-visible inventory hotbar along the bottom of the screen and the storage panel opened from the roof crate.
-- Clicking a slot (or pressing its number key) uses Medkit / Food; other items just show their name.
-- Buttons only send requests; the server decides and the next snapshot redraws the lists.

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Theme = require(ReplicatedStorage.Shared.Theme)
local ItemDefinitions = require(ReplicatedStorage.Shared.ItemDefinitions)
local RemoteNames = require(ReplicatedStorage.Shared.RemoteNames)
local ClientState = require(script.Parent.ClientState)
local ItemSlot = require(script.Parent.ItemSlot)
local Lang = require(script.Parent.Lang)
local UIKit = require(script.Parent.UIKit)

local InventoryController = {}

local player = Players.LocalPlayer
local C = UIKit.Colors
local remotes: Folder

local SLOT_COUNT = 10
local SLOT_SIZE = if UserInputService.TouchEnabled then 54 else 60
local SLOT_GAP = if UserInputService.TouchEnabled then 4 else 6
local NUMBER_KEYS = {
	Enum.KeyCode.One,
	Enum.KeyCode.Two,
	Enum.KeyCode.Three,
	Enum.KeyCode.Four,
	Enum.KeyCode.Five,
	Enum.KeyCode.Six,
	Enum.KeyCode.Seven,
	Enum.KeyCode.Eight,
	Enum.KeyCode.Nine,
	Enum.KeyCode.Zero,
}

local weightLabel: TextLabel
local weightFill: Frame
local slots: { ItemSlot.Slot } = {}
local slotItems: { [number]: string } = {}
local tooltip: TextLabel
local tooltipToken = 0
local storagePanel: Frame
local storageList: Frame
local storageHeader: TextLabel

local USE_LABELS: { [string]: string } = {
	Medkit = "ui.use",
	Food = "ui.eat",
}

local lastSlotItem: string? = nil
local dropHintShown = false
local teamChestHintShown = false
local LONG_PRESS = 0.55

local function clearRows(list: Frame)
	for _, child in list:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
end

local function makeWindow(
	name: string,
	title: string,
	size: UDim2,
	position: UDim2,
	anchor: Vector2
): (Frame, Frame, TextLabel)
	local screen = UIKit.Screen()
	local panel = UIKit.Panel({
		Name = name,
		AnchorPoint = anchor,
		Position = position,
		Size = size,
		Visible = false,
		BackgroundTransparency = 0.05,
		Parent = screen,
	})
	UIKit.New("UISizeConstraint", { MaxSize = Vector2.new(size.X.Offset, 640), Parent = panel })
	UIKit.Padding(12).Parent = panel
	local header = UIKit.Label({
		Size = UDim2.new(1, -40, 0, 26),
		Text = "",
		FontFace = Theme.Bold,
		TextSize = 18,
		Parent = panel,
	})
	Lang.Bind(header, title)
	local close = UIKit.Button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(32, 32),
		Text = "✕",
		Parent = panel,
	})
	close.Activated:Connect(function()
		panel.Visible = false
	end)
	local list = UIKit.New("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(1, 0, 1, -40),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = panel,
	})
	UIKit.New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	return panel, list, header
end

local function renderInventory(s: { [string]: any })
	local weight = s.weight or 0
	local maxWeight = math.max(s.maxWeight or 1, 1)
	weightLabel.Text = Lang.T("hud.weight", weight, maxWeight)
	weightFill.Size = UDim2.fromScale(math.clamp(weight / maxWeight, 0, 1), 1)
	weightFill.BackgroundColor3 = if weight &gt;= maxWeight then C.warn else C.good

	-- Owned items fill the slots in a fixed order; the rest stay empty.
	table.clear(slotItems)
	local index = 0
	for _, itemId in ItemDefinitions.Order do
		local count = s.inventory and s.inventory[itemId] or 0
		if count &gt; 0 and index &lt; SLOT_COUNT then
			index += 1
			slotItems[index] = itemId
		end
	end
	for i, slot in slots do
		local itemId = slotItems[i]
		local count = if itemId and s.inventory then s.inventory[itemId] or 0 else 0
		slot.set(itemId, count, itemId ~= nil and itemId == player:GetAttribute("Equipped"))
	end
end

local function showTooltip(text: string)
	tooltipToken += 1
	local token = tooltipToken
	tooltip.Text = text
	tooltip.Visible = true
	task.delay(2.5, function()
		if tooltipToken == token then
			tooltip.Visible = false
		end
	end)
end

-- Gamepad shortcut: D-pad up uses a medkit, D-pad down eats food.
local function useItem(itemId: string)
	(remotes:FindFirstChild(RemoteNames.UseItem) :: RemoteEvent):FireServer(itemId)
end

local function dropItem(itemId: string)
	local def = ItemDefinitions.Get(itemId)
	if not def or not def.storable then
		showTooltip(Lang.T("drop.cantDrop"))
		return
	end
	(remotes:FindFirstChild(RemoteNames.DropItem) :: RemoteEvent):FireServer(itemId, 1)
	if not dropHintShown then
		dropHintShown = true
		showTooltip(Lang.T("toast.dropHint"))
	end
end

local function activateSlot(i: number)
	local itemId = slotItems[i]
	local def = if itemId then ItemDefinitions.Get(itemId) else nil
	if not def then
		return
	end
	lastSlotItem = def.id
	local s = ClientState.Get()
	local count = s and s.inventory and s.inventory[def.id] or 0
	local useLabel = USE_LABELS[def.id]
	if def.weapon then
		-- Weapons: tap to take it in hand, tap again to put it away.
		(remotes:FindFirstChild(RemoteNames.Equip) :: RemoteEvent):FireServer(def.id)
		showTooltip(("%s %s"):format(def.icon, Lang.T("item." .. def.id .. ".name")))
	elseif useLabel then
		(remotes:FindFirstChild(RemoteNames.UseItem) :: RemoteEvent):FireServer(def.id)
		showTooltip(("%s %s · %s"):format(def.icon, Lang.T("item." .. def.id .. ".name"), Lang.T(useLabel)))
	else
		showTooltip(
			("%s %s ×%d · %s · [G] %s"):format(
				def.icon,
				Lang.T("item." .. def.id .. ".name"),
				count,
				Lang.T("item." .. def.id .. ".desc"),
				Lang.T("prompt.drop")
			)
		)
	end
end

local function buildHotbar(screen: ScreenGui)
	local width = SLOT_COUNT * SLOT_SIZE + (SLOT_COUNT - 1) * SLOT_GAP
	local holder = UIKit.New("Frame", {
		Name = "Hotbar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.fromOffset(width, SLOT_SIZE + 26),
		BackgroundTransparency = 1,
		Parent = screen,
	})

	weightLabel = UIKit.Label({
		Size = UDim2.fromOffset(120, 16),
		Text = "",
		TextSize = 13,
		TextColor3 = C.muted,
		TextStrokeTransparency = 0.5,
		Parent = holder,
	})
	local bar = UIKit.New("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 5),
		Size = UDim2.new(1, -130, 0, 6),
		BackgroundColor3 = C.panelLight,
		BorderSizePixel = 0,
		Parent = holder,
	}, { UIKit.Corner(3) })
	weightFill = UIKit.New("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = C.good,
		BorderSizePixel = 0,
		Parent = bar,
	}, { UIKit.Corner(3) })

	local row = UIKit.New("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, SLOT_SIZE),
		BackgroundTransparency = 1,
		Parent = holder,
	})
	UIKit.New("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, SLOT_GAP),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = row,
	})
	for i = 1, SLOT_COUNT do
		local slot = ItemSlot.New(row, SLOT_SIZE, i)
		slots[i] = slot
		if not UserInputService.TouchEnabled then
			UIKit.Label({
				Position = UDim2.fromOffset(5, 2),
				Size = UDim2.fromOffset(14, 14),
				Text = tostring(i % 10),
				TextSize = 11,
				TextColor3 = C.muted,
				Parent = slot.frame,
			})
		end
		slot.frame.Activated:Connect(function()
			activateSlot(i)
		end)
		-- Long-press a storable stack to drop one for teammates (mobile-friendly).
		local pressToken = 0
		slot.frame.InputBegan:Connect(function(input)
			if
				input.UserInputType ~= Enum.UserInputType.Touch
				and input.UserInputType ~= Enum.UserInputType.MouseButton1
			then
				return
			end
			pressToken += 1
			local token = pressToken
			task.delay(LONG_PRESS, function()
				if token ~= pressToken then
					return
				end
				local itemId = slotItems[i]
				if itemId then
					dropItem(itemId)
				end
			end)
		end)
		slot.frame.InputEnded:Connect(function(input)
			if
				input.UserInputType == Enum.UserInputType.Touch
				or input.UserInputType == Enum.UserInputType.MouseButton1
			then
				pressToken += 1
			end
		end)
	end

	tooltip = UIKit.Label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, -6),
		Size = UDim2.new(1.4, 0, 0, 22),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = Theme.Bold,
		TextSize = 15,
		TextStrokeTransparency = 0.3,
		Visible = false,
		Parent = holder,
	})
end

local function transfer(direction: string, itemId: string, amount: number)
	(remotes:FindFirstChild(RemoteNames.StorageTransfer) :: RemoteEvent):FireServer(direction, itemId, amount)
end

local CHEST_SLOT = 76

-- One labelled grid of item slots. Tapping a slot moves the whole stack to the other side.
local function storageSection(
	order: number,
	titleKey: string,
	emptyKey: string,
	counts: { [string]: number },
	onTap: (itemId: string, count: number) -&gt; ()
)
	local section = UIKit.New("Frame", {
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = storageList,
	})
	UIKit.New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = section })
	UIKit.Label({
		Size = UDim2.new(1, 0, 0, 26),
		Text = Lang.T(titleKey),
		FontFace = Theme.Heading,
		TextSize = 22,
		LayoutOrder = 1,
		Parent = section,
	})
	local grid = UIKit.New("Frame", {
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = section,
	})
	UIKit.New("UIGridLayout", {
		CellSize = UDim2.fromOffset(CHEST_SLOT, CHEST_SLOT),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	local any = false
	for i, itemId in ItemDefinitions.Order do
		local def = ItemDefinitions.Items[itemId]
		local count = counts[itemId] or 0
		if def.storable and count &gt; 0 then
			any = true
			local slot = ItemSlot.New(grid, CHEST_SLOT, i)
			slot.set(itemId, count, false)
			slot.frame.Activated:Connect(function()
				onTap(itemId, count)
			end)
		end
	end
	if not any then
		UIKit.Label({
			Size = UDim2.new(1, 0, 0, 30),
			Text = Lang.T(emptyKey),
			TextColor3 = C.muted,
			LayoutOrder = 3,
			Parent = section,
		})
	end
end

local function renderStorage(s: { [string]: any })
	storageHeader.Text = Lang.T(
		"ui.teamStorageHeader",
		s.storageWeight or 0,
		s.storageCapacity or 0,
		s.weight or 0,
		s.maxWeight or 0
	)
	clearRows(storageList)
	UIKit.New(
		"Frame",
		{ Size = UDim2.new(1, -8, 0, 36), BackgroundTransparency = 1, LayoutOrder = 0, Parent = storageList },
		{
			UIKit.Label({
				Size = UDim2.fromScale(1, 1),
				Text = Lang.T("ui.teamChestHint"),
				TextColor3 = C.muted,
				TextSize = 15,
			}),
		}
	)
	storageSection(1, "ui.backpack", "ui.emptyBackpack", s.inventory or {}, function(itemId, count)
		transfer("Deposit", itemId, count)
	end)
	storageSection(2, "ui.teamStorage", "ui.emptyChest", s.storage or {}, function(itemId, count)
		transfer("Withdraw", itemId, count)
	end)
end

function InventoryController.OpenStorage()
	storagePanel.Visible = true
	local s = ClientState.Get()
	if s then
		renderStorage(s)
	end
	if not teamChestHintShown then
		teamChestHintShown = true
		showTooltip(Lang.T("ui.teamChestHint"))
	end
	-- Gamepads navigate menus through the selected object, so focus the first button.
	if UserInputService.GamepadEnabled then
		local first = storageList:FindFirstChildWhichIsA("TextButton", true)
		if first then
			GuiService.SelectedObject = first
		end
	end
end

function InventoryController.Start(remoteFolder: Folder)
	remotes = remoteFolder
	local screen = UIKit.Screen()

	buildHotbar(screen)
	storagePanel, storageList, storageHeader = makeWindow(
		"Storage",
		"ui.teamStorage",
		UDim2.new(0, 560, 0.8, 0),
		UDim2.fromScale(0.5, 0.5),
		Vector2.new(0.5, 0.5)
	)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local slotIndex = table.find(NUMBER_KEYS, input.KeyCode)
		if slotIndex then
			activateSlot(slotIndex)
		elseif input.KeyCode == Enum.KeyCode.G then
			if lastSlotItem then
				dropItem(lastSlotItem)
			end
		elseif input.KeyCode == Enum.KeyCode.DPadUp then
			useItem("Medkit")
		elseif input.KeyCode == Enum.KeyCode.DPadDown then
			useItem("Food")
		elseif input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			if storagePanel.Visible then
				storagePanel.Visible = false
				GuiService.SelectedObject = nil
			end
		end
	end)

	-- Highlight the slot of the weapon in hand.
	player:GetAttributeChangedSignal("Equipped"):Connect(function()
		local s = ClientState.Get()
		if s then
			renderInventory(s)
		end
	end)
	ClientState.Changed:Connect(function(s)
		renderInventory(s)
		if storagePanel.Visible then
			renderStorage(s)
		end
	end)

	-- Close the storage window once the player walks away from the crate.
	task.spawn(function()
		while true do
			task.wait(0.5)
			if storagePanel.Visible then
				local world = workspace:FindFirstChild("GeneratedWorld")
				local interactables = world and world:FindFirstChild("Interactables")
				local crate = interactables and interactables:FindFirstChild("StorageCrate")
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if
					not crate
					or not root
					or ((crate :: BasePart).Position - (root :: BasePart).Position).Magnitude &gt; 20
				then
					storagePanel.Visible = false
				end
			end
		end
	end)
end

return InventoryController
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="113">
          <Properties>
            <string name="Name">ItemSlot</string>
            <string name="Source">--!strict
-- Square inventory slot: item icon in the middle, count in the corner.
-- Uses def.iconImage when an uploaded icon exists, otherwise the emoji placeholder.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Theme = require(ReplicatedStorage.Shared.Theme)
local ItemDefinitions = require(ReplicatedStorage.Shared.ItemDefinitions)
local UIKit = require(script.Parent.UIKit)

local ItemSlot = {}

local C = UIKit.Colors
local EMPTY_COLOR = Color3.fromRGB(32, 34, 39)
local FILLED_COLOR = Color3.fromRGB(46, 49, 56)

export type Slot = {
	frame: TextButton,
	set: (itemId: string?, count: number, selected: boolean) -&gt; (),
}

function ItemSlot.New(parent: Instance, size: number, layoutOrder: number): Slot
	local frame = UIKit.New("TextButton", {
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = EMPTY_COLOR,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = layoutOrder,
		Parent = parent,
	}, { UIKit.Corner(8) })
	local stroke = UIKit.New("UIStroke", {
		Thickness = 2,
		Color = Color3.fromRGB(60, 63, 70),
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = frame,
	})
	local emoji = UIKit.Label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.46),
		Size = UDim2.fromScale(0.6, 0.6),
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = Theme.Bold,
		Text = "",
		Parent = frame,
	})
	local image = UIKit.New("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.46),
		Size = UDim2.fromScale(0.6, 0.6),
		BackgroundTransparency = 1,
		Visible = false,
		ScaleType = Enum.ScaleType.Fit,
		Parent = frame,
	})
	local countLabel = UIKit.Label({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -5, 1, -3),
		Size = UDim2.fromOffset(40, 20),
		TextXAlignment = Enum.TextXAlignment.Right,
		FontFace = Theme.Display,
		TextSize = 16,
		TextStrokeTransparency = 0.4,
		Text = "",
		Parent = frame,
	})

	local function set(itemId: string?, count: number, selected: boolean)
		local def = if itemId then ItemDefinitions.Get(itemId) else nil
		if not def or count &lt;= 0 then
			frame.BackgroundColor3 = EMPTY_COLOR
			stroke.Color = Color3.fromRGB(60, 63, 70)
			emoji.Text = ""
			image.Visible = false
			countLabel.Text = ""
			return
		end
		frame.BackgroundColor3 = FILLED_COLOR
		stroke.Color = if selected then C.accent else def.color
		stroke.Thickness = if selected then 3 else 2
		if def.iconImage then
			image.Image = def.iconImage
			image.Visible = true
			emoji.Text = ""
		else
			image.Visible = false
			emoji.Text = def.icon
		end
		countLabel.Text = if count &gt; 1 then tostring(count) else ""
	end

	set(nil, 0, false)
	return { frame = frame, set = set }
end

return ItemSlot
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="114">
          <Properties>
            <string name="Name">Lang</string>
            <string name="Source">--!strict
-- Client-side translation helpers. Static labels register with Lang.Bind and refresh on a language change;
-- everything else re-renders from the state snapshot (Lang.Changed re-fires it).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Locale = require(ReplicatedStorage.Shared.Locale)

local Lang = {}

local player = Players.LocalPlayer
local changed = Instance.new("BindableEvent")
Lang.Changed = changed.Event

type Binding = { key: string, args: { any } }
local bindings: { [Instance]: Binding } = {}

function Lang.Get(): Locale.Lang
	return Locale.ForPlayer(player)
end

function Lang.T(key: string, ...: any): string
	return Locale.T(Lang.Get(), key, ...)
end

function Lang.Format(message: any): string
	return Locale.Format(Lang.Get(), message)
end

-- Keeps a TextLabel / TextButton translated: Text = T(key, ...), now and after every language change.
function Lang.Bind(instance: Instance, key: string, ...: any)
	local target: any = instance
	target.Text = Lang.T(key, ...)
	bindings[instance] = { key = key, args = { ... } }
	instance.Destroying:Once(function()
		bindings[instance] = nil
	end)
end

local last = Lang.Get()
-- Changing the language in the Roblox menu updates LocaleId; redraw everything when it does.
player:GetPropertyChangedSignal("LocaleId"):Connect(function()
	local now = Lang.Get()
	if now == last then
		return
	end
	last = now
	for instance, binding in bindings do
		local target: any = instance
		target.Text = Lang.T(binding.key, table.unpack(binding.args))
	end
	changed:Fire(now)
end)

return Lang
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="115">
          <Properties>
            <string name="Name">MusicController</string>
            <string name="Source">--!strict
-- Local background music: a calm playlist on the roof, tense drones below. Crossfades when the zone changes.
-- A small button in the top-right corner mutes it.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local MusicConfig = require(ReplicatedStorage.Shared:WaitForChild("MusicConfig"))
local UIKit = require(script.Parent.UIKit)

local MusicController = {}

local player = Players.LocalPlayer
local muted = false
local currentSet: string? = nil
local current: Sound? = nil
local indices: { [string]: number } = {}

local function playlistFor(zone: any): string
	if zone == "Roof" or zone == "NeighborRoof" or zone == nil then
		return "Roof"
	end
	return "Below"
end

local function fadeOut(sound: Sound)
	local tween = TweenService:Create(sound, TweenInfo.new(MusicConfig.FadeSeconds), { Volume = 0 })
	tween.Completed:Once(function()
		sound:Destroy()
	end)
	tween:Play()
end

-- Music has its own SoundGroup so it can be balanced against effects in one place.
local musicGroup = Instance.new("SoundGroup")
musicGroup.Name = "Music"
musicGroup.Volume = 1
musicGroup.Parent = SoundService

local playNext: (setName: string) -&gt; ()

playNext = function(setName: string)
	local list = (MusicConfig :: any)[setName] :: { number }
	if not list or #list == 0 then
		return
	end
	local index = (indices[setName] or math.random(1, #list) - 1) % #list + 1
	indices[setName] = index

	if current then
		fadeOut(current)
	end
	local sound = Instance.new("Sound")
	sound.Name = "Music"
	sound.SoundId = "rbxassetid://" .. tostring(list[index])
	sound.Volume = 0
	sound.Looped = false
	sound.SoundGroup = musicGroup
	sound.Parent = SoundService
	current = sound
	sound.Ended:Once(function()
		if current == sound and currentSet == setName then
			playNext(setName)
		end
	end)
	sound:Play()
	TweenService:Create(sound, TweenInfo.new(MusicConfig.FadeSeconds), {
		Volume = if muted then 0 else MusicConfig.Volume,
	}):Play()
end

local function applyZone()
	local setName = playlistFor(player:GetAttribute("Zone"))
	if setName ~= currentSet then
		currentSet = setName
		playNext(setName)
	end
end

-- Walking around the top of the stairs flips the zone back and forth, so wait until it settles.
local function onZoneChanged()
	task.delay(3, applyZone)
end

function MusicController.Start()
	local button = UIKit.Button({
		Name = "MusicToggle",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 8),
		Size = UDim2.fromOffset(44, 44),
		Text = "♪",
		TextSize = 22,
		Parent = UIKit.Screen(),
	})
	button.Activated:Connect(function()
		muted = not muted
		button.Text = if muted then "✕♪" else "♪"
		if current then
			current.Volume = if muted then 0 else MusicConfig.Volume
		end
	end)

	player:GetAttributeChangedSignal("Zone"):Connect(onZoneChanged)
	applyZone()
end

return MusicController
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="116">
          <Properties>
            <string name="Name">ObjectiveMarkerController</string>
            <string name="Source">--!strict
-- A floating "here" arrow over the place the current tutorial step needs: the terminal, the stairs,
-- nearest scrap/electronics, the chest spot, the generator, the bridge. Visible through walls.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Theme = require(ReplicatedStorage.Shared.Theme)
local ClientState = require(script.Parent.ClientState)
local Lang = require(script.Parent.Lang)

local ObjectiveMarkerController = {}

local player = Players.LocalPlayer
local billboard: BillboardGui
local distanceLabel: TextLabel
local target: BasePart? = nil

local function find(path: { string }): BasePart?
	local node: Instance? = workspace:FindFirstChild(GameConfig.World.FolderName)
	for _, name in path do
		node = node and node:FindFirstChild(name)
	end
	if node and node:IsA("BasePart") then
		return node
	end
	return nil
end

local STAIRS = { "Stairwell", "Ramp0_Down" }

local function playerRoot(): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function isTaken(part: BasePart, s: { [string]: any }): boolean
	local nodeId = part:GetAttribute("NodeId")
	if type(nodeId) ~= "string" then
		return true
	end
	if part:GetAttribute("Unique") == true then
		return s.uniqueNodesTaken ~= nil and s.uniqueNodesTaken[nodeId] == true
	end
	return s.depletedNodes ~= nil and s.depletedNodes[nodeId] == true
end

local function rubbleOk(part: BasePart, s: { [string]: any }): boolean
	local required = part:GetAttribute("RequiresRubble")
	if type(required) ~= "string" then
		return true
	end
	return s.clearedRubble ~= nil and s.clearedRubble[required] == true
end

-- Nearest available resource node of the given item (not depleted, rubble cleared if gated).
local function nearestResource(itemId: string, s: { [string]: any }): BasePart?
	local world = workspace:FindFirstChild(GameConfig.World.FolderName)
	local folder = world and world:FindFirstChild("Interactables")
	if not folder then
		return nil
	end
	local root = playerRoot()
	local best: BasePart? = nil
	local bestDist = math.huge
	local origin = if root then root.Position else Vector3.zero
	for _, d in folder:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("InteractType") == "Resource" and d:GetAttribute("ItemId") == itemId then
			if not isTaken(d, s) and rubbleOk(d, s) then
				local dist = (d.Position - origin).Magnitude
				if dist &lt; bestDist then
					best = d
					bestDist = dist
				end
			end
		end
	end
	return best
end

-- Which part the marker points at for each tutorial step (see TutorialService).
local function targetFor(s: { [string]: any }): BasePart?
	local tutorial = s.tutorial
	if not tutorial or tutorial.done then
		return nil
	end
	local step = tutorial.step
	if step == 1 then
		return find({ "Interactables", "EmergencyTerminal" })
	elseif step == 2 then
		-- Point at nearest scrap, not the stairs (gap-report G1.2).
		return nearestResource("Scrap", s) or find(STAIRS)
	elseif step == 5 then
		return nearestResource("Electronics", s) or find(STAIRS)
	elseif step == 3 then
		return find({ "RoofBase", "RoofSpawn" })
	elseif step == 4 then
		return find({ "Interactables", "StorageCrate_Pad" })
	elseif step == 6 then
		return find({ "Interactables", "Generator_Pad" })
	elseif step == 7 then
		local have = function(id: string): number
			return (s.inventory and s.inventory[id] or 0) + (s.storage and s.storage[id] or 0)
		end
		if have("Cable") &gt;= 4 and have("Motor") &gt;= 2 then
			return find({ "Interactables", "Bridge_Pad" })
		end
		return find(STAIRS)
	end
	return nil
end

local function refresh()
	local s = ClientState.Get()
	target = if s then targetFor(s) else nil
	billboard.Adornee = target
	billboard.Enabled = target ~= nil
end

function ObjectiveMarkerController.Start()
	billboard = Instance.new("BillboardGui")
	billboard.Name = "ObjectiveMarker"
	billboard.Size = UDim2.fromOffset(120, 70)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 7, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.Enabled = false
	billboard.Parent = player:WaitForChild("PlayerGui")

	local arrow = Instance.new("TextLabel")
	arrow.BackgroundTransparency = 1
	arrow.Size = UDim2.fromScale(1, 0.62)
	arrow.Text = "▼"
	arrow.TextScaled = true
	arrow.FontFace = Theme.Display
	arrow.TextColor3 = Color3.fromRGB(255, 196, 64)
	arrow.TextStrokeTransparency = 0.3
	arrow.Parent = billboard

	distanceLabel = Instance.new("TextLabel")
	distanceLabel.BackgroundTransparency = 1
	distanceLabel.Position = UDim2.fromScale(0, 0.62)
	distanceLabel.Size = UDim2.fromScale(1, 0.38)
	distanceLabel.TextScaled = true
	distanceLabel.FontFace = Theme.Bold
	distanceLabel.TextColor3 = Color3.new(1, 1, 1)
	distanceLabel.TextStrokeTransparency = 0.3
	distanceLabel.Parent = billboard

	ClientState.Changed:Connect(refresh)
	task.spawn(function()
		workspace:WaitForChild(GameConfig.World.FolderName, 60)
		refresh()
	end)

	-- Gentle bob and the live distance; re-pick nearest loot periodically.
	local clock = 0
	local retargetAt = 0
	RunService.RenderStepped:Connect(function(dt)
		clock += dt
		retargetAt += dt
		if retargetAt &gt; 0.5 then
			retargetAt = 0
			refresh()
		end
		if not target then
			return
		end
		billboard.StudsOffsetWorldSpace = Vector3.new(0, 7 + math.sin(clock * 3) * 0.6, 0)
		local root = playerRoot()
		if root then
			local distance = math.floor((root.Position - target.Position).Magnitude)
			distanceLabel.Text = Lang.T("marker.here", distance)
		end
	end)
end

return ObjectiveMarkerController
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="117">
          <Properties>
            <string name="Name">TutorialController</string>
            <string name="Source">--!strict
-- Terminal note and the ending screen. The note sits at the top and never blocks movement.

local Theme = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Theme"))
local UserInputService = game:GetService("UserInputService")

local Lang = require(script.Parent.Lang)
local UIKit = require(script.Parent.UIKit)

local TutorialController = {}

local C = UIKit.Colors

local notePanel: Frame
local noteTitle: TextLabel
local noteBody: TextLabel
local noteFooter: TextLabel
local endingPanel: Frame
local endingTitle: TextLabel
local endingBody: TextLabel
local endingFooter: TextLabel

local function buildNote(screen: ScreenGui)
	notePanel = UIKit.Panel({
		Name = "Note",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 72),
		Size = UDim2.fromScale(0.6, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 0.05,
		Visible = false,
		Parent = screen,
	})
	UIKit.New("UISizeConstraint", { MaxSize = Vector2.new(560, 400), Parent = notePanel })
	UIKit.Padding(14).Parent = notePanel
	UIKit.New("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = notePanel })
	noteTitle = UIKit.Label({
		Size = UDim2.new(1, -40, 0, 24),
		FontFace = Theme.Bold,
		TextSize = 18,
		TextColor3 = C.good,
		LayoutOrder = 1,
		Parent = notePanel,
	})
	noteBody = UIKit.Label({
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextSize = 16,
		LayoutOrder = 2,
		Parent = notePanel,
	})
	noteFooter = UIKit.Label({
		Size = UDim2.new(1, 0, 0, 20),
		TextSize = 14,
		TextColor3 = C.accent,
		LayoutOrder = 3,
		Parent = notePanel,
	})
	local close = UIKit.Button({
		Size = UDim2.fromOffset(120, 34),
		Text = "",
		LayoutOrder = 4,
		Parent = notePanel,
	})
	Lang.Bind(close, "ui.close")
	close.Activated:Connect(function()
		notePanel.Visible = false
	end)
end

local function buildEnding(screen: ScreenGui)
	endingPanel = UIKit.New("Frame", {
		Name = "Ending",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.25,
		Visible = false,
		ZIndex = 10,
		Parent = screen,
	})
	local box = UIKit.New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.8, 0, 0, 260),
		BackgroundTransparency = 1,
		ZIndex = 11,
		Parent = endingPanel,
	})
	UIKit.New("UISizeConstraint", { MaxSize = Vector2.new(640, 300), Parent = box })
	UIKit.New("UIListLayout", {
		Padding = UDim.new(0, 12),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = box,
	})
	endingTitle = UIKit.Label({
		Size = UDim2.new(1, 0, 0, 50),
		FontFace = Theme.Display,
		TextSize = 36,
		TextColor3 = C.accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 1,
		ZIndex = 11,
		Parent = box,
	})
	endingBody = UIKit.Label({
		Size = UDim2.new(1, 0, 0, 70),
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 2,
		ZIndex = 11,
		Parent = box,
	})
	endingFooter = UIKit.Label({
		Size = UDim2.new(1, 0, 0, 24),
		TextSize = 14,
		TextColor3 = C.muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 3,
		ZIndex = 11,
		Parent = box,
	})
	local continueButton = UIKit.Button({
		Size = UDim2.fromOffset(180, 44),
		Text = "",
		LayoutOrder = 4,
		ZIndex = 11,
		Parent = box,
	})
	Lang.Bind(continueButton, "ui.continue")
	continueButton.Activated:Connect(function()
		endingPanel.Visible = false
	end)
end

function TutorialController.ShowNote(payload: any)
	if type(payload) ~= "table" then
		return
	end
	-- Note texts arrive as Locale messages and are rendered in the reader's language.
	local title = Lang.Format(payload.title)
	local body = Lang.Format(payload.body)
	local footer = Lang.Format(payload.footer)
	if payload.kind == "ending" then
		endingTitle.Text = title
		endingBody.Text = body
		endingFooter.Text = footer
		endingPanel.Visible = true
	else
		noteTitle.Text = title
		noteBody.Text = body
		noteFooter.Text = footer
		notePanel.Visible = true
	end
end

function TutorialController.Start()
	local screen = UIKit.Screen()
	buildNote(screen)
	buildEnding(screen)
	-- B on a gamepad (or Escape) closes the note and the ending screen.
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.ButtonB or input.KeyCode == Enum.KeyCode.Escape then
			notePanel.Visible = false
			endingPanel.Visible = false
		end
	end)
end

return TutorialController
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="118">
          <Properties>
            <string name="Name">UIKit</string>
            <string name="Source">--!strict
-- Tiny helpers for building UI in code with a consistent look.

local Theme = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Theme"))
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local UIKit = {}

UIKit.Colors = {
	panel = Color3.fromRGB(22, 24, 28),
	panelLight = Color3.fromRGB(38, 41, 47),
	text = Color3.fromRGB(235, 235, 235),
	muted = Color3.fromRGB(165, 168, 175),
	accent = Color3.fromRGB(255, 196, 64),
	good = Color3.fromRGB(110, 210, 120),
	warn = Color3.fromRGB(255, 170, 60),
	bad = Color3.fromRGB(235, 80, 70),
	health = Color3.fromRGB(200, 60, 60),
	toxic = Color3.fromRGB(140, 230, 80),
}

function UIKit.New(className: string, props: { [string]: any }, children: { Instance }?): any
	local instance = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			(instance :: any)[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function UIKit.Corner(radius: number?): UICorner
	return UIKit.New("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

function UIKit.Padding(px: number): UIPadding
	return UIKit.New("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
	})
end

function UIKit.Panel(props: { [string]: any }): Frame
	local merged = {
		BackgroundColor3 = UIKit.Colors.panel,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
	}
	for k, v in props do
		merged[k] = v
	end
	return UIKit.New("Frame", merged, { UIKit.Corner(10) })
end

function UIKit.Label(props: { [string]: any }): TextLabel
	local merged = {
		BackgroundTransparency = 1,
		FontFace = Theme.Body,
		TextColor3 = UIKit.Colors.text,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	}
	for k, v in props do
		merged[k] = v
	end
	return UIKit.New("TextLabel", merged)
end

-- A soft click for every button, played locally.
local clickSound: Sound? = nil
local function playClick()
	if not clickSound then
		local ok, config = pcall(function()
			return require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("SoundConfig"))
		end)
		if not ok then
			return
		end
		local sound = Instance.new("Sound")
		sound.SoundId = "rbxassetid://" .. tostring(config.Sounds.Click[1])
		sound.Volume = 0.35
		sound.Parent = game:GetService("SoundService")
		clickSound = sound
	end
	if clickSound then
		clickSound:Play()
	end
end

function UIKit.Button(props: { [string]: any }): TextButton
	local merged = {
		BackgroundColor3 = UIKit.Colors.panelLight,
		BorderSizePixel = 0,
		FontFace = Theme.Bold,
		TextColor3 = UIKit.Colors.text,
		TextSize = 18,
		AutoButtonColor = true,
	}
	for k, v in props do
		merged[k] = v
	end
	local button = UIKit.New("TextButton", merged, { UIKit.Corner(8) })
	button.Activated:Connect(playClick)
	return button
end

-- Single ScreenGui shared by all controllers.
local screen: ScreenGui? = nil
function UIKit.Screen(): ScreenGui
	if screen then
		return screen
	end
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gui = UIKit.New("ScreenGui", {
		Name = "SkylineUI",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})
	-- Scale the whole UI down on small screens (phones) and keep it 1:1 on PC, tablets and TVs.
	local scale = UIKit.New("UIScale", { Parent = gui })
	local function updateScale()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local viewport = camera.ViewportSize
		if UserInputService.TouchEnabled then
			-- Phones and tablets: keep buttons finger-sized without letting panels cover the screen.
			scale.Scale = math.clamp(math.min(viewport.X / 900, viewport.Y / 480), 0.65, 1)
		else
			scale.Scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.8, 1.2)
		end
	end
	updateScale()
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(updateScale)
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
	screen = gui
	return gui
end

return UIKit
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="119">
          <Properties>
            <string name="Name">WorldVisualsController</string>
            <string name="Source">--!strict
-- Applies this player's personal world state locally: empty nodes, cleared rubble, built upgrades,
-- the Floor 4 door, base lights and prompt texts. The server still validates every action.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Locale = require(ReplicatedStorage.Shared.Locale)
local UpgradeDefinitions = require(ReplicatedStorage.Shared.UpgradeDefinitions)
local ClientState = require(script.Parent.ClientState)
local Lang = require(script.Parent.Lang)

local WorldVisualsController = {}

local player = Players.LocalPlayer
local GHOST_TRANSPARENCY = 0.55
local GHOST_COLOR = Color3.fromRGB(90, 200, 255)
local LOCKED_COLOR = Color3.fromRGB(130, 130, 130)
local LOCKED_TRANSPARENCY = 0.88

-- Original look of every part we touch, so it can be restored.
local originals: { [BasePart]: { transparency: number, collide: boolean, material: Enum.Material, color: Color3 } } = {}

local function remember(part: BasePart)
	if not originals[part] then
		originals[part] = {
			transparency = part.Transparency,
			collide = part.CanCollide,
			material = part.Material,
			color = part.Color,
		}
	end
end

local function setPartState(part: BasePart, mode: "normal" | "ghost" | "locked" | "hidden")
	remember(part)
	local original = originals[part]
	if mode == "normal" then
		part.Transparency = original.transparency
		part.CanCollide = original.collide
		part.Material = original.material
		part.Color = original.color
	elseif mode == "ghost" then
		-- Not built yet: a see-through blue hologram of what will stand here.
		part.Transparency = math.max(original.transparency, GHOST_TRANSPARENCY)
		part.CanCollide = false
		part.Material = Enum.Material.ForceField
		part.Color = GHOST_COLOR
	elseif mode == "locked" then
		-- Not available yet: a faint grey outline so the base layout is visible but clearly off-limits.
		part.Transparency = math.max(original.transparency, LOCKED_TRANSPARENCY)
		part.CanCollide = false
		part.Material = Enum.Material.ForceField
		part.Color = LOCKED_COLOR
	else
		part.Transparency = 1
		part.CanCollide = false
	end
end

-- Applies to the part and everything under it (rubble chunks, signs, rails).
local function setTreeState(root: BasePart, mode: "normal" | "ghost" | "locked" | "hidden")
	setPartState(root, mode)
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			setPartState(d, mode)
		elseif d:IsA("SurfaceGui") then
			d.Enabled = mode ~= "hidden"
		elseif d:IsA("Light") and mode == "hidden" then
			d.Enabled = false
		end
	end
end

local function setPrompt(part: Instance, enabled: boolean, actionText: string?, objectText: string?)
	local prompt = part:FindFirstChildOfClass("ProximityPrompt")
	if not prompt then
		return
	end
	prompt.Enabled = enabled
	if actionText then
		prompt.ActionText = actionText
	end
	if objectText then
		prompt.ObjectText = objectText
	end
end

local function applyResource(part: BasePart, s: { [string]: any })
	local nodeId = part:GetAttribute("NodeId")
	if type(nodeId) ~= "string" then
		return
	end
	local taken = if part:GetAttribute("Unique") == true
		then s.uniqueNodesTaken and s.uniqueNodesTaken[nodeId]
		else s.depletedNodes and s.depletedNodes[nodeId]
	setTreeState(part, if taken then "hidden" else "normal")
	-- Gate Collect prompts behind uncleared RequiresRubble so players never get a false "завал" toast.
	local requiredRubble = part:GetAttribute("RequiresRubble")
	local rubbleOk = type(requiredRubble) ~= "string"
		or (s.clearedRubble ~= nil and s.clearedRubble[requiredRubble] == true)
	if taken then
		setPrompt(part, false)
	elseif not rubbleOk then
		setPrompt(part, false, Lang.T("prompt.needRubble"), Lang.T("prompt.rubble"))
	else
		setPrompt(part, true)
	end
end

local function applyRubble(part: BasePart, s: { [string]: any })
	local rubbleId = part:GetAttribute("RubbleId")
	local cleared = part:GetAttribute("ClearedShared") == true
		or (type(rubbleId) == "string" and s.clearedRubble and s.clearedRubble[rubbleId])
	setTreeState(part, if cleared then "hidden" else "normal")
	setPrompt(part, not cleared)
end

-- First upgrade this one still waits for, or nil when it can be built.
local function missingRequirement(upgradeId: string, s: { [string]: any }): string?
	local def = UpgradeDefinitions.Get(upgradeId)
	if not def then
		return nil
	end
	for _, required in def.requires do
		if not (s.upgrades and s.upgrades[required]) then
			return required
		end
	end
	return nil
end

local function applyUpgradePad(part: BasePart, s: { [string]: any })
	local upgradeId = part:GetAttribute("UpgradeId")
	local def = if type(upgradeId) == "string" then UpgradeDefinitions.Get(upgradeId) else nil
	if not def then
		return
	end
	local owned = s.upgrades and s.upgrades[def.id]
	local missing = missingRequirement(def.id, s)
	local cost = s.costs and s.costs[def.id]
	local action = if missing then Lang.T("prompt.locked", Locale.Upgrade(missing)) else Lang.T("prompt.build")
	local object = Lang.T("prompt.costLine", Locale.Upgrade(def.id), Locale.Cost(cost or {}))
	setPrompt(part, not owned, action, object)
end

local function applyUpgradeVisual(part: BasePart, s: { [string]: any })
	local upgradeId = part:GetAttribute("UpgradeVisual")
	if type(upgradeId) ~= "string" then
		return
	end
	local owned = s.upgrades and s.upgrades[upgradeId] == true
	local mode = part:GetAttribute("VisualMode")
	if mode == "Hide" then
		setPartState(part, if owned then "hidden" else "normal")
		for _, d in part:GetDescendants() do
			if d:IsA("SurfaceGui") then
				d.Enabled = not owned
			end
		end
		if part:GetAttribute("InteractType") == "Gate" then
			setPrompt(part, not owned)
		end
	elseif owned then
		setPartState(part, "normal")
	else
		setPartState(part, if missingRequirement(upgradeId, s) then "locked" else "ghost")
	end
end

local function applyLight(part: BasePart, s: { [string]: any })
	local upgradeId = part:GetAttribute("UpgradeLight")
	if type(upgradeId) ~= "string" then
		return
	end
	local on = s.upgrades and s.upgrades[upgradeId] == true
	part.Material = if on then Enum.Material.Neon else Enum.Material.Glass
	part.Color = if on then Color3.fromRGB(255, 225, 170) else Color3.fromRGB(90, 90, 80)
	for _, d in part:GetDescendants() do
		if d:IsA("Light") then
			d.Enabled = on
		end
	end
end

local function applyBackpack(part: BasePart)
	local mine = part:GetAttribute("OwnerUserId") == player.UserId
	setTreeState(part, if mine then "normal" else "hidden")
	for _, d in part:GetDescendants() do
		if d:IsA("Light") then
			d.Enabled = mine
		end
	end
	setPrompt(part, mine)
end

local function applyPart(d: BasePart, s: { [string]: any })
	local interactType = d:GetAttribute("InteractType")
	if interactType == "Resource" then
		applyResource(d, s)
	elseif interactType == "Rubble" then
		applyRubble(d, s)
	elseif interactType == "Upgrade" then
		applyUpgradePad(d, s)
	elseif interactType == "LootChest" then
		-- Opened crates stay as a faint outline until the next trip down.
		local nodeId = d:GetAttribute("NodeId")
		local opened = type(nodeId) == "string" and s.depletedNodes ~= nil and s.depletedNodes[nodeId] == true
		setTreeState(d, if opened then "locked" else "normal")
		setPrompt(d, not opened)
	elseif interactType == "Storage" then
		setPrompt(d, s.upgrades ~= nil and s.upgrades.StorageCrate == true)
	elseif interactType == "Backpack" then
		applyBackpack(d)
	end
	if d:GetAttribute("UpgradeVisual") then
		applyUpgradeVisual(d, s)
	end
	if d:GetAttribute("UpgradeLight") then
		applyLight(d, s)
	end
end

-- World text is created by the server with Locale keys in attributes; translate it for this player.
local function keyArg(value: any): any
	if type(value) == "string" and string.sub(value, 1, 1) == "@" then
		return { ref = string.sub(value, 2) }
	end
	return value
end

local function localizeInstance(d: Instance)
	if d:IsA("TextLabel") then
		local key = d:GetAttribute("TextKey")
		if type(key) == "string" then
			local arg = d:GetAttribute("TextArg1")
			d.Text = if arg ~= nil then Lang.T(key, keyArg(arg)) else Lang.T(key)
		end
	elseif d:IsA("ProximityPrompt") then
		local actionKey = d:GetAttribute("ActionKey")
		if type(actionKey) == "string" then
			d.ActionText = Lang.T(actionKey)
		end
		local objectKey = d:GetAttribute("ObjectKey")
		if type(objectKey) == "string" then
			local a1 = d:GetAttribute("ObjectArg1")
			local a2 = d:GetAttribute("ObjectArg2")
			d.ObjectText = if a1 ~= nil then Lang.T(objectKey, keyArg(a1), keyArg(a2)) else Lang.T(objectKey)
		end
	end
end

local function apply(s: { [string]: any }?)
	if not s then
		return
	end
	local world = workspace:FindFirstChild(GameConfig.World.FolderName)
	if not world then
		return
	end
	for _, d in world:GetDescendants() do
		localizeInstance(d)
	end
	for _, d in world:GetDescendants() do
		if d:IsA("BasePart") then
			applyPart(d, s)
		end
	end
end

function WorldVisualsController.Start()
	ClientState.Changed:Connect(apply)
	-- The world streams in after the client starts; re-apply when it arrives and when backpacks drop.
	task.spawn(function()
		local world = workspace:WaitForChild(GameConfig.World.FolderName, 60)
		if not world then
			return
		end
		apply(ClientState.Get())
		-- Covers backpacks dropped later and parts that stream in after the first pass.
		world.DescendantAdded:Connect(function(d)
			localizeInstance(d)
			if d:IsA("BasePart") then
				task.defer(function()
					local s = ClientState.Get()
					if s and d.Parent then
						applyPart(d, s)
					end
				end)
			end
		end)
	end)
end

return WorldVisualsController
</string>
