      <Item class="ModuleScript" referent="68">
        <Properties>
          <string name="Name">Theme</string>
          <string name="Source">--!strict
-- Fonts used across both places. Oswald for headings and big numbers, Montserrat for everything else.
-- Both families include Cyrillic, so Ukrainian and Russian text keeps the same look.

local function family(name: string, weight: Enum.FontWeight): Font
	return Font.new("rbxasset://fonts/families/" .. name .. ".json", weight)
end

local Theme = {
	Display = family("Oswald", Enum.FontWeight.Bold), -- titles, signs, counters
	Heading = family("Oswald", Enum.FontWeight.Medium),
	Bold = family("Montserrat", Enum.FontWeight.Bold), -- buttons, labels that must stand out
	Body = family("Montserrat", Enum.FontWeight.Medium), -- regular text
}

return Theme
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="69">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source">--!strict
-- Shared data shapes for server data and the state snapshot sent to clients.

export type ItemCounts = { [string]: number }

export type PlayerData = {
	schemaVersion: number,
	inventory: ItemCounts,
	storage: ItemCounts,
	upgrades: { [string]: boolean },
	flashlightCharge: number, -- seconds of battery left
	uniqueNodesTaken: { [string]: boolean },
	towerCompleted: boolean,
	tutorialStep: number,
	discoveredNotes: { [string]: boolean },
	language: string?, -- "uk" | "ru" | "en"; nil = follow the Roblox locale
	-- Monetization stubs, unused while MonetizationConfig.Enabled = false.
	ownedPasses: { [string]: boolean },
	processedReceipts: { [string]: boolean },
}

export type TutorialView = {
	step: number,
	total: number,
	text: string,
	done: boolean,
}

export type StateSnapshot = {
	inventory: ItemCounts,
	storage: ItemCounts,
	upgrades: { [string]: boolean },
	costs: { [string]: { [string]: number } },
	weight: number,
	maxWeight: number,
	storageWeight: number,
	storageCapacity: number,
	flashlightCharge: number,
	flashlightMax: number,
	depletedNodes: { [string]: boolean },
	clearedRubble: { [string]: boolean },
	uniqueNodesTaken: { [string]: boolean },
	backpack: Vector3?,
	tutorial: TutorialView?,
	acts: number,
	saveEnabled: boolean,
	towerCompleted: boolean,
}

return {}
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="70">
        <Properties>
          <string name="Name">UpgradeDefinitions</string>
          <string name="Source">--!strict
-- Base upgrades. Prices are read only from here; the client never sends a price.

local GameConfig = require(script.Parent.GameConfig)

export type UpgradeDef = {
	id: string,
	displayName: string,
	description: string,
	cost: { [string]: number },
	requires: { string }, -- upgrades that must be built first
	act: number?, -- story act this upgrade completes (terminal shows acts 0/3)
	order: number,
}

local Upgrades: { [string]: UpgradeDef } = {
	StorageCrate = {
		id = "StorageCrate",
		displayName = "Сховище",
		description = "Ящик на даху на 60 одиниць ваги.",
		cost = { Scrap = 8 },
		requires = {},
		order = 1,
	},
	Generator = {
		id = "Generator",
		displayName = "Генератор",
		description = "Вмикає світло бази, заряджає ліхтарик і відкриває двері на 4 поверх.",
		cost = { Scrap = 6, Electronics = 4 },
		requires = { "StorageCrate" },
		act = 1,
		order = 2,
	},
	AirFilter = {
		id = "AirFilter",
		displayName = "Фільтр повітря",
		description = "Зменшує шкоду від токсичного повітря на 75%.",
		cost = { Scrap = 5, Electronics = 5 },
		requires = { "Generator" },
		act = 2,
		order = 3,
	},
	Bridge = {
		id = "Bridge",
		displayName = "Міст до сусідньої вежі",
		description = "Полагодь міст і вибирайся з вежі.",
		cost = { Scrap = 10, Cable = 4, Motor = 2 },
		requires = { "Generator" },
		act = 3,
		order = 4,
	},
}

local Order = { "StorageCrate", "Generator", "AirFilter", "Bridge" }

local UpgradeDefinitions = {
	Upgrades = Upgrades,
	Order = Order,
}

function UpgradeDefinitions.Get(id: string): UpgradeDef?
	return Upgrades[id]
end

-- Price actually charged. GameConfig.TestPrices makes every listed item cost 1.
function UpgradeDefinitions.GetCost(def: UpgradeDef): { [string]: number }
	if not GameConfig.TestPrices then
		return def.cost
	end
	local cheap = {}
	for itemId in def.cost do
		cheap[itemId] = 1
	end
	return cheap
end

function UpgradeDefinitions.IsValid(id: any): boolean
	return type(id) == "string" and Upgrades[id] ~= nil
end

return UpgradeDefinitions
</string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="71">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="72">
      <Properties>
        <string name="Name">Atmosphere</string>
        <string name="Source">--!strict
-- Shared look of both places (lobby and tower), in the spirit of The Last of Us: a quiet, overgrown city
-- in warm late-afternoon light. Soft golden sun, hazy green-brown distance, readable shadows and interiors.

local Lighting = game:GetService("Lighting")

local Atmosphere = {}

function Atmosphere.Apply()
	Lighting.ClockTime = 16.4
	Lighting.GeographicLatitude = 30
	Lighting.Brightness = 3
	Lighting.ExposureCompensation = 0.25
	-- Ambient decides how dark the interiors are: dim enough for the flashlight to matter, never pitch black.
	Lighting.Ambient = Color3.fromRGB(78, 74, 66)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 144, 128)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 226, 180)
	Lighting.ColorShift_Bottom = Color3.fromRGB(60, 70, 50)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.35
	Lighting.ShadowSoftness = 0.3
	Lighting.GlobalShadows = true

	-- Replace whatever the template place shipped with.
	for _, child in Lighting:GetChildren() do
		if child:IsA("Atmosphere") or child:IsA("Sky") or child:IsA("PostEffect") then
			child:Destroy()
		end
	end

	local sky = Instance.new("Sky")
	sky.SunAngularSize = 12
	sky.MoonAngularSize = 0
	sky.StarCount = 0
	sky.Parent = Lighting

	-- Light haze near the player, thicker towards the horizon so the ruins fade into a warm green-grey.
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.3
	atmosphere.Haze = 1.6
	atmosphere.Glare = 0.35
	atmosphere.Color = Color3.fromRGB(206, 190, 160)
	atmosphere.Decay = Color3.fromRGB(104, 112, 86)
	atmosphere.Parent = Lighting

	-- Broken cloud cover lit by the afternoon sun.
	local terrain = workspace.Terrain
	local clouds = terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover = 0.55
	clouds.Density = 0.5
	clouds.Color = Color3.fromRGB(255, 236, 214)
	clouds.Parent = terrain

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.06
	rays.Spread = 0.5
	rays.Parent = Lighting

	local grading = Instance.new("ColorCorrectionEffect")
	grading.TintColor = Color3.fromRGB(255, 246, 232)
	grading.Saturation = 0.04
	grading.Contrast = 0.1
	grading.Brightness = 0.03
	grading.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.35
	bloom.Size = 24
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
end

return Atmosphere
</string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="73">
      <Properties>
        <string name="Name">PropLibrary</string>
        <string name="Source">--!strict
-- Blender props in the game. Model assets uploaded through Open Cloud (scripts/upload_model.sh) are
-- loaded once at server start with InsertService; an imported RoofProps.rbxm in ReplicatedStorage.Models
-- works too. Every mesh is named "&lt;Prop&gt;_&lt;Part&gt;_&lt;Paint&gt;"; the paint picks colour and material.
-- If a prop is missing the world still builds, just without that prop.

local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PropLibrary = {}

-- Uploaded model assets (see scripts/upload_model.sh).
local ASSETS: { [string]: number } = {
	InteriorProps = 76157686296384,
	Weapons = 126001413949023,
}

local PAINTS: { [string]: { color: Color3, material: Enum.Material } } = {
	Wood = { color = Color3.fromRGB(120, 80, 48), material = Enum.Material.WoodPlanks },
	Metal = { color = Color3.fromRGB(120, 124, 130), material = Enum.Material.Metal },
	Dark = { color = Color3.fromRGB(38, 40, 45), material = Enum.Material.Metal },
	Rust = { color = Color3.fromRGB(125, 65, 35), material = Enum.Material.CorrodedMetal },
	Yellow = { color = Color3.fromRGB(215, 160, 40), material = Enum.Material.Metal },
	Glow = { color = Color3.fromRGB(255, 150, 60), material = Enum.Material.Neon },
	Teal = { color = Color3.fromRGB(60, 120, 120), material = Enum.Material.Metal },
	Red = { color = Color3.fromRGB(170, 45, 38), material = Enum.Material.Metal },
	Fabric = { color = Color3.fromRGB(84, 90, 62), material = Enum.Material.Fabric },
	Cloth = { color = Color3.fromRGB(150, 138, 114), material = Enum.Material.Fabric },
	White = { color = Color3.fromRGB(196, 192, 178), material = Enum.Material.SmoothPlastic },
	Cardboard = { color = Color3.fromRGB(150, 112, 70), material = Enum.Material.Cardboard },
	Concrete = { color = Color3.fromRGB(128, 122, 112), material = Enum.Material.Concrete },
	Moss = { color = Color3.fromRGB(80, 104, 46), material = Enum.Material.Grass },
	Glass = { color = Color3.fromRGB(120, 140, 140), material = Enum.Material.Glass },
}

local library: Folder? = nil

-- Loads the uploaded assets into ReplicatedStorage.Models. Call before building the world.
function PropLibrary.Load()
	local models = ReplicatedStorage:FindFirstChild("Models")
	if not models then
		local folder = Instance.new("Folder")
		folder.Name = "Models"
		folder.Parent = ReplicatedStorage
		models = folder
	end
	for name, assetId in ASSETS do
		local ok, result = pcall(function()
			return InsertService:LoadAsset(assetId)
		end)
		if ok and result then
			result.Name = name
			result.Parent = models
		else
			warn(("[PropLibrary] could not load %s (%d): %s"):format(name, assetId, tostring(result)))
		end
	end
	library = models :: Folder
end

-- The meshes of one prop: either everything under a node named after it, or every part named "&lt;Prop&gt;_...".
local function partsOf(propName: string): { BasePart }
	local parts: { BasePart } = {}
	local root = library or ReplicatedStorage:FindFirstChild("Models")
	if not root then
		return parts
	end
	local node = root:FindFirstChild(propName, true)
	if node and not node:IsA("BasePart") then
		for _, d in node:GetDescendants() do
			if d:IsA("BasePart") then
				table.insert(parts, d)
			end
		end
		if #parts &gt; 0 then
			return parts
		end
	end
	local prefix = propName .. "_"
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") and string.sub(d.Name, 1, #prefix) == prefix then
			table.insert(parts, d)
		end
	end
	return parts
end

function PropLibrary.Has(propName: string): boolean
	return #partsOf(propName) &gt; 0
end

-- An unscaled, coloured copy of a prop's meshes (anchored, colliding unless told otherwise).
function PropLibrary.Raw(propName: string, collide: boolean?): Model?
	local sources = partsOf(propName)
	if #sources == 0 then
		return nil
	end
	local model = Instance.new("Model")
	model.Name = propName
	for _, source in sources do
		local part = source:Clone()
		for _, child in part:GetChildren() do
			if not child:IsA("SpecialMesh") and not child:IsA("SurfaceAppearance") then
				child:Destroy()
			end
		end
		part.Anchored = true
		part.CanCollide = collide ~= false
		part.CastShadow = true
		local paintName = string.match(source.Name, "_(%a+)$")
		local paint = paintName and PAINTS[paintName]
		if paint then
			part.Color = paint.color
			part.Material = paint.material
			if paintName == "Glow" then
				part.CanCollide = false
			end
		end
		part.Parent = model
	end
	return model
end

-- Builds a coloured copy of a prop, scaled to fit inside `fit` (studs), standing with its bottom centre
-- at `base` and turned by `yaw` degrees. Returns nil when the prop is not available.
function PropLibrary.Place(
	parent: Instance,
	propName: string,
	base: Vector3,
	fit: Vector3,
	yaw: number?,
	collide: boolean?
): Model?
	local model = PropLibrary.Raw(propName, collide)
	if not model then
		return nil
	end
	local boxCFrame, boxSize = model:GetBoundingBox()
	local scale = math.min(fit.X / boxSize.X, fit.Y / boxSize.Y, fit.Z / boxSize.Z)
	if scale &gt; 0 and scale &lt; math.huge then
		model.WorldPivot = boxCFrame
		model:ScaleTo(scale)
	end
	local _, fitted = model:GetBoundingBox()
	model:PivotTo(CFrame.new(base + Vector3.new(0, fitted.Y / 2, 0)) * CFrame.Angles(0, math.rad(yaw or 0), 0))
	model.Parent = parent
	return model
end

-- Paint lookup for other builders (roof structures use the same names).
function PropLibrary.Paint(paintName: string): { color: Color3, material: Enum.Material }?
	return PAINTS[paintName]
end

return PropLibrary
</string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="74">
      <Properties>
        <string name="Name">Scenery</string>
        <string name="Source">--!strict
-- Post-apocalyptic set dressing shared by the lobby and the tower: ruined high-rises taken over by plants,
-- grass patches, bushes, trees and hanging vines. Plain Parts only, built once at server start.

local Scenery = {}

local PALETTE = {
	concrete = { Color3.fromRGB(150, 142, 128), Color3.fromRGB(128, 122, 112), Color3.fromRGB(112, 104, 96) },
	brick = Color3.fromRGB(122, 78, 58),
	window = Color3.fromRGB(38, 44, 48),
	lit = Color3.fromRGB(255, 196, 120),
	rust = Color3.fromRGB(124, 72, 44),
	moss = Color3.fromRGB(86, 110, 52),
	leaf = { Color3.fromRGB(78, 112, 48), Color3.fromRGB(96, 128, 56), Color3.fromRGB(64, 92, 44) },
	grass = Color3.fromRGB(104, 124, 62),
	bark = Color3.fromRGB(84, 64, 46),
}

local function part(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material
): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function pick&lt;T&gt;(rng: Random, list: { T }): T
	return list[rng:NextInteger(1, #list)]
end

-- Ivy hanging down a wall from `top`, `length` studs long, on a face whose outward normal is `normal`.
function Scenery.Vine(parent: Instance, top: Vector3, length: number, normal: Vector3, rng: Random)
	local width = rng:NextNumber(1.5, 4)
	local strand = part(
		parent,
		"Vine",
		Vector3.new(width, length, 0.3),
		CFrame.lookAt(top - Vector3.new(0, length / 2, 0) + normal * 0.25, top - Vector3.new(0, length / 2, 0) + normal),
		pick(rng, PALETTE.leaf),
		Enum.Material.Grass
	)
	strand.CanCollide = false
	strand.CastShadow = false
	return strand
end

-- Low patch of overgrown grass lying on a surface.
function Scenery.Grass(parent: Instance, center: Vector3, size: Vector2, rng: Random)
	local patch = part(
		parent,
		"Grass",
		Vector3.new(size.X, 0.25, size.Y),
		CFrame.new(center + Vector3.new(0, 0.125, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0),
		PALETTE.grass:Lerp(pick(rng, PALETTE.leaf), rng:NextNumber()),
		Enum.Material.Grass
	)
	patch.CanCollide = false
	patch.CastShadow = false
	return patch
end

function Scenery.Bush(parent: Instance, base: Vector3, size: number, rng: Random)
	for i = 1, 3 do
		local s = size * rng:NextNumber(0.6, 1)
		local ball = part(
			parent,
			"Bush",
			Vector3.new(s, s * 0.8, s),
			CFrame.new(
				base + Vector3.new(rng:NextNumber(-size, size) * 0.4, s * 0.35, rng:NextNumber(-size, size) * 0.4)
			),
			pick(rng, PALETTE.leaf),
			Enum.Material.Grass
		)
		ball.Shape = Enum.PartType.Ball
		ball.CanCollide = i == 1
	end
end

function Scenery.Tree(parent: Instance, base: Vector3, height: number, rng: Random)
	local trunk = part(
		parent,
		"Trunk",
		Vector3.new(height * 0.08, height * 0.6, height * 0.08),
		CFrame.new(base + Vector3.new(0, height * 0.3, 0))
			* CFrame.Angles(rng:NextNumber(-0.08, 0.08), 0, rng:NextNumber(-0.08, 0.08)),
		PALETTE.bark,
		Enum.Material.Wood
	)
	trunk.CastShadow = true
	for _ = 1, 4 do
		local s = height * rng:NextNumber(0.35, 0.5)
		local crown = part(
			parent,
			"Leaves",
			Vector3.new(s, s * 0.85, s),
			CFrame.new(
				base
					+ Vector3.new(
						rng:NextNumber(-1, 1) * s * 0.4,
						height * rng:NextNumber(0.62, 0.85),
						rng:NextNumber(-1, 1) * s * 0.4
					)
			),
			pick(rng, PALETTE.leaf),
			Enum.Material.Grass
		)
		crown.Shape = Enum.PartType.Ball
		crown.CanCollide = false
	end
end

-- A ruined high-rise: window bands, a few lit windows, a broken crown, rooftop junk and plants growing over it.
function Scenery.Building(parent: Instance, base: Vector3, width: number, depth: number, height: number, rng: Random)
	local model = Instance.new("Model")
	model.Name = "Ruin"
	model.Parent = parent
	local body = part(
		model,
		"Body",
		Vector3.new(width, height, depth),
		CFrame.new(base + Vector3.new(0, height / 2, 0)),
		if rng:NextNumber() &lt; 0.25 then PALETTE.brick else pick(rng, PALETTE.concrete),
		Enum.Material.Concrete
	)
	body.CastShadow = false
	Scenery.Dress(model, base, width, depth, height, rng, true)
	return model
end

-- Window bands, lit windows, ivy and (optionally) a broken crown with a green roof around an existing box
-- whose bottom centre is `base`. Used for skyline ruins and for the bodies of the two playable towers.
function Scenery.Dress(
	model: Instance,
	base: Vector3,
	width: number,
	depth: number,
	height: number,
	rng: Random,
	withCrown: boolean
)
	local bodyColor = pick(rng, PALETTE.concrete)
	-- Window bands wrap all four sides in one part each.
	local floorHeight = rng:NextNumber(10, 14)
	local y = 8
	while y &lt; height - 10 do
		local band = part(
			model,
			"Windows",
			Vector3.new(width + 0.4, floorHeight * 0.45, depth + 0.4),
			CFrame.new(base + Vector3.new(0, y, 0)),
			PALETTE.window,
			Enum.Material.Glass
		)
		band.CastShadow = false
		y += floorHeight
	end
	for _ = 1, rng:NextInteger(3, 8) do
		local side = rng:NextInteger(0, 3)
		local h = rng:NextNumber(10, height - 12)
		local offset = rng:NextNumber(-0.4, 0.4)
		local pos, size
		if side &lt; 2 then
			pos = Vector3.new(offset * width, h, (side * 2 - 1) * (depth / 2 + 0.25))
			size = Vector3.new(3, 3, 0.2)
		else
			pos = Vector3.new((side * 2 - 5) * (width / 2 + 0.25), h, offset * depth)
			size = Vector3.new(0.2, 3, 3)
		end
		local lit = part(model, "Lit", size, CFrame.new(base + pos), PALETTE.lit, Enum.Material.Neon)
		lit.CanCollide = false
		lit.CastShadow = false
	end

	-- Ivy down the walls.
	local normals = {
		{ Vector3.new(0, 0, -1), Vector3.new(0, 0, -depth / 2) },
		{ Vector3.new(0, 0, 1), Vector3.new(0, 0, depth / 2) },
		{ Vector3.new(-1, 0, 0), Vector3.new(-width / 2, 0, 0) },
		{ Vector3.new(1, 0, 0), Vector3.new(width / 2, 0, 0) },
	}
	for _ = 1, rng:NextInteger(3, 7) do
		local face = normals[rng:NextInteger(1, 4)]
		local along = Vector3.new(face[1].Z, 0, face[1].X) * rng:NextNumber(-0.4, 0.4) * math.max(width, depth)
		local length = rng:NextNumber(height * 0.15, height * 0.6)
		local startY = rng:NextNumber(length, height)
		Scenery.Vine(model, base + face[2] + along + Vector3.new(0, startY, 0) + face[1] * 0.3, length, face[1], rng)
	end
	if not withCrown then
		return
	end

	-- Broken crown: slabs knocked askew and a leaning rooftop tank.
	local top = base + Vector3.new(0, height, 0)
	for _ = 1, rng:NextInteger(2, 4) do
		local s =
			Vector3.new(width * rng:NextNumber(0.25, 0.5), rng:NextNumber(3, 8), depth * rng:NextNumber(0.25, 0.5))
		part(
			model,
			"Crown",
			s,
			CFrame.new(
				top + Vector3.new(rng:NextNumber(-0.3, 0.3) * width, s.Y / 2 - 1, rng:NextNumber(-0.3, 0.3) * depth)
			) * CFrame.Angles(rng:NextNumber(-0.2, 0.2), rng:NextNumber(0, 1), rng:NextNumber(-0.2, 0.2)),
			bodyColor:Lerp(Color3.new(0, 0, 0), 0.15),
			Enum.Material.Concrete
		).CastShadow =
			false
	end
	if rng:NextNumber() &lt; 0.6 then
		local tank = part(
			model,
			"Tank",
			Vector3.new(8, 7, 7),
			CFrame.new(top + Vector3.new(rng:NextNumber(-0.3, 0.3) * width, 4.5, rng:NextNumber(-0.3, 0.3) * depth))
				* CFrame.Angles(0, 0, math.pi / 2 + rng:NextNumber(-0.15, 0.15)),
			PALETTE.rust,
			Enum.Material.CorrodedMetal
		)
		tank.Shape = Enum.PartType.Cylinder
		tank.CastShadow = false
	end

	-- Nature taking it back: a green roof.
	Scenery.Grass(model, top, Vector2.new(width * 0.8, depth * 0.8), rng)
	if rng:NextNumber() &lt; 0.5 then
		Scenery.Tree(
			model,
			top + Vector3.new(rng:NextNumber(-0.25, 0.25) * width, 0, rng:NextNumber(-0.25, 0.25) * depth),
			rng:NextNumber(10, 18),
			rng
		)
	end
end

-- A ring of ruins around `center`, skipping anything inside `keepClear` (a list of { center, radius }).
function Scenery.Skyline(
	parent: Instance,
	center: Vector3,
	count: number,
	minDistance: number,
	maxDistance: number,
	minHeight: number,
	maxHeight: number,
	seed: number,
	keepClear: { { Vector3 | number } }?
)
	local folder = Instance.new("Folder")
	folder.Name = "Skyline"
	folder.Parent = parent
	local rng = Random.new(seed)
	for i = 1, count do
		local angle = (i / count) * math.pi * 2 + rng:NextNumber(-0.15, 0.15)
		local distance = rng:NextNumber(minDistance, maxDistance)
		local pos = center + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
		local clear = true
		if keepClear then
			for _, zone in keepClear do
				local zc = zone[1] :: Vector3
				local zr = zone[2] :: number
				if (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(zc.X, 0, zc.Z)).Magnitude &lt; zr then
					clear = false
				end
			end
		end
		if clear then
			Scenery.Building(
				folder,
				pos,
				rng:NextNumber(36, 70),
				rng:NextNumber(36, 70),
				rng:NextNumber(minHeight, maxHeight),
				rng
			)
		end
	end
	return folder
end

return Scenery
</string>
      </Properties>
    </Item>
    <Item class="Script" referent="75">
      <Properties>
        <string name="Name">ServerMain</string>
        <token name="RunContext">0</token>
        <string name="Source">--!strict
-- Server entry point: builds the world, initialises services in dependency order, then starts them.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

Players.CharacterAutoLoads = false

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Services = script.Parent.Services
local WorldBuilder = require(script.Parent.WorldBuilder)

local Net = require(Services.Net)
local PlayerDataService = require(Services.PlayerDataService)
local MonetizationService = require(Services.MonetizationService)
local ResourceService = require(Services.ResourceService)
local StorageService = require(Services.StorageService)
local DropService = require(Services.DropService)
local FlashlightService = require(Services.FlashlightService)
local HazardService = require(Services.HazardService)
local TutorialService = require(Services.TutorialService)
local PlayerLifecycleService = require(Services.PlayerLifecycleService)
local InteractionService = require(Services.InteractionService)
local PartyService = require(Services.PartyService)
local DamageService = require(Services.DamageService)
local ZombieService = require(Services.ZombieService)
local CombatService = require(Services.CombatService)
local CraftService = require(Services.CraftService)
local MatchService = require(Services.MatchService)

Net.Init()
PlayerDataService.Init()
PlayerLifecycleService.Init()
ResourceService.Init()
StorageService.Init()
FlashlightService.Init()
TutorialService.Init()

if GameConfig.World.Mode == "Generated" then
	local world = WorldBuilder.Build()
	InteractionService.SetInteractables(world.interactables)
	DropService.SetInteractables(world.interactables)
	StorageService.SetStoragePart(world.storagePart)
	FlashlightService.SetGeneratorPart(world.generatorPart)
	HazardService.SetToxicZones(world.toxicZones)
	HazardService.SetVictoryZone(world.victoryZone)
	PlayerLifecycleService.SetWorld(world.interactables, world.roofDropPosition)
	CraftService.SetWorkbench(world.workbench)
	ZombieService.Start(world.root)
else
	warn("[ServerMain] World.Mode is Manual: wire a hand-built map into the services before playing")
end

HazardService.OnReturnedToRoof(ResourceService.OnReturnedToRoof)

PlayerDataService.Start()
MonetizationService.Start()
StorageService.Start()
DropService.Start()
FlashlightService.Start()
HazardService.Start()
TutorialService.Start()
InteractionService.Start()
PartyService.Start()
DamageService.Start()
CombatService.Start()
CraftService.Start()
MatchService.Start()
PlayerLifecycleService.Start() -- last: it loads characters, so everything above must be ready

print(("[Skyline Zero] Server ready, build %s"):format(require(ReplicatedStorage.Shared.PlacesConfig).Build))
</string>
      </Properties>
