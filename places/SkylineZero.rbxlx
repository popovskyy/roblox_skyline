      <Item class="ModuleScript" referent="77">
        <Properties>
          <string name="Name">BaseUpgradeService</string>
          <string name="Source">--!strict
-- Buys and applies base upgrades. Prices come only from UpgradeDefinitions.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Locale = require(ReplicatedStorage.Shared.Locale)
local UpgradeDefinitions = require(ReplicatedStorage.Shared.UpgradeDefinitions)
local SfxService = require(script.Parent.SfxService)
local Net = require(script.Parent.Net)
local PlayerDataService = require(script.Parent.PlayerDataService)
local StateSyncService = require(script.Parent.StateSyncService)
local StorageService = require(script.Parent.StorageService)

local BaseUpgradeService = {}

type Listener = (player: Player, upgradeId: string) -&gt; ()
local listeners: { Listener } = {}

function BaseUpgradeService.OnPurchased(listener: Listener)
	table.insert(listeners, listener)
end

function BaseUpgradeService.Owns(player: Player, upgradeId: string): boolean
	local data = PlayerDataService.Get(player)
	return data ~= nil and data.upgrades[upgradeId] == true
end

function BaseUpgradeService.Purchase(player: Player, upgradeId: any): (boolean, any)
	local data = PlayerDataService.Get(player)
	if not data then
		return false, "err.notLoaded"
	end
	local def = if type(upgradeId) == "string" then UpgradeDefinitions.Get(upgradeId) else nil
	if not def then
		return false, "err.unknownUpgrade"
	end
	if data.upgrades[def.id] then
		return false, { "upgrade.alreadyBuilt", Locale.Upgrade(def.id) }
	end
	for _, required in def.requires do
		if not data.upgrades[required] then
			return false, { "upgrade.requires", Locale.Upgrade(required) }
		end
	end
	local cost = UpgradeDefinitions.GetCost(def)
	if not StorageService.TrySpend(player, cost) then
		return false, { "upgrade.notEnough", Locale.Cost(cost) }
	end

	data.upgrades[def.id] = true
	PlayerDataService.MarkDirty(player)
	StateSyncService.Request(player)
	Net.Notify(player, { "upgrade.built", Locale.Upgrade(def.id) }, "success")
	SfxService.PlayAtPlayer(if def.id == "Generator" then "GeneratorStart" else "Build", player)
	for _, listener in listeners do
		task.spawn(listener, player, def.id)
	end
	-- Upgrades are important progress, so save right away instead of waiting for the autosave.
	task.spawn(PlayerDataService.Save, player)
	return true, nil
end

return BaseUpgradeService
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="78">
        <Properties>
          <string name="Name">CharacterUtil</string>
          <string name="Source">--!strict
-- Small helpers for validating a player's character on the server.

local CharacterUtil = {}

function CharacterUtil.GetRoot(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health &lt;= 0 then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

function CharacterUtil.GetHumanoid(player: Player): Humanoid?
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health &gt; 0 then
		return humanoid
	end
	return nil
end

-- Distance from the character to the closest point of the part's bounding box.
function CharacterUtil.DistanceTo(player: Player, part: BasePart): number
	local root = CharacterUtil.GetRoot(player)
	if not root then
		return math.huge
	end
	local localPos = part.CFrame:PointToObjectSpace(root.Position)
	local half = part.Size / 2
	local clamped = Vector3.new(
		math.clamp(localPos.X, -half.X, half.X),
		math.clamp(localPos.Y, -half.Y, half.Y),
		math.clamp(localPos.Z, -half.Z, half.Z)
	)
	return (localPos - clamped).Magnitude
end

function CharacterUtil.IsNear(player: Player, part: BasePart, maxDistance: number): boolean
	return CharacterUtil.DistanceTo(player, part) &lt;= maxDistance
end

return CharacterUtil
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="79">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source">--!strict
-- Melee combat. A weapon is in the player's hands only while it is selected in the hotbar (Equip remote);
-- selecting it again puts it away. The client only asks to swing; the server checks the cooldown and
-- hits zombies in front of the player.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ItemDefinitions = require(ReplicatedStorage.Shared.ItemDefinitions)
local RemoteNames = require(ReplicatedStorage.Shared.RemoteNames)
local SfxService = require(script.Parent.SfxService)
local CharacterUtil = require(script.Parent.CharacterUtil)
local DamageService = require(script.Parent.DamageService)
local Net = require(script.Parent.Net)
local PlayerDataService = require(script.Parent.PlayerDataService)
local PropLibrary = require(script.Parent.Parent.PropLibrary)
local RateLimiter = require(script.Parent.RateLimiter)
local ZombieService = require(script.Parent.ZombieService)

local CombatService = {}

local TOOL_NAME = "Weapon"
local lastSwing: { [Player]: number } = {}
local held: { [Player]: string } = {}
local equipped: { [Player]: string } = {}

local MESHES: { [string]: { prop: string, length: number } } = {
	Club = { prop = "WeaponClub", length = 3.4 },
	Pipe = { prop = "WeaponPipe", length = 3.7 },
	Machete = { prop = "WeaponMachete", length = 3.4 },
}

-- Simple shapes for each weapon so it reads in the hand without any mesh assets.
local LOOKS: { [string]: { size: Vector3, color: Color3, material: Enum.Material } } = {
	Club = { size = Vector3.new(0.5, 0.5, 3.4), color = Color3.fromRGB(120, 84, 52), material = Enum.Material.Wood },
	Pipe = { size = Vector3.new(0.4, 0.4, 3.8), color = Color3.fromRGB(130, 135, 140), material = Enum.Material.Metal },
	Machete = {
		size = Vector3.new(0.15, 0.7, 3.6),
		color = Color3.fromRGB(200, 205, 212),
		material = Enum.Material.Metal,
	},
}

-- The weapon in the player's hands, if they still carry it.
local function equippedWeapon(player: Player): ItemDefinitions.ItemDef?
	local id = equipped[player]
	local data = PlayerDataService.Get(player)
	if not id or not data or (data.inventory[id] or 0) &lt;= 0 then
		return nil
	end
	local def = ItemDefinitions.Get(id)
	return if def and def.weapon then def else nil
end

-- Lines the Blender mesh up with the tool: grip marker on the handle, the weapon pointing forward.
local function attachMesh(tool: Tool, handle: BasePart, weaponId: string): boolean
	local info = MESHES[weaponId]
	local model = info and PropLibrary.Raw(info.prop, false)
	if not model then
		return false
	end
	local grip: BasePart? = nil
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") and string.find(part.Name, "_Grip_") then
			grip = part
		end
	end
	local boxCFrame, boxSize = model:GetBoundingBox()
	local longest = math.max(boxSize.X, boxSize.Y, boxSize.Z)
	model.WorldPivot = boxCFrame
	model:ScaleTo(info.length / longest)
	local center = model:GetBoundingBox().Position
	local gripPos = if grip then grip.Position else center
	local along = (center - gripPos)
	local forward = if along.Magnitude &gt; 0.05 then along.Unit else boxCFrame.LookVector
	-- Rotate so `forward` matches the handle's look vector, then move the grip onto the handle.
	local current = CFrame.lookAt(gripPos, gripPos + forward)
	local target = handle.CFrame
	local delta = target * current:Inverse()
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") then
			part.CFrame = delta * part.CFrame
			part.Anchored = false
			part.Massless = true
			part.CanCollide = false
			part.CanQuery = false
			if part == grip then
				part.Transparency = 1
			end
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = part
			weld.Parent = part
			part.Parent = tool
		end
	end
	model:Destroy()
	return true
end

local function makeTool(weaponId: string): Tool
	local look = LOOKS[weaponId] or LOOKS.Club
	local tool = Instance.new("Tool")
	tool.Name = TOOL_NAME
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ToolTip = ""
	tool:SetAttribute("WeaponId", weaponId)
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool
	if attachMesh(tool, handle, weaponId) then
		-- The mesh is the look; the handle is just the point the hand holds.
		handle.Size = Vector3.new(0.3, 0.3, 0.3)
		handle.Transparency = 1
		tool.Grip = CFrame.new()
	else
		handle.Size = look.size
		handle.Color = look.color
		handle.Material = look.material
		tool.Grip = CFrame.new(0, 0, look.size.Z / 2 - 0.4)
	end
	return tool
end

-- Puts the right weapon in the player's hands. Cheap to call often.
local function refreshTool(player: Player)
	local character = player.Character
	if not character or not CharacterUtil.GetHumanoid(player) then
		return
	end
	local def = equippedWeapon(player)
	local current = character:FindFirstChild(TOOL_NAME)
	if not def then
		if current then
			current:Destroy()
		end
		held[player] = nil
		return
	end
	if current and current:GetAttribute("WeaponId") == def.id then
		return
	end
	if current then
		current:Destroy()
	end
	-- Anything sitting in the Backpack (Roblox moves unequipped tools there) is ours too; clear it.
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		for _, t in backpack:GetChildren() do
			if t.Name == TOOL_NAME then
				t:Destroy()
			end
		end
	end
	makeTool(def.id).Parent = character
	held[player] = def.id
end

local function swing(player: Player)
	if DamageService.IsDowned(player) then
		return
	end
	local def = equippedWeapon(player)
	local weapon = def and def.weapon
	local root = CharacterUtil.GetRoot(player)
	if not def or not weapon or not root then
		return
	end
	local now = os.clock()
	if lastSwing[player] and now - lastSwing[player] &lt; weapon.cooldown then
		return
	end
	lastSwing[player] = now

	-- The classic Animate script plays a slash when a StringValue "toolanim" appears in the held tool.
	local tool = player.Character and player.Character:FindFirstChild(TOOL_NAME)
	if tool then
		local anim = Instance.new("StringValue")
		anim.Name = "toolanim"
		anim.Value = "Slash"
		anim.Parent = tool
		task.delay(0.3, function()
			anim:Destroy()
		end)
	end

	SfxService.Play("Swing", root, 0.8)
	local look = root.CFrame.LookVector
	for _, z in ZombieService.All() do
		if z.humanoid.Health &gt; 0 then
			local offset = z.root.Position - root.Position
			local flat = Vector3.new(offset.X, 0, offset.Z)
			if flat.Magnitude &lt;= weapon.range and math.abs(offset.Y) &lt; 5 then
				local facing = if flat.Magnitude &gt; 0.1 then look:Dot(flat.Unit) else 1
				if facing &gt; 0.2 then
					z.humanoid:TakeDamage(weapon.damage)
					SfxService.Play("HitBlunt", z.root)
					-- A little shove so hits feel solid.
					z.root.AssemblyLinearVelocity += flat.Unit * 25 + Vector3.new(0, 8, 0)
				end
			end
		end
	end
end

function CombatService.OnCharacterAdded(player: Player)
	held[player] = nil
	task.defer(refreshTool, player)
end

-- Hotbar selection: equip this weapon, or put it away when it is already in hand (or itemId is nil).
local function equip(player: Player, itemId: any)
	local def = if type(itemId) == "string" then ItemDefinitions.Get(itemId) else nil
	if not def or not def.weapon or equipped[player] == itemId then
		equipped[player] = nil
	else
		local data = PlayerDataService.Get(player)
		if not data or (data.inventory[def.id] or 0) &lt;= 0 then
			return
		end
		equipped[player] = def.id
	end
	player:SetAttribute("Equipped", equipped[player])
	refreshTool(player)
end

function CombatService.Start()
	Net.Get(RemoteNames.Attack).OnServerEvent:Connect(swing)
	Net.Get(RemoteNames.Equip).OnServerEvent:Connect(function(player, itemId)
		if RateLimiter.Allow(player, "Equip", 0.2) then
			equip(player, itemId)
		end
	end)
	-- Losing the equipped weapon (game reset) clears the hands within a second.
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in Players:GetPlayers() do
				refreshTool(player)
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastSwing[player] = nil
		held[player] = nil
		equipped[player] = nil
	end)
end

return CombatService
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="80">
        <Properties>
          <string name="Name">CraftService</string>
          <string name="Source">--!strict
-- Workbench on the roof: turns resources into bandages and weapons. Recipes live in GameConfig.Recipes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local ItemDefinitions = require(ReplicatedStorage.Shared.ItemDefinitions)
local Locale = require(ReplicatedStorage.Shared.Locale)
local RemoteNames = require(ReplicatedStorage.Shared.RemoteNames)
local SfxService = require(script.Parent.SfxService)
local CharacterUtil = require(script.Parent.CharacterUtil)
local InventoryService = require(script.Parent.InventoryService)
local Net = require(script.Parent.Net)
local RateLimiter = require(script.Parent.RateLimiter)
local StorageService = require(script.Parent.StorageService)

local CraftService = {}

local workbench: BasePart? = nil

function CraftService.SetWorkbench(part: BasePart)
	workbench = part
end

-- Opened from the workbench prompt (InteractionService).
function CraftService.Open(player: Player): (boolean, any)
	Net.Get(RemoteNames.OpenCraft):FireClient(player)
	return true, nil
end

local function craft(player: Player, recipeId: any): (boolean, any)
	local recipe = nil
	for _, r in GameConfig.Recipes do
		if r.id == recipeId then
			recipe = r
		end
	end
	if not recipe then
		return false, "craft.unknown"
	end
	if not workbench or not CharacterUtil.IsNear(player, workbench, GameConfig.InteractionDistance + 4) then
		return false, "craft.tooFar"
	end
	local def = ItemDefinitions.Items[recipe.id]
	if def.weapon and InventoryService.GetCount(player, recipe.id) &gt; 0 then
		return false, "craft.haveIt"
	end
	if not InventoryService.CanAdd(player, recipe.id, 1) and def.weight &gt; 0 then
		return false, "storage.invFull"
	end
	-- Pays from the backpack first, then from the chest, all or nothing.
	if not StorageService.TrySpend(player, recipe.cost) then
		return false, { "upgrade.notEnough", Locale.Cost(recipe.cost) }
	end
	InventoryService.ForceAdd(player, recipe.id, 1)
	SfxService.PlayAtPlayer("Build", player, 0.8)
	Net.Notify(player, { "craft.done", Locale.Item(recipe.id) }, "success")
	return true, nil
end

function CraftService.Start()
	Net.Get(RemoteNames.Craft).OnServerEvent:Connect(function(player, recipeId)
		if not RateLimiter.Allow(player, "Craft", 0.4) then
			return
		end
		local ok, reason = craft(player, recipeId)
		if not ok and reason then
			Net.Notify(player, reason, "warning")
		end
	end)
end

return CraftService
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="81">
        <Properties>
          <string name="Name">DamageService</string>
          <string name="Source">--!strict
-- All damage to players goes through here. A hit that would kill leaves the player downed instead:
-- they lie on the ground for as long as it takes until a teammate holding a Bandage lifts them up
-- (later also a Robux self-revive, see MonetizationConfig). When nobody is left standing the match is lost.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Locale = require(ReplicatedStorage.Shared.Locale)
local SfxService = require(script.Parent.SfxService)
local CharacterUtil = require(script.Parent.CharacterUtil)
local InventoryService = require(script.Parent.InventoryService)
local Net = require(script.Parent.Net)
local MonetizationService = require(script.Parent.MonetizationService)
local RateLimiter = require(script.Parent.RateLimiter)

local DamageService = {}

type DownedState = {
	character: Model,
	prompt: ProximityPrompt,
	walkSpeed: number,
	jumpHeight: number,
	token: number,
}

local downed: { [Player]: DownedState } = {}
local tokens = 0
local PROMPT_NAME = "RevivePrompt"

function DamageService.IsDowned(player: Player): boolean
	return downed[player] ~= nil
end

local function clearDowned(player: Player, restore: boolean)
	local state = downed[player]
	if not state then
		return
	end
	downed[player] = nil
	player:SetAttribute("Downed", nil)
	if state.prompt.Parent then
		state.prompt:Destroy()
	end
	local humanoid = state.character:FindFirstChildOfClass("Humanoid")
	if humanoid and restore then
		humanoid.PlatformStand = false
		humanoid.WalkSpeed = state.walkSpeed
		humanoid.JumpHeight = state.jumpHeight
	end
end

type Listener = () -&gt; ()
local allDownListeners: { Listener } = {}

-- Fires once when every player in the server is down: the match is lost.
function DamageService.OnAllDown(listener: Listener)
	table.insert(allDownListeners, listener)
end

local function checkAllDown()
	if #Players:GetPlayers() == 0 then
		return
	end
	for _, player in Players:GetPlayers() do
		if not downed[player] and CharacterUtil.GetHumanoid(player) then
			return
		end
	end
	for _, listener in allDownListeners do
		task.spawn(listener)
	end
end

local function goDown(player: Player, humanoid: Humanoid)
	local character = humanoid.Parent :: Model
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		humanoid.Health = 0
		return
	end
	tokens += 1
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = PROMPT_NAME
	prompt.ActionText = Locale.T("en", "revive.action")
	prompt.ObjectText = player.DisplayName
	prompt:SetAttribute("ActionKey", "revive.action")
	prompt:SetAttribute("ReviveUserId", player.UserId)
	prompt.HoldDuration = GameConfig.ReviveHoldSeconds
	prompt.MaxActivationDistance = GameConfig.PromptActivationDistance
	prompt.RequiresLineOfSight = false
	prompt.Parent = root

	local state: DownedState = {
		character = character,
		prompt = prompt,
		walkSpeed = humanoid.WalkSpeed,
		jumpHeight = humanoid.JumpHeight,
		token = tokens,
	}
	downed[player] = state
	humanoid.Health = 1
	humanoid.WalkSpeed = 0
	humanoid.JumpHeight = 0
	humanoid.PlatformStand = true -- the body topples over and lies there

	player:SetAttribute("Downed", true)
	for _, other in Players:GetPlayers() do
		if other ~= player then
			Net.Notify(other, { "downed.someone", player.DisplayName }, "warning")
		end
	end
	checkAllDown()
end

-- Lifts a downed player back up. Used by teammates with a Bandage and by the future Robux self-revive.
function DamageService.Revive(player: Player): boolean
	local state = downed[player]
	if not state then
		return false
	end
	local humanoid = state.character:FindFirstChildOfClass("Humanoid")
	clearDowned(player, true)
	if humanoid then
		humanoid.Health = math.max(humanoid.Health, GameConfig.ReviveHealth)
	end
	return true
end

-- Damage a player. Never kills outright: a lethal hit leaves them downed.
function DamageService.Damage(player: Player, amount: number)
	if amount &lt;= 0 or downed[player] then
		return
	end
	local humanoid = CharacterUtil.GetHumanoid(player)
	if not humanoid then
		return
	end
	if amount &gt;= 5 then
		SfxService.PlayAtPlayer("Hurt", player, 0.7)
	end
	if humanoid.Health - amount &gt; 1 then
		humanoid:TakeDamage(amount)
	else
		goDown(player, humanoid)
	end
end

local function tryRevive(prompt: ProximityPrompt, rescuer: Player)
	if prompt.Name ~= PROMPT_NAME then
		return
	end
	local userId = prompt:GetAttribute("ReviveUserId")
	local target = if type(userId) == "number" then Players:GetPlayerByUserId(userId) else nil
	local state = target and downed[target]
	if not target or not state or target == rescuer or downed[rescuer] then
		return
	end
	if not RateLimiter.Allow(rescuer, "Revive", 1) then
		return
	end
	local root = prompt.Parent
	if
		not root
		or not root:IsA("BasePart")
		or not CharacterUtil.IsNear(rescuer, root, GameConfig.InteractionDistance)
	then
		Net.Notify(rescuer, "err.tooFar", "warning")
		return
	end
	if not InventoryService.Remove(rescuer, "Bandage", 1) then
		Net.Notify(rescuer, "revive.needBandage", "warning")
		return
	end
	DamageService.Revive(target)
	SfxService.PlayAtPlayer("Bandage", target)
	Net.Notify(target, { "revive.revivedBy", rescuer.DisplayName }, "success")
	Net.Notify(rescuer, { "revive.youRevived", target.DisplayName }, "success")
end

-- A fresh character is never downed.
function DamageService.OnCharacterAdded(player: Player)
	clearDowned(player, false)
end

function DamageService.Start()
	ProximityPromptService.PromptTriggered:Connect(tryRevive)
	Players.PlayerRemoving:Connect(function(player)
		clearDowned(player, false)
		-- The last one standing leaving also ends the match for the others.
		task.defer(checkAllDown)
	end)
	MonetizationService.RegisterProductHandler("SelfRevive", function(player)
		return DamageService.Revive(player)
	end)
end

return DamageService
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="82">
        <Properties>
          <string name="Name">FlashlightService</string>
          <string name="Source">--!strict
-- Flashlight: the server owns the on/off state, the battery and the light on the character.
-- The battery drains while on and charges next to the player's built Generator.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local CharacterUtil = require(script.Parent.CharacterUtil)
local InventoryService = require(script.Parent.InventoryService)
local Net = require(script.Parent.Net)
local PlayerDataService = require(script.Parent.PlayerDataService)
local StateSyncService = require(script.Parent.StateSyncService)

local FlashlightService = {}

local BEAM_NAME = "FlashlightBeam"
local TICK = 0.5

local isOn: { [Player]: boolean } = {}
local generatorPart: BasePart? = nil

function FlashlightService.SetGeneratorPart(part: BasePart)
	generatorPart = part
end

local function getBeam(player: Player, create: boolean): SpotLight?
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not head then
		return nil
	end
	local beam = head:FindFirstChild(BEAM_NAME)
	if beam and beam:IsA("SpotLight") then
		return beam
	end
	if not create then
		return nil
	end
	local light = Instance.new("SpotLight")
	light.Name = BEAM_NAME
	light.Brightness = 3
	light.Range = 40
	light.Angle = 70
	light.Face = Enum.NormalId.Front
	light.Shadows = true
	light.Color = Color3.fromRGB(255, 240, 210)
	light.Enabled = false
	light.Parent = head
	return light
end

local function apply(player: Player)
	local on = isOn[player] == true
	player:SetAttribute("FlashlightOn", on)
	local beam = getBeam(player, on)
	if beam then
		beam.Enabled = on
	end
end

function FlashlightService.SetOn(player: Player, on: boolean)
	local data = PlayerDataService.Get(player)
	if not data then
		return
	end
	if on then
		if not InventoryService.Has(player, "Flashlight", 1) then
			Net.Notify(player, "flash.none", "warning")
			return
		end
		if data.flashlightCharge &lt;= 0 then
			Net.Notify(player, "flash.empty", "warning")
			return
		end
	end
	isOn[player] = on
	apply(player)
end

function FlashlightService.Toggle(player: Player)
	FlashlightService.SetOn(player, not isOn[player])
end

-- Called after a respawn so the new character gets the light again.
function FlashlightService.OnCharacterAdded(player: Player)
	isOn[player] = false
	apply(player)
end

local function nearGenerator(player: Player): boolean
	local data = PlayerDataService.Get(player)
	return data ~= nil
		and data.upgrades.Generator == true
		and generatorPart ~= nil
		and CharacterUtil.IsNear(player, generatorPart, GameConfig.FlashlightChargeRadius)
end

local function tick(player: Player, dt: number)
	local data = PlayerDataService.Get(player)
	if not data then
		return
	end
	local before = math.floor(data.flashlightCharge)
	if isOn[player] then
		if not InventoryService.Has(player, "Flashlight", 1) then
			isOn[player] = false
			apply(player)
		else
			data.flashlightCharge = math.max(0, data.flashlightCharge - dt)
			if data.flashlightCharge &lt;= 0 then
				isOn[player] = false
				apply(player)
				Net.Notify(player, "flash.drained", "warning")
			end
		end
	elseif InventoryService.Has(player, "Flashlight", 1) and nearGenerator(player) then
		local max = GameConfig.FlashlightBatterySeconds
		if data.flashlightCharge &lt; max then
			data.flashlightCharge = math.min(max, data.flashlightCharge + GameConfig.FlashlightChargePerSecond * dt)
			if data.flashlightCharge &gt;= max then
				Net.Notify(player, "flash.full", "success")
			end
		end
	end
	local after = math.floor(data.flashlightCharge)
	if after ~= before then
		player:SetAttribute("FlashlightCharge", after)
		PlayerDataService.MarkDirty(player)
		-- The HUD reads the attribute every second; a full snapshot is only needed at the ends of the range.
		if after == 0 or after == GameConfig.FlashlightBatterySeconds then
			StateSyncService.Request(player)
		end
	end
end

function FlashlightService.Init()
	StateSyncService.RegisterProvider(function(player, snapshot)
		local data = PlayerDataService.Get(player)
		snapshot.flashlightCharge = if data then math.floor(data.flashlightCharge) else 0
		snapshot.flashlightMax = GameConfig.FlashlightBatterySeconds
		if data then
			player:SetAttribute("FlashlightCharge", math.floor(data.flashlightCharge))
		end
	end)
end

function FlashlightService.Start()
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator &lt; TICK then
			return
		end
		local step = accumulator
		accumulator = 0
		for _, player in Players:GetPlayers() do
			tick(player, step)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		isOn[player] = nil
	end)
end

return FlashlightService
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="83">
        <Properties>
          <string name="Name">HazardService</string>
          <string name="Source">--!strict
-- Fall damage, toxic air, hunger and zone/expedition tracking. All health changes happen here on the server.
-- Live values the HUD needs are published as player attributes: Zone, InToxic, Hunger, Hungry.
--
-- Hunger is a meter that empties over time everywhere (faster below the roof); eating Food fills it,
-- an empty meter slowly drains health. An expedition starts when the player goes well below the roof
-- and ends after they have stood on the roof for a moment (that refills the resource nodes).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local CharacterUtil = require(script.Parent.CharacterUtil)
local DamageService = require(script.Parent.DamageService)
local Net = require(script.Parent.Net)
local PlayerDataService = require(script.Parent.PlayerDataService)

local HazardService = {}

type Tracker = {
	spawnedAt: number,
	airborne: boolean,
	minVelocityY: number,
	toxicTime: number,
	warnedToxic: boolean,
	zone: string,
	onExpedition: boolean,
	roofTime: number,
	hunger: number,
	warnedHungry: boolean,
}

local trackers: { [Player]: Tracker } = {}
local toxicZones: { BasePart } = {}
local victoryZone: BasePart? = nil

type ZoneListener = (player: Player, newZone: string, oldZone: string) -&gt; ()
local zoneListeners: { ZoneListener } = {}
type PlayerListener = (player: Player) -&gt; ()
local roofReturnListeners: { PlayerListener } = {}

local FALL_START_VELOCITY = -30
local FALL_END_VELOCITY = -3
local EXPEDITION_DEPTH = 8 -- studs below the roof surface that count as leaving the base
local ROOF_RETURN_SECONDS = 2

local World = GameConfig.World

function HazardService.SetToxicZones(zones: { BasePart })
	toxicZones = zones
end

function HazardService.SetVictoryZone(zone: BasePart)
	victoryZone = zone
end

function HazardService.OnZoneChanged(listener: ZoneListener)
	table.insert(zoneListeners, listener)
end

-- Fires when an expedition ends back on the roof.
function HazardService.OnReturnedToRoof(listener: PlayerListener)
	table.insert(roofReturnListeners, listener)
end

function HazardService.IsOnExpedition(player: Player): boolean
	local t = trackers[player]
	return t ~= nil and t.onExpedition
end

function HazardService.GetZone(player: Player): string
	local t = trackers[player]
	return t and t.zone or "Roof"
end

function HazardService.ResetCharacter(player: Player)
	trackers[player] = {
		spawnedAt = os.clock(),
		airborne = false,
		minVelocityY = 0,
		toxicTime = 0,
		warnedToxic = false,
		zone = "Roof",
		onExpedition = false,
		roofTime = 0,
		hunger = GameConfig.HungerMax,
		warnedHungry = false,
	}
	player:SetAttribute("InToxic", false)
	player:SetAttribute("Hungry", false)
	player:SetAttribute("Hunger", GameConfig.HungerMax)
	player:SetAttribute("Zone", "Roof")
end

-- Eating. Returns false when the player is already full, so no food is wasted.
function HazardService.Feed(player: Player): boolean
	local t = trackers[player]
	if not t or t.hunger &gt;= GameConfig.HungerMax - 1 then
		return false
	end
	t.hunger = math.min(GameConfig.HungerMax, t.hunger + GameConfig.FoodRestore)
	t.warnedHungry = false
	player:SetAttribute("Hunger", math.floor(t.hunger))
	player:SetAttribute("Hungry", false)
	return true
end

local function isInside(part: BasePart, position: Vector3): boolean
	local localPos = part.CFrame:PointToObjectSpace(position)
	local half = part.Size / 2
	return math.abs(localPos.X) &lt;= half.X and math.abs(localPos.Y) &lt;= half.Y and math.abs(localPos.Z) &lt;= half.Z
end

-- Zone names: "Roof", "Floor01".."Floor04", "Outside" (neighbour tower, falling, etc).
local function zoneFor(position: Vector3): string
	if victoryZone and isInside(victoryZone, position) then
		return "NeighborRoof"
	end
	local half = World.RoofSize / 2 + 2
	if math.abs(position.X) &gt; half or math.abs(position.Z) &gt; half then
		return "Outside"
	end
	if position.Y &gt;= World.RoofY - 1 then
		return "Roof"
	end
	for level = 1, World.FloorCount do
		local floorY = World.RoofY - level * World.FloorSpacing
		if position.Y &gt;= floorY - 1 then
			return ("Floor%02d"):format(level)
		end
	end
	return "Outside"
end

local function setZone(player: Player, t: Tracker, zone: string)
	if zone == t.zone then
		return
	end
	local old = t.zone
	t.zone = zone
	player:SetAttribute("Zone", zone)
	for _, listener in zoneListeners do
		task.spawn(listener, player, zone, old)
	end
end

local function updateFall(player: Player, t: Tracker, root: BasePart, _humanoid: Humanoid)
	if os.clock() - t.spawnedAt &lt; 1.5 then
		t.airborne = false
		t.minVelocityY = 0
		return
	end
	-- Uses only the replicated velocity: FloorMaterial is not reliable on the server.
	-- A fall starts once the player drops faster than any ramp walk and ends when the drop stops.
	local vy = root.AssemblyLinearVelocity.Y
	if vy &lt; FALL_START_VELOCITY then
		t.airborne = true
		t.minVelocityY = math.min(t.minVelocityY, vy)
		return
	end
	if t.airborne and vy &gt; FALL_END_VELOCITY then
		t.airborne = false
		-- Height equivalent of the impact speed: v^2 / 2g. Walking down ramps never gets near the threshold.
		local impact = -math.min(t.minVelocityY, vy)
		t.minVelocityY = 0
		if impact &gt; 0 then
			local height = impact * impact / (2 * workspace.Gravity)
			local over = height - GameConfig.FallDamageThreshold
			if over &gt; 0 then
				local damage = math.floor(over * GameConfig.FallDamagePerStud)
				if damage &gt; 0 then
					DamageService.Damage(player, damage)
					Net.Notify(player, { "hazard.fall", damage }, "warning")
				end
			end
		end
	end
end

local function updateToxic(player: Player, t: Tracker, root: BasePart, _humanoid: Humanoid, dt: number)
	local inside = false
	for _, zone in toxicZones do
		if isInside(zone, root.Position) then
			inside = true
			break
		end
	end
	if not inside then
		if t.toxicTime &gt; 0 then
			t.toxicTime = 0
			t.warnedToxic = false
			player:SetAttribute("InToxic", false)
		end
		return
	end
	if t.toxicTime == 0 then
		player:SetAttribute("InToxic", true)
	end
	t.toxicTime += dt
	if not t.warnedToxic then
		t.warnedToxic = true
		Net.Notify(player, "hazard.toxic", "warning")
	end
	if t.toxicTime &lt; GameConfig.ToxicGraceSeconds then
		return
	end
	local data = PlayerDataService.Get(player)
	local multiplier = 1
	if data and data.upgrades.AirFilter then
		multiplier = 1 - GameConfig.AirFilterToxicReduction
	end
	DamageService.Damage(player, GameConfig.ToxicDamagePerSecond * multiplier * dt)
end

local function updateExpedition(player: Player, t: Tracker, root: BasePart, _humanoid: Humanoid, dt: number)
	if not t.onExpedition then
		if t.zone ~= "Roof" and t.zone ~= "NeighborRoof" and root.Position.Y &lt; World.RoofY - EXPEDITION_DEPTH then
			t.onExpedition = true
			t.roofTime = 0
		end
	elseif t.zone == "Roof" then
		t.roofTime += dt
		if t.roofTime &gt;= ROOF_RETURN_SECONDS then
			t.onExpedition = false
			for _, listener in roofReturnListeners do
				task.spawn(listener, player)
			end
		end
	else
		t.roofTime = 0
	end

	-- Hunger meter.
	local drain = if t.onExpedition then GameConfig.HungerDrainBelow else GameConfig.HungerDrainRoof
	local before = math.floor(t.hunger)
	t.hunger = math.max(0, t.hunger - drain * dt)
	local after = math.floor(t.hunger)
	if after ~= before then
		player:SetAttribute("Hunger", after)
	end
	local hungry = t.hunger &lt;= GameConfig.HungerWarnAt
	if hungry ~= (player:GetAttribute("Hungry") == true) then
		player:SetAttribute("Hungry", hungry)
	end
	if t.hunger &lt;= 0 then
		if not t.warnedHungry then
			t.warnedHungry = true
			Net.Notify(player, "hazard.hungry", "error")
		end
		DamageService.Damage(player, GameConfig.HungerDamagePerSecond * dt)
	end
end

function HazardService.Start()
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		local slowTick = accumulator &gt;= GameConfig.HazardTickSeconds
		local slowDt = accumulator
		if slowTick then
			accumulator = 0
		end
		for player, t in trackers do
			local root = CharacterUtil.GetRoot(player)
			local humanoid = CharacterUtil.GetHumanoid(player)
			if root and humanoid then
				updateFall(player, t, root, humanoid)
				if slowTick then
					setZone(player, t, zoneFor(root.Position))
					updateToxic(player, t, root, humanoid, slowDt)
					updateExpedition(player, t, root, humanoid, slowDt)
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		trackers[player] = nil
	end)
end

function HazardService.StopTracking(player: Player)
	trackers[player] = nil
end

return HazardService
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="84">
        <Properties>
          <string name="Name">InteractionService</string>
          <string name="Source">--!strict
-- Every ProximityPrompt in the world ends up here. The server re-checks the object, the distance and the rate
-- before handing the request to the service that owns it.

local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local RemoteNames = require(ReplicatedStorage.Shared.RemoteNames)
local BaseUpgradeService = require(script.Parent.BaseUpgradeService)
local CharacterUtil = require(script.Parent.CharacterUtil)
local CraftService = require(script.Parent.CraftService)
local DamageService = require(script.Parent.DamageService)
local Net = require(script.Parent.Net)
local PlayerDataService = require(script.Parent.PlayerDataService)
local PlayerLifecycleService = require(script.Parent.PlayerLifecycleService)
local RateLimiter = require(script.Parent.RateLimiter)
local DropService = require(script.Parent.DropService)
local ResourceService = require(script.Parent.ResourceService)
local TutorialService = require(script.Parent.TutorialService)

local InteractionService = {}

local interactables: Folder? = nil

function InteractionService.SetInteractables(folder: Folder)
	interactables = folder
end

type Handler = (player: Player, target: BasePart) -&gt; (boolean, any)

local handlers: { [string]: Handler } = {
	Resource = function(player, target)
		return ResourceService.Collect(player, target)
	end,
	Rubble = function(player, target)
		return ResourceService.ClearRubble(player, target)
	end,
	Terminal = function(player)
		TutorialService.ReadTerminal(player)
		return true, nil
	end,
	Storage = function(player)
		local data = PlayerDataService.Get(player)
		if not data or not data.upgrades.StorageCrate then
			return false, "interact.noStorage"
		end
		Net.Get(RemoteNames.OpenStorage):FireClient(player)
		return true, nil
	end,
	Upgrade = function(player, target)
		return BaseUpgradeService.Purchase(player, target:GetAttribute("UpgradeId"))
	end,
	Gate = function(player, target)
		local required = target:GetAttribute("RequiresUpgrade")
		if type(required) == "string" and not BaseUpgradeService.Owns(player, required) then
			return false, "interact.gateLocked"
		end
		return true, nil
	end,
	Backpack = function(player, target)
		return PlayerLifecycleService.RecoverBackpack(player, target)
	end,
	LootChest = function(player, target)
		return ResourceService.OpenCrate(player, target)
	end,
	GroundDrop = function(player, target)
		return DropService.Pickup(player, target)
	end,
	Workbench = function(player)
		return CraftService.Open(player)
	end,
}

local function onPromptTriggered(prompt: ProximityPrompt, player: Player)
	local folder = interactables
	local target = prompt.Parent
	if not folder or not target or not target:IsA("BasePart") or not target:IsDescendantOf(folder) then
		return
	end
	if not CharacterUtil.GetRoot(player) or DamageService.IsDowned(player) then
		return
	end
	if not RateLimiter.Allow(player, "Interact", GameConfig.InteractionCooldown) then
		return
	end
	if not CharacterUtil.IsNear(player, target, GameConfig.InteractionDistance) then
		Net.Notify(player, "err.tooFar", "warning")
		return
	end
	local interactType = target:GetAttribute("InteractType")
	local handler = if type(interactType) == "string" then handlers[interactType] else nil
	if not handler then
		return
	end
	local ok, reason = handler(player, target)
	if not ok and reason then
		Net.Notify(player, reason, "warning")
	end
end

function InteractionService.Start()
	ProximityPromptService.PromptTriggered:Connect(onPromptTriggered)
end

return InteractionService
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="85">
        <Properties>
          <string name="Name">InventoryService</string>
          <string name="Source">--!strict
-- Carried inventory with a weight limit. The only code that changes inventory counts.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local ItemDefinitions = require(ReplicatedStorage.Shared.ItemDefinitions)
local Types = require(ReplicatedStorage.Shared.Types)
local MonetizationService = require(script.Parent.MonetizationService)
local PlayerDataService = require(script.Parent.PlayerDataService)
local StateSyncService = require(script.Parent.StateSyncService)

local InventoryService = {}

local function isPositiveInt(value: any): boolean
	return type(value) == "number" and value == value and value &gt; 0 and value &lt; math.huge and value % 1 == 0
end

function InventoryService.IsPositiveInt(value: any): boolean
	return isPositiveInt(value)
end

function InventoryService.WeightOf(counts: Types.ItemCounts): number
	local total = 0
	for id, amount in counts do
		local def = ItemDefinitions.Get(id)
		if def then
			total += def.weight * amount
		end
	end
	return total
end

function InventoryService.GetCapacity(player: Player): number
	return GameConfig.MaxInventoryWeight + MonetizationService.GetInventoryBonus(player)
end

function InventoryService.GetWeight(player: Player): number
	local data = PlayerDataService.Get(player)
	return data and InventoryService.WeightOf(data.inventory) or 0
end

function InventoryService.GetCount(player: Player, itemId: string): number
	local data = PlayerDataService.Get(player)
	return data and data.inventory[itemId] or 0
end

-- How many of itemId fit into the remaining carry weight.
function InventoryService.SpaceFor(player: Player, itemId: string): number
	local def = ItemDefinitions.Get(itemId)
	if not def or def.weight &lt;= 0 then
		return 0
	end
	local free = InventoryService.GetCapacity(player) - InventoryService.GetWeight(player)
	return math.max(0, math.floor(free / def.weight))
end

function InventoryService.CanAdd(player: Player, itemId: string, amount: number): boolean
	return isPositiveInt(amount) and InventoryService.SpaceFor(player, itemId) &gt;= amount
end

function InventoryService.Add(player: Player, itemId: string, amount: number): boolean
	local data = PlayerDataService.Get(player)
	if not data or not ItemDefinitions.IsValid(itemId) or not InventoryService.CanAdd(player, itemId, amount) then
		return false
	end
	data.inventory[itemId] = (data.inventory[itemId] or 0) + amount
	PlayerDataService.MarkDirty(player)
	StateSyncService.Request(player)
	return true
end

-- Adds without the weight check. Only for returning items the player already owned (e.g. a death backpack).
function InventoryService.ForceAdd(player: Player, itemId: string, amount: number): boolean
	local data = PlayerDataService.Get(player)
	if not data or not ItemDefinitions.IsValid(itemId) or not isPositiveInt(amount) then
		return false
	end
	data.inventory[itemId] = (data.inventory[itemId] or 0) + amount
	PlayerDataService.MarkDirty(player)
	StateSyncService.Request(player)
	return true
end

function InventoryService.Has(player: Player, itemId: string, amount: number): boolean
	return InventoryService.GetCount(player, itemId) &gt;= amount
end

function InventoryService.Remove(player: Player, itemId: string, amount: number): boolean
	local data = PlayerDataService.Get(player)
	if not data or not ItemDefinitions.IsValid(itemId) or not isPositiveInt(amount) then
		return false
	end
	local current = data.inventory[itemId] or 0
	if current &lt; amount then
		return false
	end
	data.inventory[itemId] = current - amount
	PlayerDataService.MarkDirty(player)
	StateSyncService.Request(player)
	return true
end

return InventoryService
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="86">
        <Properties>
          <string name="Name">MatchService</string>
          <string name="Source">--!strict
-- Ends a lost match: when everyone is down, show "you lost" to all players, then send the whole
-- server back to the lobby. Where teleporting is impossible (Studio, lobby not published) the run
-- restarts in place with fresh characters and a clean slate.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local PlacesConfig = require(ReplicatedStorage.Shared.PlacesConfig)
local RemoteNames = require(ReplicatedStorage.Shared.RemoteNames)
local DamageService = require(script.Parent.DamageService)
local Net = require(script.Parent.Net)
local PlayerDataService = require(script.Parent.PlayerDataService)
local ResourceService = require(script.Parent.ResourceService)

local MatchService = {}

local ending = false

local function restartInPlace()
	for _, player in Players:GetPlayers() do
		PlayerDataService.Reset(player)
		ResourceService.OnReturnedToRoof(player)
		player:LoadCharacter()
	end
end

local function sendToLobby(): boolean
	if PlacesConfig.LobbyPlaceId == 0 or RunService:IsStudio() then
		return false
	end
	local ok, err = pcall(function()
		TeleportService:TeleportAsync(PlacesConfig.LobbyPlaceId, Players:GetPlayers())
	end)
	if not ok then
		warn("[Match] teleport to lobby failed:", err)
	end
	return ok
end

local function onAllDown()
	if ending then
		return
	end
	ending = true
	for _, player in Players:GetPlayers() do
		Net.Get(RemoteNames.ShowNote):FireClient(player, {
			kind = "ending",
			title = "gameover.title",
			body = "gameover.body",
			footer = "gameover.footer",
		})
	end
	task.wait(GameConfig.GameOverSeconds)
	if not sendToLobby() then
		restartInPlace()
	end
	-- Give a failed teleport time to settle before another game over can trigger.
	task.wait(5)
	ending = false
end

function MatchService.Start()
	DamageService.OnAllDown(onAllDown)
end

return MatchService
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="87">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source">--!strict
-- Single entry point for Game Passes and Developer Products.
-- With MonetizationConfig.Enabled = false every query returns the free-player answer
-- and ProcessReceipt is not bound, so the rest of the game never has to check.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MonetizationConfig = require(ReplicatedStorage.Shared.MonetizationConfig)

local MonetizationService = {}

type ProductHandler = (player: Player) -&gt; boolean

local ownedPasses: { [Player]: { [string]: boolean } } = {}
local productHandlers: { [string]: ProductHandler } = {}

-- A handler returns true once the purchase has been granted.
function MonetizationService.RegisterProductHandler(name: string, handler: ProductHandler)
	productHandlers[name] = handler
end

function MonetizationService.OwnsPass(player: Player, passKey: string): boolean
	local owned = ownedPasses[player]
	return owned ~= nil and owned[passKey] == true
end

-- Extra carry weight from passes. 0 while monetization is off.
function MonetizationService.GetInventoryBonus(player: Player): number
	local bonus = 0
	for key, pass in MonetizationConfig.GamePasses do
		if pass.inventoryBonus and MonetizationService.OwnsPass(player, key) then
			bonus += pass.inventoryBonus
		end
	end
	return bonus
end

local function loadPasses(player: Player)
	local owned = {}
	ownedPasses[player] = owned
	for key, pass in MonetizationConfig.GamePasses do
		if pass.id &gt; 0 then
			local ok, result = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.id)
			end)
			owned[key] = ok and result == true
		end
	end
end

local function processReceipt(receipt: { [string]: any }): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	for _, product in MonetizationConfig.DeveloperProducts do
		if product.id == receipt.ProductId then
			local handler = productHandlers[product.handler]
			if handler then
				local ok, granted = pcall(handler, player)
				if ok and granted then
					return Enum.ProductPurchaseDecision.PurchaseGranted
				end
			end
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function MonetizationService.Start()
	if not MonetizationConfig.Enabled then
		return
	end
	MarketplaceService.ProcessReceipt = processReceipt
	Players.PlayerAdded:Connect(loadPasses)
	for _, player in Players:GetPlayers() do
		task.spawn(loadPasses, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		ownedPasses[player] = nil
	end)
end

return MonetizationService
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="88">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source">--!strict
-- Creates every RemoteEvent on the server and gives services a small API around them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RemoteNames = require(ReplicatedStorage.Shared.RemoteNames)

local Net = {}

local folder: Folder? = nil
local remotes: { [string]: RemoteEvent } = {}

function Net.Init()
	local existing = ReplicatedStorage:FindFirstChild("Remotes")
	if existing then
		existing:Destroy()
	end
	local newFolder = Instance.new("Folder")
	newFolder.Name = "Remotes"
	for _, name in RemoteNames do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = newFolder
		remotes[name] = remote
	end
	newFolder.Parent = ReplicatedStorage
	folder = newFolder
end

function Net.Get(name: string): RemoteEvent
	local remote = remotes[name]
	assert(remote, "Unknown remote " .. name)
	return remote
end

export type NotifyKind = "info" | "success" | "warning" | "error"

-- message is a Locale key or { key, args... }; the client renders it in the player's language.
function Net.Notify(player: Player, message: any, kind: NotifyKind?)
	Net.Get(RemoteNames.Notify):FireClient(player, message, kind or "info")
end

function Net.IsReady(): boolean
	return folder ~= nil
end

return Net
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="89">
        <Properties>
          <string name="Name">PartyService</string>
          <string name="Source">--!strict
-- Party matches started from the lobby. A lobby lift reserves this server and stores the party in MemoryStore
-- under game.PrivateServerId. Here:
--   * the base starts from the leader's saved upgrades (members keep anything extra they had),
--   * anything a member builds is written into every member's save,
--   * inventory stays personal; the roof chest is shared (StorageService team stash);
--   * resource nodes stay personal (co-op loot duplication still TBD).
-- With no party record (Studio, a public server, a failed read) every player plays solo.

local MemoryStoreService = game:GetService("MemoryStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")

local Locale = require(ReplicatedStorage.Shared.Locale)
local PlacesConfig = require(ReplicatedStorage.Shared.PlacesConfig)
local RemoteNames = require(ReplicatedStorage.Shared.RemoteNames)
local BaseUpgradeService = require(script.Parent.BaseUpgradeService)
local Net = require(script.Parent.Net)
local PlayerDataService = require(script.Parent.PlayerDataService)
local RateLimiter = require(script.Parent.RateLimiter)
local StateSyncService = require(script.Parent.StateSyncService)

local PartyService = {}

type Party = { leaderUserId: number, members: { [number]: boolean } }
local party: Party? = nil

local function isMember(player: Player): boolean
	return party ~= nil and party.members[player.UserId] == true
end

local function leaderData()
	if not party then
		return nil
	end
	local leader = Players:GetPlayerByUserId(party.leaderUserId)
	return leader and PlayerDataService.Get(leader)
end

-- Adds the leader's built upgrades to a member's data. Never removes anything.
local function adoptLeaderBase(player: Player)
	local source = leaderData()
	local data = PlayerDataService.Get(player)
	if not source or not data or source == data then
		return
	end
	local changed = false
	for id, built in source.upgrades do
		if built and not data.upgrades[id] then
			data.upgrades[id] = true
			changed = true
		end
	end
	if changed then
		PlayerDataService.MarkDirty(player)
		StateSyncService.Request(player)
	end
end

local function applyToEveryone()
	if not party then
		return
	end
	for _, player in Players:GetPlayers() do
		if isMember(player) then
			adoptLeaderBase(player)
		end
	end
end

local function onDataLoaded(player: Player)
	if not isMember(player) then
		return
	end
	if party and player.UserId == party.leaderUserId then
		applyToEveryone()
	else
		adoptLeaderBase(player)
	end
	local leader = party and Players:GetPlayerByUserId(party.leaderUserId)
	if leader then
		Net.Notify(player, { "party.leader", leader.DisplayName }, "info")
	end
end

-- Something one member built goes into every member's save.
local function onPurchased(builder: Player, upgradeId: string)
	if not isMember(builder) then
		return
	end
	for _, player in Players:GetPlayers() do
		if player ~= builder and isMember(player) then
			local data = PlayerDataService.Get(player)
			if data and not data.upgrades[upgradeId] then
				data.upgrades[upgradeId] = true
				PlayerDataService.MarkDirty(player)
				StateSyncService.Request(player)
				task.spawn(PlayerDataService.Save, player)
			end
			Net.Notify(player, { "party.built", builder.DisplayName, Locale.Upgrade(upgradeId) }, "success")
		end
	end
end

local function readParty()
	if RunService:IsStudio() or game.PrivateServerId == "" or game.PrivateServerOwnerId ~= 0 then
		return
	end
	local map = MemoryStoreService:GetHashMap(PlacesConfig.PartyMapName)
	for attempt = 1, PlacesConfig.TeleportRetries do
		local ok, record = pcall(function()
			return map:GetAsync(game.PrivateServerId)
		end)
		if ok then
			if
				type(record) == "table"
				and type(record.leaderUserId) == "number"
				and type(record.partyUserIds) == "table"
			then
				local members = {}
				for _, userId in record.partyUserIds do
					if type(userId) == "number" then
						members[userId] = true
					end
				end
				members[record.leaderUserId] = true
				party = { leaderUserId = record.leaderUserId, members = members }
				applyToEveryone()
			end
			return
		end
		warn(("[Party] read attempt %d failed: %s"):format(attempt, tostring(record)))
		task.wait(attempt)
	end
end

local function returnToLobby(player: Player)
	if not RateLimiter.Allow(player, "ReturnToLobby", 3) then
		return
	end
	if PlacesConfig.LobbyPlaceId == 0 then
		Net.Notify(player, "lobby.notPublished", "warning")
		return
	end
	if RunService:IsStudio() then
		Net.Notify(player, "lobby.studio", "warning")
		return
	end
	-- Save first so nothing is lost on the way.
	PlayerDataService.Save(player)
	local ok, err = pcall(function()
		TeleportService:TeleportAsync(PlacesConfig.LobbyPlaceId, { player })
	end)
	if not ok then
		warn("[Party] return to lobby failed:", err)
		Net.Notify(player, "lobby.failed", "error")
	end
end

function PartyService.Start()
	PlayerDataService.OnLoaded(onDataLoaded)
	BaseUpgradeService.OnPurchased(onPurchased)
	Net.Get(RemoteNames.ReturnToLobby).OnServerEvent:Connect(returnToLobby)
	task.spawn(readParty)
end

return PartyService
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="90">
        <Properties>
          <string name="Name">PlayerDataService</string>
          <string name="Source">--!strict
-- Loads, validates and saves persistent player data.
-- A failed load never overwrites the saved record: saving is turned off for that session instead.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local ItemDefinitions = require(ReplicatedStorage.Shared.ItemDefinitions)
local UpgradeDefinitions = require(ReplicatedStorage.Shared.UpgradeDefinitions)
local Types = require(ReplicatedStorage.Shared.Types)

type PlayerData = Types.PlayerData
type ItemCounts = Types.ItemCounts

type Session = {
	data: PlayerData,
	canSave: boolean,
	dirty: boolean,
	dataVersion: number, -- version of the record this session last loaded or wrote
	saving: boolean,
}

local PlayerDataService = {}

local sessions: { [Player]: Session } = {}
local loadedListeners: { (player: Player) -&gt; () } = {}

-- Called after a player's data is ready (loaded, or defaults when loading failed).
function PlayerDataService.OnLoaded(listener: (player: Player) -&gt; ())
	table.insert(loadedListeners, listener)
end
local store: DataStore? = nil
local storeError: string? = nil

local function keyFor(player: Player): string
	return "Player_" .. tostring(player.UserId)
end

local function isCount(value: any): boolean
	return type(value) == "number" and value == value and value &gt;= 0 and value &lt; math.huge and value % 1 == 0
end

local function emptyCounts(): ItemCounts
	local counts: ItemCounts = {}
	for id in ItemDefinitions.Items do
		counts[id] = 0
	end
	return counts
end

function PlayerDataService.DefaultData(): PlayerData
	local inventory = emptyCounts()
	for id, def in ItemDefinitions.Items do
		inventory[id] = def.startAmount
	end
	local upgrades = {}
	for id in UpgradeDefinitions.Upgrades do
		upgrades[id] = false
	end
	return {
		schemaVersion = GameConfig.SchemaVersion,
		inventory = inventory,
		storage = emptyCounts(),
		upgrades = upgrades,
		flashlightCharge = 0,
		uniqueNodesTaken = {},
		towerCompleted = false,
		tutorialStep = 1,
		discoveredNotes = {},
		ownedPasses = {},
		processedReceipts = {},
	}
end

local function sanitizeCounts(raw: any, fallback: ItemCounts): ItemCounts
	local result = table.clone(fallback)
	if type(raw) ~= "table" then
		return result
	end
	for id in ItemDefinitions.Items do
		local value = raw[id]
		if isCount(value) then
			result[id] = value
		end
	end
	return result
end

local function sanitizeFlags(raw: any): { [string]: boolean }
	local result = {}
	if type(raw) == "table" then
		for key, value in raw do
			if type(key) == "string" and value == true then
				result[key] = true
			end
		end
	end
	return result
end

-- Turns an untrusted stored record into a valid PlayerData, filling gaps with defaults.
local function sanitize(raw: any): PlayerData
	local data = PlayerDataService.DefaultData()
	if type(raw) ~= "table" then
		return data
	end
	data.inventory = sanitizeCounts(raw.inventory, data.inventory)
	data.storage = sanitizeCounts(raw.storage, emptyCounts())
	if type(raw.upgrades) == "table" then
		for id in UpgradeDefinitions.Upgrades do
			data.upgrades[id] = raw.upgrades[id] == true
		end
	end
	if isCount(raw.tutorialStep) and raw.tutorialStep &gt;= 1 then
		data.tutorialStep = raw.tutorialStep
	end
	data.discoveredNotes = sanitizeFlags(raw.discoveredNotes)
	data.uniqueNodesTaken = sanitizeFlags(raw.uniqueNodesTaken)
	data.ownedPasses = sanitizeFlags(raw.ownedPasses)
	data.processedReceipts = sanitizeFlags(raw.processedReceipts)
	local charge = raw.flashlightCharge
	if type(charge) == "number" and charge == charge and charge &gt;= 0 then
		data.flashlightCharge = math.min(charge, GameConfig.FlashlightBatterySeconds)
	end
	data.towerCompleted = raw.towerCompleted == true
	if raw.language == "uk" or raw.language == "ru" or raw.language == "en" then
		data.language = raw.language
	end
	return data
end

local function serialize(data: PlayerData, version: number): { [string]: any }
	return {
		schemaVersion = GameConfig.SchemaVersion,
		dataVersion = version,
		inventory = table.clone(data.inventory),
		storage = table.clone(data.storage),
		upgrades = table.clone(data.upgrades),
		flashlightCharge = data.flashlightCharge,
		uniqueNodesTaken = table.clone(data.uniqueNodesTaken),
		towerCompleted = data.towerCompleted,
		language = data.language,
		tutorialStep = data.tutorialStep,
		discoveredNotes = table.clone(data.discoveredNotes),
		ownedPasses = table.clone(data.ownedPasses),
		processedReceipts = table.clone(data.processedReceipts),
		updatedAt = os.time(),
	}
end

function PlayerDataService.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(GameConfig.DataStoreName)
	end)
	if ok then
		store = result
	else
		storeError = tostring(result)
		warn("[PlayerData] DataStore unavailable, progress will not be saved:", storeError)
	end
end

-- Returns true when real saved data (or a confirmed new player) was loaded.
function PlayerDataService.Load(player: Player): boolean
	local session: Session = {
		data = PlayerDataService.DefaultData(),
		canSave = false,
		dirty = false,
		dataVersion = 0,
		saving = false,
	}

	if not GameConfig.PersistProgress then
		-- Session mode: every match starts from a clean slate and nothing is written back.
		sessions[player] = session
		for _, listener in loadedListeners do
			task.spawn(listener, player)
		end
		return true
	end

	if store then
		local activeStore = store :: DataStore
		for attempt = 1, GameConfig.DataRetryAttempts do
			local ok, result = pcall(function()
				return activeStore:GetAsync(keyFor(player))
			end)
			if ok then
				session.data = sanitize(result)
				if type(result) == "table" and isCount(result.dataVersion) then
					session.dataVersion = result.dataVersion
				end
				session.canSave = true
				break
			end
			warn(("[PlayerData] Load attempt %d failed for %s: %s"):format(attempt, player.Name, tostring(result)))
			local message = tostring(result)
			if message:find("StudioAccessToApisNotAllowed") or message:find("403") then
				-- Studio without API access: retrying will not help, so start right away without saving.
				warn("[PlayerData] Enable Game Settings &gt; Security &gt; Studio Access to API Services to test saving")
				break
			end
			if attempt &lt; GameConfig.DataRetryAttempts then
				task.wait(GameConfig.DataRetryDelaySeconds * attempt)
			end
		end
	end

	if player.Parent ~= Players then
		return false
	end
	sessions[player] = session
	for _, listener in loadedListeners do
		task.spawn(listener, player)
	end
	return session.canSave
end

function PlayerDataService.Get(player: Player): PlayerData?
	local session = sessions[player]
	return session and session.data
end

-- Fresh start for a new run in the same server (session mode).
function PlayerDataService.Reset(player: Player)
	local session = sessions[player]
	if session then
		session.data = PlayerDataService.DefaultData()
		session.dirty = true
	end
end

function PlayerDataService.CanSave(player: Player): boolean
	local session = sessions[player]
	return session ~= nil and session.canSave
end

function PlayerDataService.MarkDirty(player: Player)
	local session = sessions[player]
	if session then
		session.dirty = true
	end
end

function PlayerDataService.Save(player: Player): boolean
	local session = sessions[player]
	if not session or not session.canSave or not store then
		return false
	end
	if not session.dirty then
		return true
	end
	if session.saving then
		return false
	end
	session.saving = true
	session.dirty = false
	local activeStore = store :: DataStore

	local saved = false
	for attempt = 1, GameConfig.DataRetryAttempts do
		local conflict = false
		local newVersion = session.dataVersion
		local ok, err = pcall(function()
			activeStore:UpdateAsync(keyFor(player), function(old: any)
				conflict = false
				-- Another server wrote a newer record: never replace it with this older state.
				if type(old) == "table" and isCount(old.dataVersion) and old.dataVersion &gt; session.dataVersion then
					conflict = true
					return nil
				end
				newVersion = session.dataVersion + 1
				return serialize(session.data, newVersion)
			end)
		end)
		if ok then
			if conflict then
				warn(("[PlayerData] Newer record exists for %s, saving disabled for this session"):format(player.Name))
				session.canSave = false
			else
				session.dataVersion = newVersion
				saved = true
			end
			break
		end
		warn(("[PlayerData] Save attempt %d failed for %s: %s"):format(attempt, player.Name, tostring(err)))
		if attempt &lt; GameConfig.DataRetryAttempts then
			task.wait(GameConfig.DataRetryDelaySeconds * attempt)
		end
	end

	if not saved and session.canSave then
		session.dirty = true -- try again on the next autosave
	end
	session.saving = false
	return saved
end

function PlayerDataService.Release(player: Player)
	local session = sessions[player]
	if not session then
		return
	end
	-- Wait for an in-flight autosave so the final save is not skipped.
	local waited = 0
	while session.saving and waited &lt; 10 do
		waited += task.wait(0.1)
	end
	PlayerDataService.Save(player)
	sessions[player] = nil
end

function PlayerDataService.Start()
	task.spawn(function()
		while true do
			task.wait(GameConfig.AutosaveIntervalSeconds)
			for player in sessions do
				task.spawn(PlayerDataService.Save, player)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in sessions do
			pending += 1
			task.spawn(function()
				PlayerDataService.Release(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending &gt; 0 and os.clock() - started &lt; 25 do
			task.wait(0.1)
		end
	end)
end

function PlayerDataService.GetStoreError(): string?
	return storeError
end

return PlayerDataService
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="91">
        <Properties>
          <string name="Name">PlayerLifecycleService</string>
          <string name="Source">--!strict
-- Join, leave, spawn, death and the death backpack. Also handles item use (Medkit, Food).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local RemoteNames = require(ReplicatedStorage.Shared.RemoteNames)
local UpgradeDefinitions = require(ReplicatedStorage.Shared.UpgradeDefinitions)
local SfxService = require(script.Parent.SfxService)
local CharacterUtil = require(script.Parent.CharacterUtil)
local CombatService = require(script.Parent.CombatService)
local DamageService = require(script.Parent.DamageService)
local FlashlightService = require(script.Parent.FlashlightService)
local HazardService = require(script.Parent.HazardService)
local InventoryService = require(script.Parent.InventoryService)
local Net = require(script.Parent.Net)
local PlayerDataService = require(script.Parent.PlayerDataService)
local RateLimiter = require(script.Parent.RateLimiter)
local ResourceService = require(script.Parent.ResourceService)
local StateSyncService = require(script.Parent.StateSyncService)

local PlayerLifecycleService = {}

type Backpack = {
	part: BasePart,
	items: { [string]: number },
}

local backpacks: { [Player]: Backpack } = {}
local respawning: { [Player]: boolean } = {}
local interactablesFolder: Folder? = nil
local fallbackDropPosition = Vector3.new(0, GameConfig.World.RoofY + 2, 20)

function PlayerLifecycleService.SetWorld(interactables: Folder, roofDropPosition: Vector3)
	interactablesFolder = interactables
	fallbackDropPosition = roofDropPosition
end

local function destroyBackpack(player: Player)
	local backpack = backpacks[player]
	if backpack then
		backpacks[player] = nil
		backpack.part:Destroy()
		StateSyncService.Request(player)
	end
end

local function isInsideBuilding(position: Vector3): boolean
	local World = GameConfig.World
	local half = World.FloorSize / 2 - 1
	local lowest = World.RoofY - World.FloorCount * World.FloorSpacing - 2
	local onRoof = math.abs(position.X) &lt;= World.RoofSize / 2 and math.abs(position.Z) &lt;= World.RoofSize / 2
	if position.Y &gt;= World.RoofY - 1 then
		return onRoof
	end
	return math.abs(position.X) &lt;= half and math.abs(position.Z) &lt;= half and position.Y &gt;= lowest
end

local function dropBackpack(player: Player, position: Vector3)
	local data = PlayerDataService.Get(player)
	if not data or not interactablesFolder then
		return
	end
	local items: { [string]: number } = {}
	local any = false
	for id, amount in data.inventory do
		if amount &gt; 0 and not GameConfig.DeathProtectedItems[id] then
			items[id] = amount
			data.inventory[id] = 0
			any = true
		end
	end
	if not any then
		return
	end
	-- A new death replaces the old backpack; whatever was in it is gone.
	destroyBackpack(player)
	PlayerDataService.MarkDirty(player)

	local dropAt = if isInsideBuilding(position) then position else fallbackDropPosition
	local part = Instance.new("Part")
	part.Name = "Backpack_" .. tostring(player.UserId)
	part.Size = Vector3.new(2, 2, 1.4)
	part.Color = Color3.fromRGB(200, 120, 40)
	part.Material = Enum.Material.Fabric
	part.Anchored = true
	part.CanCollide = false
	part.Position = dropAt - Vector3.new(0, 1.5, 0)
	part:SetAttribute("InteractType", "Backpack")
	part:SetAttribute("OwnerUserId", player.UserId)

	local light = Instance.new("PointLight")
	light.Color = part.Color
	light.Range = 10
	light.Brightness = 2
	light.Parent = part

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Take backpack"
	prompt:SetAttribute("ActionKey", "backpack.action")
	prompt.ObjectText = "Your backpack"
	prompt:SetAttribute("ObjectKey", "backpack.object")
	prompt.MaxActivationDistance = GameConfig.PromptActivationDistance
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
	part.Parent = interactablesFolder

	local backpack = {
		part = part,
		items = items,
	}
	backpacks[player] = backpack
	task.delay(GameConfig.BackpackDropLifetimeSeconds, function()
		if backpacks[player] == backpack then
			destroyBackpack(player)
			if player.Parent then
				Net.Notify(player, "backpack.lost", "warning")
			end
		end
	end)
end

function PlayerLifecycleService.RecoverBackpack(player: Player, part: BasePart): (boolean, any)
	local backpack = backpacks[player]
	if not backpack or backpack.part ~= part then
		return false, "backpack.notYours"
	end
	backpacks[player] = nil
	for id, amount in backpack.items do
		InventoryService.ForceAdd(player, id, amount)
	end
	part:Destroy()
	StateSyncService.Request(player)
	Net.Notify(player, "backpack.recovered", "success")
	return true, nil
end

local function onDied(player: Player, character: Model)
	if respawning[player] then
		return
	end
	respawning[player] = true
	local root = character:FindFirstChild("HumanoidRootPart")
	local position = if root and root:IsA("BasePart") then root.Position else fallbackDropPosition
	dropBackpack(player, position)
	FlashlightService.SetOn(player, false)
	HazardService.StopTracking(player)
	StateSyncService.Request(player)
	Net.Notify(player, "death.message", "error")

	task.delay(GameConfig.RespawnDelaySeconds, function()
		respawning[player] = nil
		if player.Parent == Players then
			player:LoadCharacter()
		end
	end)
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid or not humanoid:IsA("Humanoid") then
		return
	end
	humanoid.MaxHealth = GameConfig.StartingHealth
	humanoid.Health = GameConfig.StartingHealth
	HazardService.ResetCharacter(player)
	DamageService.OnCharacterAdded(player)
	CombatService.OnCharacterAdded(player)
	ResourceService.OnReturnedToRoof(player)
	FlashlightService.OnCharacterAdded(player)
	humanoid.Died:Once(function()
		onDied(player, character)
	end)
	StateSyncService.Request(player)
end

local function onPlayerAdded(player: Player)
	local saved = PlayerDataService.Load(player)
	if player.Parent ~= Players then
		return
	end
	local data = PlayerDataService.Get(player)
	if data and data.language then
		player:SetAttribute("Language", data.language)
	end
	-- Language picked in the lobby travels with the teleport.
	local joinData = player:GetJoinData()
	local teleportData = joinData and joinData.TeleportData
	if type(teleportData) == "table" and type(teleportData.languages) == "table" then
		local code = teleportData.languages[tostring(player.UserId)]
		if code == "uk" or code == "ru" or code == "en" then
			player:SetAttribute("Language", code)
		end
	end
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	player:LoadCharacter()
	if not saved then
		task.delay(3, function()
			if player.Parent then
				Net.Notify(player, "save.failed", "error")
			end
		end)
	end
end

local function useItem(player: Player, itemId: any)
	if not RateLimiter.Allow(player, "UseItem", GameConfig.InteractionCooldown) then
		return
	end
	if DamageService.IsDowned(player) then
		return
	end
	if itemId == "Medkit" then
		local humanoid = CharacterUtil.GetHumanoid(player)
		if not humanoid then
			return
		end
		if humanoid.Health &gt;= humanoid.MaxHealth then
			Net.Notify(player, "medkit.full", "info")
			return
		end
		if not InventoryService.Remove(player, "Medkit", 1) then
			Net.Notify(player, "medkit.none", "warning")
			return
		end
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + GameConfig.MedkitHeal)
		SfxService.PlayAtPlayer("Bandage", player)
		Net.Notify(player, { "medkit.used", GameConfig.MedkitHeal }, "success")
	elseif itemId == "Food" then
		if not InventoryService.Has(player, "Food", 1) then
			Net.Notify(player, "food.none", "warning")
			return
		end
		if not HazardService.Feed(player) then
			Net.Notify(player, "food.notHungry", "info")
			return
		end
		InventoryService.Remove(player, "Food", 1)
		SfxService.PlayAtPlayer("Eat", player)
		Net.Notify(player, "food.eaten", "success")
	end
end

function PlayerLifecycleService.Init()
	-- Core part of the state snapshot.
	StateSyncService.RegisterProvider(function(player, snapshot)
		local data = PlayerDataService.Get(player)
		if not data then
			return
		end
		snapshot.inventory = table.clone(data.inventory)
		-- Team chest contents come from StorageService.Init provider (shared).
		snapshot.upgrades = table.clone(data.upgrades)
		snapshot.weight = InventoryService.WeightOf(data.inventory)
		snapshot.maxWeight = InventoryService.GetCapacity(player)
		snapshot.saveEnabled = PlayerDataService.CanSave(player)
		local costs = {}
		for id, def in UpgradeDefinitions.Upgrades do
			costs[id] = UpgradeDefinitions.GetCost(def)
		end
		snapshot.costs = costs
		local backpack = backpacks[player]
		snapshot.backpack = backpack and backpack.part.Position
	end)
end

function PlayerLifecycleService.Start()
	Players.CharacterAutoLoads = false

	Net.Get(RemoteNames.UseItem).OnServerEvent:Connect(useItem)
	Net.Get(RemoteNames.RequestState).OnServerEvent:Connect(function(player)
		if RateLimiter.Allow(player, "RequestState", 1) then
			StateSyncService.Request(player)
		end
	end)
	Net.Get(RemoteNames.SetLanguage).OnServerEvent:Connect(function(player, code)
		if not RateLimiter.Allow(player, "SetLanguage", 0.5) then
			return
		end
		if code ~= "uk" and code ~= "ru" and code ~= "en" then
			return
		end
		local data = PlayerDataService.Get(player)
		if data then
			data.language = code
			PlayerDataService.MarkDirty(player)
		end
		player:SetAttribute("Language", code)
	end)
	Net.Get(RemoteNames.ToggleFlashlight).OnServerEvent:Connect(function(player)
		if RateLimiter.Allow(player, "ToggleFlashlight", 0.3) then
			FlashlightService.Toggle(player)
		end
	end)

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		destroyBackpack(player)
		respawning[player] = nil
		PlayerDataService.Release(player)
	end)
end

return PlayerLifecycleService
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="92">
        <Properties>
          <string name="Name">RateLimiter</string>
          <string name="Source">--!strict
-- Per-player, per-action cooldowns that protect remotes and prompts from spam.

local Players = game:GetService("Players")

local RateLimiter = {}

local lastUse: { [Player]: { [string]: number } } = {}

-- Returns true and records the call when the action is allowed now.
function RateLimiter.Allow(player: Player, action: string, cooldown: number): boolean
	local now = os.clock()
	local perPlayer = lastUse[player]
	if not perPlayer then
		perPlayer = {}
		lastUse[player] = perPlayer
	end
	local last = perPlayer[action]
	if last and now - last &lt; cooldown then
		return false
	end
	perPlayer[action] = now
	return true
end

Players.PlayerRemoving:Connect(function(player)
	lastUse[player] = nil
end)

return RateLimiter
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="93">
        <Properties>
          <string name="Name">ResourceService</string>
          <string name="Source">--!strict
-- Resource nodes and rubble. Node state is kept per player, so co-op players never take each other's loot.
-- Resources are handed out only after every server check passes.
--
-- Node attributes:  NodeId, ItemId, Amount, Unique?, RequiresUpgrade?, RequiresRubble?
-- Rubble attributes: RubbleId, RequiresTool?, RewardItem?, RequiresUpgrade?

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Locale = require(ReplicatedStorage.Shared.Locale)
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local ItemDefinitions = require(ReplicatedStorage.Shared.ItemDefinitions)
local SfxService = require(script.Parent.SfxService)
local InventoryService = require(script.Parent.InventoryService)
local Net = require(script.Parent.Net)
local PlayerDataService = require(script.Parent.PlayerDataService)
local StateSyncService = require(script.Parent.StateSyncService)

local ResourceService = {}

type PlayerNodes = {
	depleted: { [string]: boolean }, -- normal nodes, refilled on roof return
	cleared: { [string]: boolean }, -- rubble, cleared for this session
}

local state: { [Player]: PlayerNodes } = {}

local function getState(player: Player): PlayerNodes
	local s = state[player]
	if not s then
		s = { depleted = {}, cleared = {} }
		state[player] = s
	end
	return s
end

-- Checks the access attributes a node or rubble may carry. Returns a reason when access is denied.
function ResourceService.CheckAccess(player: Player, object: Instance): any
	local data = PlayerDataService.Get(player)
	if not data then
		return "err.notLoaded"
	end
	local requiredUpgrade = object:GetAttribute("RequiresUpgrade")
	if type(requiredUpgrade) == "string" and not data.upgrades[requiredUpgrade] then
		return "res.zoneLocked"
	end
	local requiredRubble = object:GetAttribute("RequiresRubble")
	if type(requiredRubble) == "string" and not getState(player).cleared[requiredRubble] then
		-- Distinct from a generic blocked path so players know to clear the pile first.
		return "res.needRubble"
	end
	return nil
end

function ResourceService.IsTaken(player: Player, node: Instance): boolean
	local nodeId = node:GetAttribute("NodeId")
	if type(nodeId) ~= "string" then
		return true
	end
	if node:GetAttribute("Unique") == true then
		local data = PlayerDataService.Get(player)
		return data ~= nil and data.uniqueNodesTaken[nodeId] == true
	end
	return getState(player).depleted[nodeId] == true
end

function ResourceService.Collect(player: Player, node: BasePart): (boolean, any)
	local data = PlayerDataService.Get(player)
	local nodeId = node:GetAttribute("NodeId")
	local itemId = node:GetAttribute("ItemId")
	local amount = node:GetAttribute("Amount")
	if not data or type(nodeId) ~= "string" or not ItemDefinitions.IsValid(itemId) then
		return false, nil
	end
	if not InventoryService.IsPositiveInt(amount) then
		warn("[Resource] Misconfigured node", node:GetFullName())
		return false, nil
	end
	if ResourceService.IsTaken(player, node) then
		return false, "res.empty"
	end
	local denied = ResourceService.CheckAccess(player, node)
	if denied then
		return false, denied
	end
	local id = itemId :: string
	local count = amount :: number
	local unique = node:GetAttribute("Unique") == true
	if unique and InventoryService.GetCount(player, id) &gt; 0 then
		return false, "res.alreadyHave"
	end
	if not InventoryService.CanAdd(player, id, count) then
		return false, "res.full"
	end

	if unique then
		data.uniqueNodesTaken[nodeId] = true
		PlayerDataService.MarkDirty(player)
	else
		getState(player).depleted[nodeId] = true
	end
	InventoryService.Add(player, id, count)
	SfxService.Play("Pickup", node.Position, 0.8)
	StateSyncService.Request(player)
	Net.Notify(player, { "res.collected", Locale.Item(id), count }, "success")
	return true, nil
end

-- Server-authoritative open: collision + prompts so teammates can walk through (not client-only hide).
local function openRubblePart(rubble: BasePart)
	rubble.CanCollide = false
	rubble.Transparency = 1
	rubble:SetAttribute("ClearedShared", true)
	for _, d in rubble:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.Transparency = 1
		elseif d:IsA("ProximityPrompt") then
			d.Enabled = false
		elseif d:IsA("SurfaceGui") then
			d.Enabled = false
		end
	end
end

function ResourceService.ClearRubble(player: Player, rubble: BasePart): (boolean, any)
	local rubbleId = rubble:GetAttribute("RubbleId")
	if type(rubbleId) ~= "string" then
		return false, nil
	end
	local s = getState(player)
	if s.cleared[rubbleId] or rubble:GetAttribute("ClearedShared") == true then
		return false, nil
	end
	local denied = ResourceService.CheckAccess(player, rubble)
	if denied then
		return false, denied
	end
	local tool = rubble:GetAttribute("RequiresTool")
	if type(tool) == "string" and not InventoryService.Has(player, tool, 1) then
		return false, "rubble.needCrowbar"
	end

	-- Shared clear: one player opens the passage for the whole party.
	openRubblePart(rubble)
	for _, other in Players:GetPlayers() do
		getState(other).cleared[rubbleId] = true
	end
	SfxService.Play("Rubble", rubble.Position)
	local reward = rubble:GetAttribute("RewardItem")
	if ItemDefinitions.IsValid(reward) and InventoryService.GetCount(player, reward :: string) == 0 then
		-- The reward is a tool the player needs, so it ignores the weight limit.
		InventoryService.ForceAdd(player, reward :: string, 1)
		Net.Notify(player, { "rubble.found", Locale.Item(reward :: string) }, "success")
	else
		Net.Notify(player, "rubble.cleared", "success")
	end
	for _, other in Players:GetPlayers() do
		StateSyncService.Request(other)
	end
	return true, nil
end

-- Loot crates: rolled when opened, refilled on roof return like resource nodes.
-- Attributes: NodeId, Tier (Common/Rare/Gold/Diamond), RequiresUpgrade?, RequiresRubble?
local function rollLoot(player: Player, tier: string): { [string]: number }
	local loot: { [string]: number } = {}
	local tierTable = GameConfig.LootTables[tier]
	if not tierTable then
		return loot
	end
	for _, entry in tierTable do
		if not entry.chance or math.random() &lt; entry.chance then
			local def = ItemDefinitions.Get(entry.item)
			local amount = math.random(entry.min, entry.max)
			-- One of each weapon is enough; a duplicate turns into scrap.
			if def and def.weapon and InventoryService.GetCount(player, entry.item) &gt; 0 then
				loot.Scrap = (loot.Scrap or 0) + 2
			elseif def then
				loot[entry.item] = (loot[entry.item] or 0) + amount
			end
		end
	end
	return loot
end

function ResourceService.OpenCrate(player: Player, crate: BasePart): (boolean, any)
	local data = PlayerDataService.Get(player)
	local nodeId = crate:GetAttribute("NodeId")
	local tier = crate:GetAttribute("Tier")
	if not data or type(nodeId) ~= "string" or type(tier) ~= "string" then
		return false, nil
	end
	local s = getState(player)
	if s.depleted[nodeId] then
		return false, "loot.empty"
	end
	local denied = ResourceService.CheckAccess(player, crate)
	if denied then
		return false, denied
	end
	local loot = rollLoot(player, tier)
	if InventoryService.WeightOf(loot) &gt; InventoryService.GetCapacity(player) - InventoryService.GetWeight(player) then
		return false, "res.full"
	end
	s.depleted[nodeId] = true
	SfxService.Play("CrateOpen", crate.Position)
	for id, amount in loot do
		InventoryService.ForceAdd(player, id, amount)
	end
	StateSyncService.Request(player)
	Net.Notify(player, { "loot.found", Locale.Cost(loot) }, "success")
	return true, nil
end

-- Called when the player comes back up to the roof.
function ResourceService.OnReturnedToRoof(player: Player)
	if not GameConfig.ResetNodesOnRoofReturn then
		return
	end
	local s = getState(player)
	if next(s.depleted) then
		table.clear(s.depleted)
		StateSyncService.Request(player)
	end
end

function ResourceService.Init()
	StateSyncService.RegisterProvider(function(player, snapshot)
		local s = getState(player)
		local data = PlayerDataService.Get(player)
		snapshot.depletedNodes = table.clone(s.depleted)
		snapshot.clearedRubble = table.clone(s.cleared)
		snapshot.uniqueNodesTaken = if data then table.clone(data.uniqueNodesTaken) else {}
	end)
	Players.PlayerRemoving:Connect(function(player)
		state[player] = nil
	end)
end

return ResourceService
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="94">
        <Properties>
          <string name="Name">SfxService</string>
          <string name="Source">--!strict
-- One-shot 3D sound effects played by the server, so everyone nearby hears them.

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SoundConfig = require(ReplicatedStorage.Shared.SoundConfig)

local SfxService = {}

-- Plays `name` at a part (follows it) or at a world position.
function SfxService.Play(name: string, at: BasePart | Vector3, volume: number?)
	local list = SoundConfig.Sounds[name]
	if not list or #list == 0 then
		return
	end
	local holder: Instance
	if typeof(at) == "Vector3" then
		local attachment = Instance.new("Attachment")
		attachment.WorldPosition = at
		attachment.Parent = workspace.Terrain
		holder = attachment
		Debris:AddItem(attachment, 8)
	else
		holder = at
	end
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://" .. tostring(list[math.random(1, #list)])
	sound.Volume = (volume or 1) * SoundConfig.Volume
	sound.RollOffMaxDistance = SoundConfig.MaxDistance
	sound.RollOffMinDistance = 6
	sound.PlaybackSpeed = 1 + (math.random() - 0.5) * 0.12 -- a little variation so repeats do not sound robotic
	sound.Parent = holder
	sound:Play()
	Debris:AddItem(sound, 8)
end

-- Plays at the player's character, if they have one.
function SfxService.PlayAtPlayer(name: string, player: Player, volume: number?)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		SfxService.Play(name, root, volume)
	end
end

return SfxService
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="95">
        <Properties>
          <string name="Name">StateSyncService</string>
          <string name="Source">--!strict
-- Builds the per-player state snapshot and sends it to that player's client.
-- Requests made in the same frame are merged into one send.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RemoteNames = require(ReplicatedStorage.Shared.RemoteNames)
local Net = require(script.Parent.Net)

local StateSyncService = {}

type Provider = (player: Player, snapshot: { [string]: any }) -&gt; ()

local providers: { Provider } = {}
local pending: { [Player]: boolean } = {}

-- Services add their part of the snapshot through a provider. Called in registration order.
function StateSyncService.RegisterProvider(provider: Provider)
	table.insert(providers, provider)
end

function StateSyncService.Build(player: Player): { [string]: any }
	local snapshot = {}
	for _, provider in providers do
		provider(player, snapshot)
	end
	return snapshot
end

function StateSyncService.Request(player: Player)
	if pending[player] then
		return
	end
	pending[player] = true
	task.defer(function()
		pending[player] = nil
		if player.Parent then
			Net.Get(RemoteNames.StateChanged):FireClient(player, StateSyncService.Build(player))
		end
	end)
end

return StateSyncService
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="96">
        <Properties>
          <string name="Name">StorageService</string>
          <string name="Source">--!strict
-- Team chest: one shared stash for everyone on this tower server (party or solo session).
-- Transfers are checked and applied without yielding, so repeated requests cannot duplicate items.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local ItemDefinitions = require(ReplicatedStorage.Shared.ItemDefinitions)
local Locale = require(ReplicatedStorage.Shared.Locale)
local RemoteNames = require(ReplicatedStorage.Shared.RemoteNames)
local CharacterUtil = require(script.Parent.CharacterUtil)
local InventoryService = require(script.Parent.InventoryService)
local Net = require(script.Parent.Net)
local PlayerDataService = require(script.Parent.PlayerDataService)
local RateLimiter = require(script.Parent.RateLimiter)
local StateSyncService = require(script.Parent.StateSyncService)

local StorageService = {}

local storagePart: BasePart? = nil
-- Shared session chest (not per-player).
local teamStorage: { [string]: number } = {}
local lastDepositToastAt: { [Player]: number } = {}

function StorageService.SetStoragePart(part: BasePart)
	storagePart = part
end

function StorageService.GetTeamStorage(): { [string]: number }
	return teamStorage
end

function StorageService.GetWeight(_player: Player?): number
	return InventoryService.WeightOf(teamStorage)
end

function StorageService.Total(player: Player, itemId: string): number
	local data = PlayerDataService.Get(player)
	if not data then
		return teamStorage[itemId] or 0
	end
	return (data.inventory[itemId] or 0) + (teamStorage[itemId] or 0)
end

local function syncEveryone()
	for _, player in Players:GetPlayers() do
		StateSyncService.Request(player)
	end
end

local function isNearStorage(player: Player): boolean
	return storagePart ~= nil and CharacterUtil.IsNear(player, storagePart, GameConfig.InteractionDistance + 4)
end

-- direction: "Deposit" moves inventory -&gt; team chest, "Withdraw" moves team chest -&gt; inventory.
function StorageService.Transfer(player: Player, direction: any, itemId: any, amount: any): (boolean, any)
	local data = PlayerDataService.Get(player)
	if not data then
		return false, "err.notLoaded"
	end
	if direction ~= "Deposit" and direction ~= "Withdraw" then
		return false, "storage.invalid"
	end
	if not ItemDefinitions.IsValid(itemId) or not ItemDefinitions.Items[itemId].storable then
		return false, "storage.notStorable"
	end
	if not InventoryService.IsPositiveInt(amount) or amount &gt; 1000 then
		return false, "storage.badAmount"
	end
	if not data.upgrades.StorageCrate then
		return false, "storage.buildFirst"
	end
	if not isNearStorage(player) then
		return false, "storage.tooFar"
	end

	local def = ItemDefinitions.Items[itemId :: string]
	local id = itemId :: string
	local count = amount :: number

	if direction == "Deposit" then
		local have = data.inventory[id] or 0
		count = math.min(count, have)
		local free = GameConfig.StorageCapacity - StorageService.GetWeight(player)
		count = math.min(count, math.floor(free / def.weight))
		if count &lt;= 0 then
			return false, if have &lt;= 0 then "storage.nothing" else "storage.full"
		end
		data.inventory[id] = have - count
		teamStorage[id] = (teamStorage[id] or 0) + count
		-- Keep legacy personal mirror empty so old saves don't diverge mid-session.
		data.storage[id] = 0
		PlayerDataService.MarkDirty(player)
		syncEveryone()
		local now = os.clock()
		if (lastDepositToastAt[player] or 0) + 3 &lt;= now then
			lastDepositToastAt[player] = now
			for _, other in Players:GetPlayers() do
				if other ~= player then
					Net.Notify(other, { "party.stored", player.DisplayName, Locale.Cost({ [id] = count }) }, "info")
				end
			end
		end
	else
		local stored = teamStorage[id] or 0
		count = math.min(count, stored, InventoryService.SpaceFor(player, id))
		if count &lt;= 0 then
			return false, if stored &lt;= 0 then "storage.notInStorage" else "storage.invFull"
		end
		teamStorage[id] = stored - count
		if teamStorage[id] &lt;= 0 then
			teamStorage[id] = nil
		end
		data.inventory[id] = (data.inventory[id] or 0) + count
		PlayerDataService.MarkDirty(player)
		syncEveryone()
	end

	return true, nil
end

-- Takes cost from inventory first, then the team chest.
function StorageService.TrySpend(player: Player, cost: { [string]: number }): boolean
	local data = PlayerDataService.Get(player)
	if not data then
		return false
	end
	for id, amount in cost do
		if StorageService.Total(player, id) &lt; amount then
			return false
		end
	end
	for id, amount in cost do
		local fromInventory = math.min(amount, data.inventory[id] or 0)
		data.inventory[id] = (data.inventory[id] or 0) - fromInventory
		local fromChest = amount - fromInventory
		if fromChest &gt; 0 then
			teamStorage[id] = (teamStorage[id] or 0) - fromChest
			if (teamStorage[id] or 0) &lt;= 0 then
				teamStorage[id] = nil
			end
		end
	end
	PlayerDataService.MarkDirty(player)
	syncEveryone()
	return true
end

function StorageService.Init()
	StateSyncService.RegisterProvider(function(_player, snapshot)
		snapshot.storage = table.clone(teamStorage)
		snapshot.storageWeight = InventoryService.WeightOf(teamStorage)
		snapshot.storageCapacity = GameConfig.StorageCapacity
		snapshot.teamChest = true
	end)
end

function StorageService.Start()
	Net.Get(RemoteNames.StorageTransfer).OnServerEvent:Connect(function(player, direction, itemId, amount)
		if not RateLimiter.Allow(player, "StorageTransfer", 0.15) then
			return
		end
		local ok, reason = StorageService.Transfer(player, direction, itemId, amount)
		if not ok and reason then
			Net.Notify(player, reason, "warning")
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastDepositToastAt[player] = nil
	end)
end

return StorageService
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="97">
        <Properties>
          <string name="Name">TutorialService</string>
          <string name="Source">--!strict
-- Tutorial objectives, the emergency terminal note and the tower ending.
-- Each step checks the player's current state, so a step can never get stuck when the action was done earlier.

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PlacesConfig = require(ReplicatedStorage.Shared.PlacesConfig)
local RemoteNames = require(ReplicatedStorage.Shared.RemoteNames)
local Types = require(ReplicatedStorage.Shared.Types)
local UpgradeDefinitions = require(ReplicatedStorage.Shared.UpgradeDefinitions)
local HazardService = require(script.Parent.HazardService)
local Net = require(script.Parent.Net)
local PlayerDataService = require(script.Parent.PlayerDataService)
local StateSyncService = require(script.Parent.StateSyncService)
local StorageService = require(script.Parent.StorageService)

local TutorialService = {}

local TERMINAL_NOTE_ID = "Terminal01"

type Step = {
	text: string, -- Locale key
	-- Sticky steps depend on permanent progress, so reaching them lets the tutorial jump forward.
	sticky: boolean,
	complete: (player: Player, data: Types.PlayerData) -&gt; boolean,
}

local Steps: { Step } = {
	{
		text = "tutorial.1",
		sticky = false,
		complete = function(_, data)
			return data.discoveredNotes[TERMINAL_NOTE_ID] == true
		end,
	},
	{
		text = "tutorial.2",
		sticky = false,
		complete = function(player)
			return StorageService.Total(player, "Scrap") &gt;= 3
		end,
	},
	{
		text = "tutorial.3",
		sticky = false,
		complete = function(player)
			return not HazardService.IsOnExpedition(player)
		end,
	},
	{
		text = "tutorial.4",
		sticky = true,
		complete = function(_, data)
			return data.upgrades.StorageCrate
		end,
	},
	{
		text = "tutorial.5",
		sticky = false,
		complete = function(player)
			return StorageService.Total(player, "Electronics") &gt;= 4
		end,
	},
	{
		text = "tutorial.6",
		sticky = true,
		complete = function(_, data)
			return data.upgrades.Generator
		end,
	},
	{
		text = "tutorial.7",
		sticky = true,
		complete = function(_, data)
			return data.towerCompleted
		end,
	},
}

local function countActs(data: Types.PlayerData): number
	local acts = 0
	for id, def in UpgradeDefinitions.Upgrades do
		if def.act and data.upgrades[id] then
			acts += 1
		end
	end
	return acts
end

local function evaluate(player: Player, data: Types.PlayerData): number
	local step = math.clamp(data.tutorialStep, 1, #Steps + 1)
	for i = #Steps, 1, -1 do
		if Steps[i].sticky and Steps[i].complete(player, data) then
			step = math.max(step, i + 1)
			break
		end
	end
	while step &lt;= #Steps and Steps[step].complete(player, data) do
		step += 1
	end
	if step ~= data.tutorialStep then
		data.tutorialStep = step
		PlayerDataService.MarkDirty(player)
		if step &lt;= #Steps then
			Net.Notify(player, { "tutorial.new", { ref = Steps[step].text } }, "info")
		end
	end
	return step
end

function TutorialService.ReadTerminal(player: Player)
	local data = PlayerDataService.Get(player)
	if not data then
		return
	end
	if not data.discoveredNotes[TERMINAL_NOTE_ID] then
		data.discoveredNotes[TERMINAL_NOTE_ID] = true
		PlayerDataService.MarkDirty(player)
	end
	local acts = countActs(data)
	Net.Get(RemoteNames.ShowNote):FireClient(player, {
		kind = "note",
		title = "note.terminal.title",
		body = "note.terminal.body",
		footer = { "note.terminal.footer", acts },
	})
	StateSyncService.Request(player)
end

-- Lobby leaderboard: towers completed per player (one tower for now, so the value is 1).
local function recordCompletion(player: Player)
	local ok, err = pcall(function()
		local store = DataStoreService:GetOrderedDataStore(PlacesConfig.LeaderboardStoreName)
		store:UpdateAsync(tostring(player.UserId), function(old)
			return math.max(tonumber(old) or 0, 1)
		end)
	end)
	if not ok then
		warn("[Tutorial] leaderboard update failed:", err)
	end
end

-- Crossing the finished bridge onto the neighbour roof ends the tower.
local function onZoneChanged(player: Player, newZone: string)
	if newZone ~= "NeighborRoof" then
		return
	end
	local data = PlayerDataService.Get(player)
	if not data or not data.upgrades.Bridge then
		return
	end
	local firstTime = not data.towerCompleted
	data.towerCompleted = true
	PlayerDataService.MarkDirty(player)
	StateSyncService.Request(player)
	if firstTime then
		task.spawn(PlayerDataService.Save, player)
		task.spawn(recordCompletion, player)
	end
	Net.Get(RemoteNames.ShowNote):FireClient(player, {
		kind = "ending",
		title = "ending.title",
		body = "ending.body",
		footer = "ending.footer",
	})
end

function TutorialService.Init()
	StateSyncService.RegisterProvider(function(player, snapshot)
		local data = PlayerDataService.Get(player)
		if not data then
			return
		end
		local step = evaluate(player, data)
		snapshot.tutorial = {
			step = step,
			total = #Steps,
			text = if step &lt;= #Steps then Steps[step].text else "tutorial.done",
			done = step &gt; #Steps,
		}
		snapshot.acts = countActs(data)
		snapshot.towerCompleted = data.towerCompleted
	end)
end

function TutorialService.Start()
	HazardService.OnZoneChanged(onZoneChanged)
	HazardService.OnReturnedToRoof(function(player)
		StateSyncService.Request(player)
	end)
end

return TutorialService
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="98">
        <Properties>
          <string name="Name">ZombieService</string>
          <string name="Source">--!strict
-- Zombies roam the four floors below the roof (the roof itself is always safe).
-- Server-owned NPCs: they chase the nearest standing player on their floor, hit in melee through
-- DamageService and respawn some time after being killed.

local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local SfxService = require(script.Parent.SfxService)
local CharacterUtil = require(script.Parent.CharacterUtil)
local DamageService = require(script.Parent.DamageService)

local ZombieService = {}

local Z = GameConfig.Zombie
local World = GameConfig.World
local WALK_ANIM = "rbxassetid://507777826"
local IDLE_ANIM = "rbxassetid://507766666"
local TICK = 0.3

type Zombie = {
	model: Model,
	humanoid: Humanoid,
	root: BasePart,
	level: number,
	home: Vector3,
	lastAttack: number,
	lastPath: number,
	waypoints: { PathWaypoint },
	waypointIndex: number,
	wanderAt: number,
	walkTrack: AnimationTrack?,
	idleTrack: AnimationTrack?,
}

local zombies: { Zombie } = {}
local folder: Folder? = nil
local spawnPoints: { [number]: { Vector3 } } = {}
-- Once a floor's wave is wiped, no more respawns for the rest of this visit (design loops §3).
local floorCleared: { [number]: boolean } = {}
local floorAlive: { [number]: number } = {}

-- Open spots on each floor, away from the stairwell and rubble wings (scaled to 240 plate).
local function sp(x: number, z: number): Vector2
	local scale = World.FloorSize / (World.RefFloorSize or 70)
	return Vector2.new(x * scale, z * scale)
end

local SPAWNS: { [number]: { Vector2 } } = {
	[1] = {
		sp(0, 40),
		sp(-50, 25),
		sp(55, -10),
		sp(-15, -55),
		sp(70, 50),
		sp(-70, -40),
	},
	[2] = {
		sp(20, 55),
		sp(-60, -20),
		sp(65, 15),
		sp(-20, -60),
		sp(45, -45),
		sp(-55, 50),
		sp(0, 70),
	},
	[3] = {
		sp(-60, -15),
		sp(-40, 55),
		sp(50, -30),
		sp(55, 40),
		sp(20, 70),
		sp(-70, 30),
		sp(70, -55),
	},
	[4] = {
		sp(-70, 25),
		sp(35, -65),
		sp(65, 20),
		sp(-25, 65),
		sp(10, -70),
		sp(-55, -40),
		sp(50, 60),
		sp(0, 45),
	},
}

local function floorY(level: number): number
	return World.RoofY - level * World.FloorSpacing
end

local function zombieDescription(): HumanoidDescription
	local desc = Instance.new("HumanoidDescription")
	local skin = Color3.fromRGB(118, 138, 96):Lerp(Color3.fromRGB(150, 150, 120), math.random())
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.LeftLegColor = Color3.fromRGB(70, 60, 50)
	desc.RightLegColor = Color3.fromRGB(70, 60, 50)
	desc.TorsoColor = Color3.fromRGB(90, 80, 70):Lerp(Color3.fromRGB(60, 70, 80), math.random())
	return desc
end

local function playAnimations(z: Zombie)
	local animator = z.humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = z.humanoid
	end
	local function load(id: string): AnimationTrack?
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local ok, track = pcall(function()
			return (animator :: Animator):LoadAnimation(animation)
		end)
		return if ok then track else nil
	end
	z.walkTrack = load(WALK_ANIM)
	z.idleTrack = load(IDLE_ANIM)
	if z.idleTrack then
		z.idleTrack.Looped = true
		z.idleTrack:Play()
	end
	if z.walkTrack then
		z.walkTrack.Looped = true
	end
	z.humanoid.Running:Connect(function(speed)
		if not z.walkTrack then
			return
		end
		if speed &gt; 1 and not z.walkTrack.IsPlaying then
			z.walkTrack:Play(0.2, 1, 0.8) -- a slow, dragging walk
		elseif speed &lt;= 1 and z.walkTrack.IsPlaying then
			z.walkTrack:Stop(0.2)
		end
	end)
end

local spawnZombie: (level: number) -&gt; ()

spawnZombie = function(level: number)
	local points = spawnPoints[level]
	if not points or not folder then
		return
	end
	local home = points[math.random(1, #points)]
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(zombieDescription(), Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[Zombie] could not create a zombie:", model)
		return
	end
	model.Name = "Zombie"
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	humanoid.MaxHealth = Z.MaxHealth
	humanoid.Health = Z.MaxHealth
	humanoid.WalkSpeed = Z.WalkSpeed
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	humanoid.HealthDisplayDistance = 30
	humanoid.NameDisplayDistance = 0
	model:SetAttribute("Zombie", true)
	model:PivotTo(CFrame.new(home))
	model.Parent = folder
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d:SetNetworkOwner(nil)
		end
	end

	local z: Zombie = {
		model = model,
		humanoid = humanoid,
		root = root,
		level = level,
		home = home,
		lastAttack = 0,
		lastPath = 0,
		waypoints = {},
		waypointIndex = 0,
		wanderAt = 0,
	}
	table.insert(zombies, z)
	floorAlive[level] = (floorAlive[level] or 0) + 1
	playAnimations(z)

	humanoid.Died:Once(function()
		local index = table.find(zombies, z)
		if index then
			table.remove(zombies, index)
		end
		floorAlive[level] = math.max(0, (floorAlive[level] or 1) - 1)
		if (floorAlive[level] or 0) &lt;= 0 then
			floorCleared[level] = true
		end
		task.delay(3, function()
			model:Destroy()
		end)
		-- No timed respawn: initial PerFloor wave only. Cleared floors stay clear (design loops §3).
	end)
end

-- Nearest standing player on the same floor within aggro range.
local function findTarget(z: Zombie): (Player?, BasePart?)
	local best: Player? = nil
	local bestRoot: BasePart? = nil
	local bestDistance = Z.AggroRange
	local y = floorY(z.level)
	for _, player in Players:GetPlayers() do
		local root = CharacterUtil.GetRoot(player)
		if root and not DamageService.IsDowned(player) and math.abs(root.Position.Y - (y + 3)) &lt; 9 then
			local distance = (root.Position - z.root.Position).Magnitude
			if distance &lt; bestDistance then
				best, bestRoot, bestDistance = player, root, distance
			end
		end
	end
	return best, bestRoot
end

local function hasLineOfSight(z: Zombie, target: BasePart): boolean
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { z.model, target.Parent :: Instance }
	local from = z.root.Position
	return workspace:Raycast(from, target.Position - from, params) == nil
end

local function moveAlongPath(z: Zombie, goal: Vector3, now: number)
	if now - z.lastPath &gt; 1.5 or z.waypointIndex &gt; #z.waypoints then
		z.lastPath = now
		local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = false })
		local ok = pcall(function()
			path:ComputeAsync(z.root.Position, goal)
		end)
		if ok and path.Status == Enum.PathStatus.Success then
			z.waypoints = path:GetWaypoints()
			z.waypointIndex = 2
		else
			z.waypoints = {}
			z.waypointIndex = 0
		end
	end
	local waypoint = z.waypoints[z.waypointIndex]
	if waypoint then
		z.humanoid:MoveTo(waypoint.Position)
		if (waypoint.Position - z.root.Position).Magnitude &lt; 4 then
			z.waypointIndex += 1
		end
	else
		z.humanoid:MoveTo(goal)
	end
end

local function think(z: Zombie, now: number)
	if z.humanoid.Health &lt;= 0 then
		return
	end
	-- Never let a zombie leave its floor (and never onto the roof).
	if math.abs(z.root.Position.Y - (floorY(z.level) + 3)) &gt; 14 then
		z.model:PivotTo(CFrame.new(z.home))
		return
	end
	local target, targetRoot = findTarget(z)
	-- The occasional groan, more often while chasing someone.
	if math.random() &lt; (if target then 0.04 else 0.012) then
		SfxService.Play("ZombieGroan", z.root, 0.8)
	end
	if target and targetRoot then
		local distance = (targetRoot.Position - z.root.Position).Magnitude
		if distance &lt;= Z.AttackRange then
			z.humanoid:MoveTo(z.root.Position)
			if now - z.lastAttack &gt;= Z.AttackCooldown then
				z.lastAttack = now
				SfxService.Play("ZombieAttack", z.root, 0.9)
				DamageService.Damage(target, Z.Damage)
			end
		elseif hasLineOfSight(z, targetRoot) then
			z.humanoid:MoveTo(targetRoot.Position)
		else
			moveAlongPath(z, targetRoot.Position, now)
		end
		return
	end
	-- Nobody around: shuffle near home.
	if now &gt;= z.wanderAt then
		z.wanderAt = now + math.random(4, 9)
		local offset = Vector3.new(math.random(-12, 12), 0, math.random(-12, 12))
		z.humanoid:MoveTo(z.home + offset)
	end
end

function ZombieService.GetZombieAt(part: Instance): (Humanoid?, BasePart?)
	local model = part:FindFirstAncestorOfClass("Model")
	if model and model:GetAttribute("Zombie") then
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local root = model:FindFirstChild("HumanoidRootPart")
		if humanoid and root and root:IsA("BasePart") then
			return humanoid, root
		end
	end
	return nil, nil
end

-- Every living zombie: { humanoid, root }.
function ZombieService.All(): { Zombie }
	return zombies
end

function ZombieService.Start(root: Folder)
	local zombieFolder = Instance.new("Folder")
	zombieFolder.Name = "Zombies"
	zombieFolder.Parent = root
	folder = zombieFolder
	for level, points in SPAWNS do
		local list = {}
		for _, p in points do
			table.insert(list, Vector3.new(p.X, floorY(level) + 3, p.Y))
		end
		spawnPoints[level] = list
	end
	for level, count in Z.PerFloor do
		for _ = 1, count do
			task.spawn(spawnZombie, level)
		end
	end

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator &lt; TICK then
			return
		end
		accumulator = 0
		local now = os.clock()
		for _, z in table.clone(zombies) do
			task.spawn(think, z, now)
		end
	end)
end

return ZombieService
</string>
        </Properties>
      </Item>
    <Item class="ModuleScript" referent="new_DropService_83739160"><Properties><string name="Name">DropService</string><ProtectedString name="Source">--!strict
-- Intentional ground drops: party members can pick them up. Death backpacks stay personal.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local ItemDefinitions = require(ReplicatedStorage.Shared.ItemDefinitions)
local Locale = require(ReplicatedStorage.Shared.Locale)
local RemoteNames = require(ReplicatedStorage.Shared.RemoteNames)
local CharacterUtil = require(script.Parent.CharacterUtil)
local InventoryService = require(script.Parent.InventoryService)
local Net = require(script.Parent.Net)
local RateLimiter = require(script.Parent.RateLimiter)
local StateSyncService = require(script.Parent.StateSyncService)

local DropService = {}

local interactables: Folder? = nil
local nextId = 0

type GroundDrop = {
	part: BasePart,
	itemId: string,
	amount: number,
	ownerUserId: number,
}

local drops: { [BasePart]: GroundDrop } = {}

function DropService.SetInteractables(folder: Folder)
	interactables = folder
end

local function destroyDrop(part: BasePart)
	local entry = drops[part]
	if not entry then
		return
	end
	drops[part] = nil
	if part.Parent then
		part:Destroy()
	end
end

function DropService.Drop(player: Player, itemId: any, amount: any): (boolean, any)
	local dataFolder = interactables
	if not dataFolder then
		return false, nil
	end
	if type(itemId) ~= "string" or not ItemDefinitions.IsValid(itemId) then
		return false, "drop.badItem"
	end
	local def = ItemDefinitions.Items[itemId]
	-- Storable loot only (meds, scrap, electronics…). Tools/weapons stay equipped.
	if not def or not def.storable then
		return false, "drop.cantDrop"
	end
	local count = if type(amount) == "number" then amount else 1
	if not InventoryService.IsPositiveInt(count) or count &gt; 50 then
		return false, "drop.badAmount"
	end
	local root = CharacterUtil.GetRoot(player)
	if not root then
		return false, nil
	end
	if not InventoryService.Remove(player, itemId, count) then
		return false, "drop.none"
	end

	nextId += 1
	local part = Instance.new("Part")
	part.Name = "GroundDrop_" .. tostring(nextId)
	part.Size = Vector3.new(1.6, 0.8, 1.6)
	part.Color = Color3.fromRGB(90, 88, 82)
	part.Material = Enum.Material.Metal
	part.Anchored = true
	part.CanCollide = false
	part.Position = root.Position + root.CFrame.LookVector * 3 - Vector3.new(0, 2.2, 0)
	part:SetAttribute("InteractType", "GroundDrop")
	part:SetAttribute("ItemId", itemId)
	part:SetAttribute("Amount", count)
	part:SetAttribute("DropOwnerUserId", player.UserId)

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = Locale.T("en", "prompt.pickupDrop")
	prompt:SetAttribute("ActionKey", "prompt.pickupDrop")
	prompt.ObjectText = Locale.T("en", "item." .. itemId .. ".name")
	prompt:SetAttribute("ObjectKey", "item." .. itemId .. ".name")
	prompt.MaxActivationDistance = GameConfig.PromptActivationDistance
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
	part.Parent = dataFolder

	local entry: GroundDrop = {
		part = part,
		itemId = itemId,
		amount = count,
		ownerUserId = player.UserId,
	}
	drops[part] = entry

	local ttl = GameConfig.GroundDropLifetimeSeconds or 120
	task.delay(ttl, function()
		if drops[part] == entry then
			destroyDrop(part)
		end
	end)

	StateSyncService.Request(player)
	Net.Notify(player, { "drop.dropped", Locale.Item(itemId), count }, "info")
	return true, nil
end

function DropService.Pickup(player: Player, part: BasePart): (boolean, any)
	local entry = drops[part]
	if not entry or entry.part ~= part then
		return false, "drop.gone"
	end
	if not InventoryService.CanAdd(player, entry.itemId, entry.amount) then
		return false, "res.full"
	end
	drops[part] = nil
	InventoryService.Add(player, entry.itemId, entry.amount)
	part:Destroy()
	StateSyncService.Request(player)
	Net.Notify(player, { "drop.picked", Locale.Item(entry.itemId), entry.amount }, "success")
	return true, nil
end

function DropService.Start()
	Net.Get(RemoteNames.DropItem).OnServerEvent:Connect(function(player, itemId, amount)
		if not RateLimiter.Allow(player, "DropItem", 0.35) then
			return
		end
		local ok, reason = DropService.Drop(player, itemId, amount)
		if not ok and reason then
			Net.Notify(player, reason, "warning")
		end
	end)
	Players.PlayerRemoving:Connect(function(_player)
		-- Drops stay in the world for teammates; no owner cleanup.
	end)
end

return DropService
</ProtectedString><bool name="Disabled">false</bool></Properties></Item></Item>
    <Item class="ModuleScript" referent="99">
      <Properties>
        <string name="Name">WorldBuilder</string>
        <string name="Source">--!strict
-- Builds the grey-box prototype world from plain Parts into Workspace.GeneratedWorld.
-- Running it again reuses the existing folder instead of building a second copy.
--
-- Interactive parts live in GeneratedWorld.Interactables and carry an InteractType attribute.
-- Parts with UpgradeVisual = "&lt;UpgradeId&gt;" are shown ("Show") or hidden ("Hide") per player by the client.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Theme = require(ReplicatedStorage.Shared.Theme)
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Atmosphere = require(script.Parent.Atmosphere)
local PropLibrary = require(script.Parent.PropLibrary)
local Scenery = require(script.Parent.Scenery)

local World = GameConfig.World

export type WorldRefs = {
	root: Folder,
	interactables: Folder,
	storagePart: BasePart,
	generatorPart: BasePart,
	toxicZones: { BasePart },
	victoryZone: BasePart,
	workbench: BasePart,
	roofDropPosition: Vector3,
}

local WorldBuilder = {}

-- Layout authored at RefFloorSize (70); scale XZ positions to the locked 240 plate.
local REF = World.RefFloorSize or 70
local function S(n: number): number
	return n * (World.FloorSize / REF)
end

-- Stairwell footprint (hole in every slab except the bottom floor). Keep human-scale (not plate-scaled).
local HOLE_X = 9 -- half width of the stairwell; each lane is HOLE_X - 0.5 wide
local HOLE_MIN_Z = -15
local HOLE_MAX_Z = 15
local LANDING_Z = 9
local LANE_CENTER = (HOLE_X + 0.5) / 2
local LANE_WIDTH = HOLE_X - 0.5
local WALL_HEIGHT = World.FloorSpacing - World.SlabThickness

local COLORS = {
	concrete = Color3.fromRGB(120, 118, 115),
	darkConcrete = Color3.fromRGB(82, 80, 78),
	roof = Color3.fromRGB(96, 98, 100),
	metal = Color3.fromRGB(110, 115, 120),
	rust = Color3.fromRGB(130, 82, 52),
	rail = Color3.fromRGB(200, 170, 40),
	glass = Color3.fromRGB(150, 180, 190),
	rubble = Color3.fromRGB(105, 95, 85),
	toxic = Color3.fromRGB(110, 200, 60),
	wood = Color3.fromRGB(120, 90, 60),
	fabric = Color3.fromRGB(80, 90, 110),
	silhouette = Color3.fromRGB(45, 48, 55),
}

local function levelY(level: number): number
	return World.RoofY - level * World.FloorSpacing
end

local function block(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.Concrete
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- A part resting on the floor of the given level.
local function onFloor(
	parent: Instance,
	name: string,
	level: number,
	x: number,
	z: number,
	size: Vector3,
	color: Color3,
	material: Enum.Material?
): Part
	return block(parent, name, size, CFrame.new(x, levelY(level) + size.Y / 2, z), color, material)
end

-- Axis-aligned box between two corners on the floor of the given level.
local function wallBetween(
	parent: Instance,
	name: string,
	level: number,
	x1: number,
	z1: number,
	x2: number,
	z2: number,
	height: number,
	color: Color3?
): Part
	local thickness = 1
	local sx = math.max(math.abs(x2 - x1), thickness)
	local sz = math.max(math.abs(z2 - z1), thickness)
	return block(
		parent,
		name,
		Vector3.new(sx, height, sz),
		CFrame.new((x1 + x2) / 2, levelY(level) + height / 2, (z1 + z2) / 2),
		color or COLORS.concrete
	)
end

-- Text in the world is stored as a Locale key; each client relabels it in its own language.
-- An argument that starts with "@" is a key reference (e.g. "@upgrade.Bridge.name").
local function localized(key: string, arg: any?): string
	if type(arg) == "string" and string.sub(arg, 1, 1) == "@" then
		return Locale.T("en", key, { ref = string.sub(arg, 2) })
	end
	if arg ~= nil then
		return Locale.T("en", key, arg)
	end
	return Locale.T("en", key)
end

local function sign(parent: Instance, key: string, cframe: CFrame, size: Vector2, color: Color3?, arg: any?)
	local board =
		block(parent, "Sign", Vector3.new(size.X, size.Y, 0.3), cframe, Color3.fromRGB(30, 30, 30), Enum.Material.Metal)
	board.CanCollide = false
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.FontFace = Theme.Bold
	label.TextColor3 = color or Color3.fromRGB(255, 220, 80)
	label.Text = localized(key, arg)
	label:SetAttribute("TextKey", key)
	if arg ~= nil then
		label:SetAttribute("TextArg1", arg)
	end
	label.Parent = gui
end

local function addPrompt(
	part: BasePart,
	actionKey: string,
	objectKey: string,
	hold: number?,
	objectArg1: any?,
	objectArg2: any?
)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = Locale.T("en", actionKey)
	prompt:SetAttribute("ActionKey", actionKey)
	prompt:SetAttribute("ObjectKey", objectKey)
	prompt:SetAttribute("ObjectArg1", objectArg1)
	prompt:SetAttribute("ObjectArg2", objectArg2)
	local function arg(value: any): any
		if type(value) == "string" and string.sub(value, 1, 1) == "@" then
			return { ref = string.sub(value, 2) }
		end
		return value
	end
	if objectArg1 ~= nil then
		prompt.ObjectText = Locale.T("en", objectKey, arg(objectArg1), arg(objectArg2))
	else
		prompt.ObjectText = Locale.T("en", objectKey)
	end
	prompt.HoldDuration = hold or 0
	prompt.MaxActivationDistance = GameConfig.PromptActivationDistance
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Parent = part
	return prompt
end

local function pointLight(parent: BasePart, color: Color3, range: number, brightness: number, enabled: boolean)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Enabled = enabled
	light.Shadows = true
	light.Parent = parent
	return light
end

-- Slab with the stairwell hole cut out (built from four rectangles around it).
local function slab(parent: Instance, name: string, size: number, topY: number, withHole: boolean, color: Color3)
	local t = World.SlabThickness
	local y = topY - t / 2
	local half = size / 2
	if not withHole then
		block(parent, name, Vector3.new(size, t, size), CFrame.new(0, y, 0), color)
		return
	end
	block(parent, name .. "_W", Vector3.new(half - HOLE_X, t, size), CFrame.new(-(half + HOLE_X) / 2, y, 0), color)
	block(parent, name .. "_E", Vector3.new(half - HOLE_X, t, size), CFrame.new((half + HOLE_X) / 2, y, 0), color)
	block(
		parent,
		name .. "_S",
		Vector3.new(HOLE_X * 2, t, half + HOLE_MIN_Z),
		CFrame.new(0, y, (-half + HOLE_MIN_Z) / 2),
		color
	)
	block(
		parent,
		name .. "_N",
		Vector3.new(HOLE_X * 2, t, half - HOLE_MAX_Z),
		CFrame.new(0, y, (half + HOLE_MAX_Z) / 2),
		color
	)
end

-- A sloped walkway whose top surface runs exactly from a to b.
local function ramp(parent: Instance, name: string, a: Vector3, b: Vector3, width: number)
	local length = (b - a).Magnitude
	local frame = CFrame.lookAt((a + b) / 2, b) * CFrame.new(0, -0.5, 0)
	local part =
		block(parent, name, Vector3.new(width, 1, length + 0.6), frame, COLORS.metal, Enum.Material.DiamondPlate)
	return part
end

local function buildStairwell(parent: Folder)
	local stairs = Instance.new("Folder")
	stairs.Name = "Stairwell"
	stairs.Parent = parent

	local bottom = levelY(World.FloorCount)
	local top = World.RoofY
	local totalHeight = top - bottom

	-- Shaft walls on both sides and the far end, full height plus the roof hut.
	local hutHeight = 10
	local wallH = totalHeight + hutHeight
	local wallY = bottom + wallH / 2
	local wallLen = HOLE_MAX_Z - HOLE_MIN_Z + 1
	local wallZ = (HOLE_MIN_Z + HOLE_MAX_Z + 1) / 2
	block(
		stairs,
		"ShaftWall_W",
		Vector3.new(1, wallH, wallLen),
		CFrame.new(-HOLE_X - 0.5, wallY, wallZ),
		COLORS.darkConcrete
	)
	block(
		stairs,
		"ShaftWall_E",
		Vector3.new(1, wallH, wallLen),
		CFrame.new(HOLE_X + 0.5, wallY, wallZ),
		COLORS.darkConcrete
	)
	block(
		stairs,
		"ShaftWall_N",
		Vector3.new(HOLE_X * 2 + 2, wallH, 1),
		CFrame.new(0, wallY, HOLE_MAX_Z + 0.5),
		COLORS.darkConcrete
	)
	-- Divider between the down lane (west) and the up lane (east); doubles as a railing on the roof.
	local dividerH = totalHeight + 4
	block(
		stairs,
		"Divider",
		Vector3.new(1, dividerH, LANDING_Z - HOLE_MIN_Z),
		CFrame.new(0, bottom + dividerH / 2, (HOLE_MIN_Z + LANDING_Z) / 2),
		COLORS.darkConcrete
	)
	-- Roof hut cap and the railing in front of the open east lane on the roof.
	block(
		stairs,
		"HutRoof",
		Vector3.new(HOLE_X * 2 + 2, 1, wallLen + 2),
		CFrame.new(0, top + hutHeight + 0.5, wallZ - 1),
		COLORS.darkConcrete
	)
	block(
		stairs,
		"RoofLaneRail",
		Vector3.new(HOLE_X - 0.5, 4, 0.6),
		CFrame.new(LANE_CENTER, top + 2, HOLE_MIN_Z - 0.3),
		COLORS.rail,
		Enum.Material.Metal
	)

	for flight = 0, World.FloorCount - 1 do
		local upper = levelY(flight)
		local lower = levelY(flight + 1)
		local mid = upper - World.FloorSpacing / 2
		ramp(
			stairs,
			("Ramp%d_Down"):format(flight),
			Vector3.new(-LANE_CENTER, upper, HOLE_MIN_Z),
			Vector3.new(-LANE_CENTER, mid, LANDING_Z),
			LANE_WIDTH
		)
		block(
			stairs,
			("Landing%d"):format(flight),
			Vector3.new(HOLE_X * 2, 1, HOLE_MAX_Z - LANDING_Z),
			CFrame.new(0, mid - 0.5, (LANDING_Z + HOLE_MAX_Z) / 2),
			COLORS.metal,
			Enum.Material.DiamondPlate
		)
		ramp(
			stairs,
			("Ramp%d_Up"):format(flight),
			Vector3.new(LANE_CENTER, mid, LANDING_Z),
			Vector3.new(LANE_CENTER, lower, HOLE_MIN_Z),
			LANE_WIDTH
		)
		-- Floor number above each stairwell exit, so players always know where they are.
		local isBottom = flight + 1 == World.FloorCount
		sign(
			stairs,
			if isBottom then "sign.floor4" else "sign.floor",
			CFrame.new(0, lower + 13, HOLE_MIN_Z - 0.2),
			Vector2.new(10, 2),
			nil,
			if isBottom then nil else flight + 1
		)
	end
	sign(stairs, "sign.stairsDown", CFrame.new(-LANE_CENTER, top + 7, HOLE_MIN_Z - 0.2), Vector2.new(5.5, 1.5))
end

local function buildFloorShell(parent: Instance, level: number, lit: boolean)
	local floorY = levelY(level)
	local half = World.FloorSize / 2
	slab(parent, "Floor", World.FloorSize, floorY, level &lt; World.FloorCount, COLORS.concrete)

	-- Outer walls: solid band, a band of unbreakable glass, solid band.
	local bands = {
		{ from = 0, to = 4, glass = false },
		{ from = 4, to = 14, glass = true },
		{ from = 14, to = WALL_HEIGHT, glass = false },
	}
	for _, band in bands do
		local h = band.to - band.from
		local y = floorY + band.from + h / 2
		local color = if band.glass then COLORS.glass else COLORS.darkConcrete
		local material = if band.glass then Enum.Material.Glass else Enum.Material.Concrete
		for _, side in { -1, 1 } do
			local px = block(
				parent,
				"OuterWall",
				Vector3.new(1, h, World.FloorSize),
				CFrame.new(side * (half + 0.5), y, 0),
				color,
				material
			)
			local pz = block(
				parent,
				"OuterWall",
				Vector3.new(World.FloorSize + 2, h, 1),
				CFrame.new(0, y, side * (half + 0.5)),
				color,
				material
			)
			if band.glass then
				px.Transparency = 0.55
				pz.Transparency = 0.55
			end
		end
	end

	-- Nature got in through the broken windows: grass in the cracks and ivy hanging from the ceiling.
	local green = Random.new(level * 101)
	for _ = 1, 4 + level * 2 do
		local x = green:NextNumber(-half + 4, half - 4)
		local z = green:NextNumber(-half + 4, half - 4)
		if math.abs(x) &gt; HOLE_X + 3 or math.abs(z) &gt; HOLE_MAX_Z + 3 then
			Scenery.Grass(
				parent,
				Vector3.new(x, floorY, z),
				Vector2.new(green:NextNumber(3, 7), green:NextNumber(3, 7)),
				green
			)
		end
	end
	for _ = 1, 3 + level do
		local side = green:NextInteger(1, 4)
		local along = green:NextNumber(-half + 5, half - 5)
		local inner = half - 0.2
		local top = floorY + WALL_HEIGHT - 0.2
		local pos, normal
		if side == 1 then
			pos, normal = Vector3.new(along, top, -inner), Vector3.new(0, 0, 1)
		elseif side == 2 then
			pos, normal = Vector3.new(along, top, inner), Vector3.new(0, 0, -1)
		elseif side == 3 then
			pos, normal = Vector3.new(-inner, top, along), Vector3.new(1, 0, 0)
		else
			pos, normal = Vector3.new(inner, top, along), Vector3.new(-1, 0, 0)
		end
		Scenery.Vine(parent, pos, green:NextNumber(5, 14), normal, green)
	end

	if lit then
		for _, pos in { Vector2.new(-22, -22), Vector2.new(22, -22), Vector2.new(-22, 22), Vector2.new(22, 22) } do
			local lamp = block(
				parent,
				"CeilingLamp",
				Vector3.new(3, 0.4, 1),
				CFrame.new(pos.X, floorY + WALL_HEIGHT - 0.3, pos.Y),
				Color3.fromRGB(255, 200, 140),
				Enum.Material.Neon
			)
			lamp.CanCollide = false
			pointLight(lamp, Color3.fromRGB(255, 190, 130), 26, 0.8, true)
		end
	end
end

local function nodeLook(itemId: string): (Vector3, Color3, Enum.Material, Enum.PartType)
	if itemId == "Scrap" then
		return Vector3.new(2.4, 1.6, 2.4), COLORS.rust, Enum.Material.CorrodedMetal, Enum.PartType.Block
	elseif itemId == "Electronics" then
		return Vector3.new(1.8, 1.2, 1.8), Color3.fromRGB(40, 160, 90), Enum.Material.Neon, Enum.PartType.Block
	elseif itemId == "Food" then
		return Vector3.new(1.4, 1.4, 1.4),
			Color3.fromRGB(230, 140, 40),
			Enum.Material.SmoothPlastic,
			Enum.PartType.Cylinder
	elseif itemId == "Medkit" then
		return Vector3.new(1.8, 1.2, 1.4),
			Color3.fromRGB(235, 235, 235),
			Enum.Material.SmoothPlastic,
			Enum.PartType.Block
	elseif itemId == "Cable" then
		return Vector3.new(1.2, 2.4, 2.4), Color3.fromRGB(25, 25, 25), Enum.Material.Rubber, Enum.PartType.Cylinder
	elseif itemId == "Motor" then
		return Vector3.new(2.2, 2, 2.2), Color3.fromRGB(60, 70, 85), Enum.Material.Metal, Enum.PartType.Block
	elseif itemId == "Flashlight" then
		return Vector3.new(0.8, 0.8, 1.8),
			Color3.fromRGB(240, 200, 40),
			Enum.Material.SmoothPlastic,
			Enum.PartType.Block
	end
	return Vector3.new(1.5, 1.5, 1.5), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, Enum.PartType.Block
end

type NodeOptions = {
	unique: boolean?,
	requiresUpgrade: string?,
	requiresRubble: string?,
}

local CRATE_LOOKS: { [string]: { body: Color3, trim: Color3, glow: boolean } } = {
	Common = { body = Color3.fromRGB(116, 84, 56), trim = Color3.fromRGB(90, 90, 90), glow = false },
	Rare = { body = Color3.fromRGB(52, 78, 120), trim = Color3.fromRGB(110, 170, 255), glow = false },
	Gold = { body = Color3.fromRGB(110, 80, 40), trim = Color3.fromRGB(255, 196, 60), glow = true },
	Diamond = { body = Color3.fromRGB(40, 60, 70), trim = Color3.fromRGB(110, 240, 255), glow = true },
}

-- Loot crate; the higher the tier, the brighter the trim. Opened per player, refilled on roof return.
local function lootCrate(
	parent: Instance,
	level: number,
	nodeId: string,
	tier: string,
	pos: Vector2,
	options: { requiresUpgrade: string?, requiresRubble: string? }?
)
	local x, z = pos.X, pos.Y
	local look = CRATE_LOOKS[tier]
	local crate = onFloor(parent, nodeId, level, x, z, Vector3.new(3.4, 2.2, 2.4), look.body, Enum.Material.WoodPlanks)
	if tier ~= "Common" then
		crate.Material = Enum.Material.Metal
	end
	crate:SetAttribute("InteractType", "LootChest")
	crate:SetAttribute("NodeId", nodeId)
	crate:SetAttribute("Tier", tier)
	if options then
		if options.requiresUpgrade then
			crate:SetAttribute("RequiresUpgrade", options.requiresUpgrade)
		end
		if options.requiresRubble then
			crate:SetAttribute("RequiresRubble", options.requiresRubble)
		end
	end
	local lid = block(
		crate,
		"Lid",
		Vector3.new(3.6, 0.5, 2.6),
		crate.CFrame * CFrame.new(0, 1.35, 0),
		look.body,
		crate.Material
	)
	lid.CanCollide = false
	for _, offset in { -1.2, 1.2 } do
		local band = block(
			crate,
			"Trim",
			Vector3.new(0.3, 2.35, 2.5),
			crate.CFrame * CFrame.new(offset, 0, 0),
			look.trim,
			if look.glow then Enum.Material.Neon else Enum.Material.Metal
		)
		band.CanCollide = false
	end
	if look.glow then
		pointLight(crate, look.trim, 12, 1.2, true)
	end
	addPrompt(crate, "prompt.open", "loot." .. tier, 0.6)
	return crate
end

local function resourceNode(
	parent: Instance,
	level: number,
	nodeId: string,
	itemId: string,
	amount: number,
	pos: Vector2,
	options: NodeOptions?
)
	local x, z = pos.X, pos.Y
	local size, color, material, shape = nodeLook(itemId)
	local part = onFloor(parent, nodeId, level, x, z, size, color, material)
	part.Shape = shape
	if shape == Enum.PartType.Cylinder then
		-- Cylinders lie along X; stand cans up, keep cable coils on their side.
		local y = levelY(level) + (if itemId == "Food" then size.X / 2 else size.Y / 2)
		part.CFrame = if itemId == "Food"
			then CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.pi / 2)
			else CFrame.new(x, y, z)
	end
	part:SetAttribute("InteractType", "Resource")
	part:SetAttribute("NodeId", nodeId)
	part:SetAttribute("ItemId", itemId)
	part:SetAttribute("Amount", amount)
	if options then
		if options.unique then
			part:SetAttribute("Unique", true)
		end
		if options.requiresUpgrade then
			part:SetAttribute("RequiresUpgrade", options.requiresUpgrade)
		end
		if options.requiresRubble then
			part:SetAttribute("RequiresRubble", options.requiresRubble)
		end
	end
	addPrompt(part, "prompt.collect", "prompt.itemAmount", 0.3, "@item." .. itemId .. ".name", amount)
	return part
end

type RubbleOptions = {
	requiresTool: string?,
	rewardItem: string?,
	requiresUpgrade: string?,
}

-- facing: +1 when players approach from -X, -1 when they approach from +X.
local function rubble(
	parent: Instance,
	level: number,
	rubbleId: string,
	cframe: CFrame,
	size: Vector3,
	facing: number,
	options: RubbleOptions?
)
	local floorY = levelY(level)
	local main = block(
		parent,
		rubbleId,
		size,
		cframe + Vector3.new(0, floorY + size.Y / 2, 0),
		COLORS.rubble,
		Enum.Material.Slate
	)
	main:SetAttribute("InteractType", "Rubble")
	main:SetAttribute("RubbleId", rubbleId)
	local needsTool = options and options.requiresTool
	if options then
		if options.requiresTool then
			main:SetAttribute("RequiresTool", options.requiresTool)
		end
		if options.rewardItem then
			main:SetAttribute("RewardItem", options.rewardItem)
		end
		if options.requiresUpgrade then
			main:SetAttribute("RequiresUpgrade", options.requiresUpgrade)
		end
	end
	-- A few loose chunks so it reads as a pile. They are children, so hiding the rubble hides them too.
	local rng = Random.new(#rubbleId * 7919)
	for i = 1, 5 do
		local chunk = block(
			main,
			"Chunk" .. i,
			Vector3.new(rng:NextNumber(1.5, 3), rng:NextNumber(1, 2.5), rng:NextNumber(1.5, 3)),
			main.CFrame
				* CFrame.new(rng:NextNumber(-1, 1), rng:NextNumber(-size.Y / 2, size.Y / 3), rng:NextNumber(-2, 2))
				* CFrame.Angles(rng:NextNumber(0, 1), rng:NextNumber(0, 3), rng:NextNumber(0, 1)),
			COLORS.rubble:Lerp(COLORS.darkConcrete, rng:NextNumber()),
			Enum.Material.Slate
		)
		chunk.CanCollide = false
	end
	if needsTool then
		sign(
			main,
			"sign.crowbar",
			main.CFrame * CFrame.new(-facing * (size.X / 2 + 0.2), 2, 0) * CFrame.Angles(0, facing * math.pi / 2, 0),
			Vector2.new(3, 1)
		)
	end
	addPrompt(main, if needsTool then "prompt.clearCrowbar" else "prompt.clear", "prompt.rubble", 1.2)
	return main
end

-- A small room in a corner with a doorway on its inner X side, blocked by rubble.
-- Rubble is parented under interactables so InteractionService accepts the prompt
-- (walls stay on the floor folder for layout).
local function cornerRoom(
	parent: Instance,
	interactables: Folder,
	level: number,
	sx: number,
	sz: number,
	rubbleId: string,
	options: RubbleOptions?
)
	local half = World.FloorSize / 2
	local inner = S(55) -- wing room inset on the 240 plate (~2–3 rubble gates spacing)
	local x = sx * inner
	local zNear = sz * inner
	local zFar = sz * half
	-- Wall facing the centre along X, with a 6-stud doorway.
	local doorFrom = sz * (inner + S(5))
	local doorTo = sz * (inner + S(11))
	local rubbleZ = sz * (inner + S(8))
	wallBetween(parent, "RoomWall", level, x, zNear, x, doorFrom, WALL_HEIGHT)
	wallBetween(parent, "RoomWall", level, x, doorTo, x, zFar, WALL_HEIGHT)
	wallBetween(parent, "RoomWall", level, x, zNear, sx * half, zNear, WALL_HEIGHT)
	rubble(interactables, level, rubbleId, CFrame.new(x, 0, rubbleZ), Vector3.new(3, 10, 6.5), sx, options)
	-- Lintel over the doorway so the rubble is the only way in.
	block(
		parent,
		"Lintel",
		Vector3.new(1, WALL_HEIGHT - 10, 6),
		CFrame.new(x, levelY(level) + 10 + (WALL_HEIGHT - 10) / 2, rubbleZ),
		COLORS.concrete
	)
end

local function crate(parent: Instance, level: number, x: number, z: number, size: number?)
	local s = size or 4
	onFloor(parent, "Crate", level, x, z, Vector3.new(s, s, s), COLORS.wood, Enum.Material.WoodPlanks)
end

local function pipe(parent: Instance, level: number, x: number, z: number, length: number, alongX: boolean)
	local y = levelY(level) + WALL_HEIGHT - 2
	local part =
		block(parent, "Pipe", Vector3.new(length, 1.6, 1.6), CFrame.new(x, y, z), COLORS.metal, Enum.Material.Metal)
	part.Shape = Enum.PartType.Cylinder
	if not alongX then
		part.CFrame = part.CFrame * CFrame.Angles(0, math.pi / 2, 0)
	end
	part.CanCollide = false
end

-- Furniture and junk from the Blender prop pack, per floor: { prop, x, z, yaw, fit size }.
-- When a prop is not available a plain block of the same size stands in, so the layout never changes.
type Furnishing = { prop: string, x: number, z: number, yaw: number, fit: Vector3, high: boolean? }

local FIT: { [string]: Vector3 } = {
	Sofa = Vector3.new(7.4, 3.1, 3),
	Bed = Vector3.new(4.4, 2.9, 7.4),
	Mattress = Vector3.new(5.2, 1, 7.4),
	Fridge = Vector3.new(3, 6.5, 2.6),
	Counter = Vector3.new(8.2, 4.4, 2.6),
	Table = Vector3.new(5, 3.4, 3),
	Chair = Vector3.new(1.8, 3.6, 1.8),
	Desk = Vector3.new(5.4, 4.1, 2.6),
	Shelf = Vector3.new(5, 7, 1.8),
	Boiler = Vector3.new(4.8, 10.6, 4.6),
	Cabinet = Vector3.new(3, 9.9, 1.4),
	PipeWall = Vector3.new(12, 5.8, 1.2),
	VentDuct = Vector3.new(10.1, 4.9, 3),
	Barrel = Vector3.new(2.5, 3, 2.5),
	Boxes = Vector3.new(4.4, 3.4, 2.6),
	Locker = Vector3.new(2, 6.5, 1.8),
	RebarSlab = Vector3.new(11, 5, 8.5),
	CeilingPanel = Vector3.new(6, 2.5, 4),
}

local function f(prop: string, x: number, z: number, yaw: number?, high: boolean?): Furnishing
	return { prop = prop, x = x, z = z, yaw = yaw or 0, fit = FIT[prop], high = high }
end

local FURNISHING: { [number]: { Furnishing } } = {
	-- Technical floor: boilers, switchboards, pipes along the walls, storage shelves.
	[1] = {
		f("Boiler", -28, -28),
		f("Boiler", -28, 25, 30),
		f("Cabinet", -33.5, -6, 90),
		f("Cabinet", -33.5, 0, 90),
		f("Cabinet", -33.5, 6, 90),
		f("PipeWall", 0, 34, 180),
		f("PipeWall", 34, -28, -90),
		f("Shelf", 18, -34),
		f("Shelf", 30, -34),
		f("Barrel", 14, -26),
		f("Barrel", 16.8, -27.5),
		f("Barrel", 30, 12),
		f("Boxes", 8, 28, 15),
		f("Boxes", 30, -14, -20),
		f("CeilingPanel", -10, 24, 25, true),
	},
	-- Residential floor: looted flats with kitchens and bedrooms.
	[2] = {
		f("Bed", -28, 18),
		f("Bed", 28, -20, 180),
		f("Mattress", -24, -28, 20),
		f("Sofa", 12, 31, 180),
		f("Table", 12, 23),
		f("Chair", 8.5, 23, 90),
		f("Chair", 16, 21, -60),
		f("Counter", -32.5, -4, 90),
		f("Fridge", -32.5, -12, 90),
		f("Fridge", 31, 25, -90),
		f("Counter", 26, 33, 180),
		f("Locker", -14, 33, 180),
		f("Locker", 33.5, -3, -90),
		f("Shelf", -25, 33.5, 180),
		f("Boxes", -8, -31, 10),
		f("Chair", 22, 8, 160),
		f("CeilingPanel", 22, 2, -30, true),
	},
	-- Ventilation floor: big ducts on the floor, drums and shelving.
	[3] = {
		f("VentDuct", -24, -26),
		f("VentDuct", -24, 20, 90),
		f("VentDuct", 22, -20, 90),
		f("VentDuct", 22, 14),
		f("VentDuct", 0, 30),
		f("Barrel", -30, 29),
		f("Barrel", 28, 30),
		f("Barrel", -12, -31),
		f("Shelf", -33.5, 2, 90),
		f("Cabinet", 33.5, -6, -90),
	},
	-- Ruins: collapsed ceiling slabs with rebar, wrecked offices.
	[4] = {
		f("RebarSlab", -20, 6, 20),
		f("RebarSlab", 17, 6, -30),
		f("RebarSlab", 0, 27, 10),
		f("RebarSlab", -6, -29, 60),
		f("RebarSlab", 28, -6),
		f("Desk", -28, 24, 10),
		f("Desk", -31, -6, 80),
		f("Chair", -25, 21, 200),
		f("Cabinet", 31, -31, 10),
		f("Barrel", 14, -21),
		f("CeilingPanel", -18, -18, 15, true),
		f("CeilingPanel", 16, 18, -40, true),
		f("CeilingPanel", -8, 14, 70, true),
	},
}

local function furnish(floor: Folder, level: number)
	local floorY = levelY(level)
	for _, item in FURNISHING[level] or {} do
		-- Ceiling panels hang from the ceiling instead of standing on the floor.
		local y = if item.high then floorY + WALL_HEIGHT - item.fit.Y - 0.5 else floorY
		-- Prop packs were placed on the 70 plate; scale XZ out to FloorSize.
		local base = Vector3.new(S(item.x), y, S(item.z))
		local placed = PropLibrary.Place(floor, item.prop, base, item.fit, item.yaw, not item.high)
		if not placed and not item.high then
			local stand = block(
				floor,
				item.prop,
				item.fit,
				CFrame.new(base + Vector3.new(0, item.fit.Y / 2, 0)) * CFrame.Angles(0, math.rad(item.yaw), 0),
				COLORS.darkConcrete,
				Enum.Material.Concrete
			)
			stand.CastShadow = true
		end
	end

	-- Light falling in through the broken windows, puddles on the floor.
	local mood = Random.new(level * 977)
	local half = World.FloorSize / 2
	for _ = 1, 3 do
		local side = mood:NextInteger(1, 4)
		local along = mood:NextNumber(-half + 8, half - 8)
		local window: Vector3, inward: Vector3
		if side == 1 then
			window, inward = Vector3.new(along, floorY + 10, -half), Vector3.new(0, 0, 1)
		elseif side == 2 then
			window, inward = Vector3.new(along, floorY + 10, half), Vector3.new(0, 0, -1)
		elseif side == 3 then
			window, inward = Vector3.new(-half, floorY + 10, along), Vector3.new(1, 0, 0)
		else
			window, inward = Vector3.new(half, floorY + 10, along), Vector3.new(-1, 0, 0)
		end
		local landing = window + inward * 12 - Vector3.new(0, 10, 0)
		local beam = block(
			floor,
			"LightShaft",
			Vector3.new(5, 0.2, (landing - window).Magnitude),
			CFrame.lookAt((window + landing) / 2, landing),
			Color3.fromRGB(255, 236, 200),
			Enum.Material.Neon
		)
		beam.Transparency = 0.93
		beam.CanCollide = false
		beam.CastShadow = false
		beam.CanQuery = false
		local sun = Instance.new("SpotLight")
		sun.Face = Enum.NormalId.Front
		sun.Angle = 60
		sun.Range = 24
		sun.Brightness = 1.4
		sun.Color = Color3.fromRGB(255, 226, 180)
		sun.Parent = beam
	end
	for _ = 1, 3 do
		local x = mood:NextNumber(-half + 6, half - 6)
		local z = mood:NextNumber(-half + 6, half - 6)
		if math.abs(x) &gt; HOLE_X + 3 or math.abs(z) &gt; HOLE_MAX_Z + 3 then
			local puddle = block(
				floor,
				"Puddle",
				Vector3.new(mood:NextNumber(3, 7), 0.06, mood:NextNumber(2, 5)),
				CFrame.new(x, floorY + 0.03, z) * CFrame.Angles(0, mood:NextNumber(0, math.pi), 0),
				Color3.fromRGB(58, 66, 64),
				Enum.Material.Glass
			)
			puddle.Transparency = 0.25
			puddle.Reflectance = 0.25
			puddle.CanCollide = false
			puddle.CastShadow = false
		end
	end
end

-- Random but sensible spots for items on a floor, rolled anew every server so nobody can learn the map.
-- Zones: "open" (anywhere walkable outside locked rooms), "toxic"/"safe" (east/west halves on floor 3),
-- "roomPP"/"roomNN" (inside the +x+z / -x-z corner rooms behind rubble).
local function makePlacer(level: number, floor: Folder, rooms: { string }): (zone: string) -&gt; Vector2
	local rng = Random.new()
	local floorY = levelY(level)
	local edge = World.FloorSize / 2 - 4
	local taken: { Vector2 } = {}
	local boxes: { { center: Vector2, half: Vector2 } } = {}
	for _, d in floor:GetDescendants() do
		if d:IsA("BasePart") and d.CanCollide and d.Position.Y + d.Size.Y / 2 &gt; floorY + 0.5 then
			local cf, size = d.CFrame, d.Size
			local ex = math.abs(cf.RightVector.X) * size.X
				+ math.abs(cf.UpVector.X) * size.Y
				+ math.abs(cf.LookVector.X) * size.Z
			local ez = math.abs(cf.RightVector.Z) * size.X
				+ math.abs(cf.UpVector.Z) * size.Y
				+ math.abs(cf.LookVector.Z) * size.Z
			table.insert(
				boxes,
				{ center = Vector2.new(d.Position.X, d.Position.Z), half = Vector2.new(ex / 2, ez / 2) }
			)
		end
	end

	local roomGate = S(55)
	local roomOuter = S(100)

	local function inRoom(x: number, z: number, room: string): boolean
		local sx = if string.sub(room, 5, 5) == "P" then 1 else -1
		local sz = if string.sub(room, 6, 6) == "P" then 1 else -1
		return x * sx &gt;= roomGate and z * sz &gt;= roomGate
	end

	local function fits(x: number, z: number, zone: string): boolean
		-- Keep the stairwell and its doorway clear.
		if math.abs(x) &lt; HOLE_X + 3 and z &gt; HOLE_MIN_Z - 6 and z &lt; HOLE_MAX_Z + 3 then
			return false
		end
		if string.sub(zone, 1, 4) == "room" then
			if not inRoom(x, z, zone) or math.abs(x) &gt; roomOuter or math.abs(z) &gt; roomOuter then
				return false
			end
		else
			for _, room in rooms do
				if inRoom(x, z, room) then
					return false
				end
			end
			if zone == "toxic" and x &lt; HOLE_X + 5 then
				return false
			elseif zone == "safe" and x &gt; HOLE_X + 1 then
				return false
			end
		end
		for _, box in boxes do
			if math.abs(x - box.center.X) &lt; box.half.X + 2.5 and math.abs(z - box.center.Y) &lt; box.half.Y + 2.5 then
				return false
			end
		end
		for _, other in taken do
			if (other - Vector2.new(x, z)).Magnitude &lt; 8 then
				return false
			end
		end
		return true
	end

	return function(zone: string): Vector2
		for _ = 1, 600 do
			local x = rng:NextNumber(-edge, edge)
			local z = rng:NextNumber(-edge, edge)
			if fits(x, z, zone) then
				local spot = Vector2.new(x, z)
				table.insert(taken, spot)
				return spot
			end
		end
		-- Room-gated loot must stay inside the corner room. Falling back to the open floor
		-- left RequiresRubble nodes reachable with a false "завал" block message.
		if string.sub(zone, 1, 4) == "room" then
			local sx = if string.sub(zone, 5, 5) == "P" then 1 else -1
			local sz = if string.sub(zone, 6, 6) == "P" then 1 else -1
			local spot = Vector2.new(sx * (roomGate + S(8)), sz * (roomGate + S(8)))
			table.insert(taken, spot)
			warn(("[WorldBuilder] forced room spot for %s on floor %d"):format(zone, level))
			return spot
		end
		warn(("[WorldBuilder] no free spot for %s on floor %d"):format(zone, level))
		return Vector2.new(0, -S(30))
	end
end

local function buildFloor1(parent: Folder, interactables: Folder)
	local level = 1
	local floor = Instance.new("Folder")
	floor.Name = "Floor01_Technical"
	floor.Parent = parent
	buildFloorShell(floor, level, true)

	-- Corridors on the 240 plate: keep a clear tutorial scrap lane south of the stairs.
	wallBetween(floor, "Wall", level, -S(40), -S(90), -S(40), -S(20), WALL_HEIGHT)
	wallBetween(floor, "Wall", level, -S(40), S(20), -S(40), S(90), WALL_HEIGHT)
	wallBetween(floor, "Wall", level, S(30), -S(55), S(90), -S(55), 10)
	-- Rubble off the tutorial corridor (0 on the scrap path). Wing gate for crowbar + electronics.
	cornerRoom(floor, interactables, level, 1, 1, "F1_Rubble", { rewardItem = "Crowbar" })
	for _, p in { { -S(60), -S(20) }, { S(55), -S(70) }, { -S(75), S(25) }, { S(40), S(65) } } do
		crate(floor, level, p[1], p[2])
	end
	pipe(floor, level, 0, -S(50), S(120), true)
	pipe(floor, level, -S(70), 0, S(120), false)

	furnish(floor, level)
	local at = makePlacer(level, floor, { "roomPP" })
	-- Tutorial critical path: 3 scrap within ~80–100 studs of stairs (design loops).
	resourceNode(interactables, level, "F1_Scrap_1", "Scrap", 1, Vector2.new(18, -28))
	resourceNode(interactables, level, "F1_Scrap_2", "Scrap", 1, Vector2.new(28, -40))
	resourceNode(interactables, level, "F1_Scrap_3", "Scrap", 1, Vector2.new(22, -55))
	-- Optional density on the wider plate (soft-cap yield still ~4–7 collected).
	for i = 4, 18 do
		resourceNode(interactables, level, "F1_Scrap_" .. i, "Scrap", 1, at("open"))
	end
	resourceNode(interactables, level, "F1_Elec_1", "Electronics", 1, at("open"))
	resourceNode(interactables, level, "F1_Elec_2", "Electronics", 2, at("roomPP"), { requiresRubble = "F1_Rubble" })
	resourceNode(interactables, level, "F1_Elec_3", "Electronics", 1, at("roomPP"), { requiresRubble = "F1_Rubble" })
	lootCrate(interactables, level, "F1_Crate_1", "Common", at("open"))
	lootCrate(interactables, level, "F1_Crate_2", "Common", at("open"))
	resourceNode(interactables, level, "F1_Food_1", "Food", 1, at("open"))
end

local function buildFloor2(parent: Folder, interactables: Folder)
	local level = 2
	local floor = Instance.new("Folder")
	floor.Name = "Floor02_Residential"
	floor.Parent = parent
	buildFloorShell(floor, level, true)

	-- Apartment partitions with open doorways (scaled to 240 plate).
	wallBetween(floor, "Wall", level, -S(45), S(25), -S(45), S(65), WALL_HEIGHT)
	wallBetween(floor, "Wall", level, -S(90), S(25), -S(65), S(25), WALL_HEIGHT)
	wallBetween(floor, "Wall", level, S(45), -S(90), S(45), -S(60), WALL_HEIGHT)
	wallBetween(floor, "Wall", level, S(45), -S(35), S(45), -S(25), WALL_HEIGHT)
	wallBetween(floor, "Wall", level, S(65), -S(25), S(90), -S(25), WALL_HEIGHT)

	furnish(floor, level)
	local at = makePlacer(level, floor, {})
	resourceNode(interactables, level, "F2_Food_1", "Food", 1, at("open"))
	resourceNode(interactables, level, "F2_Food_2", "Food", 1, at("open"))
	resourceNode(interactables, level, "F2_Food_3", "Food", 1, at("open"))
	resourceNode(interactables, level, "F2_Food_4", "Food", 1, at("open"))
	resourceNode(interactables, level, "F2_Food_5", "Food", 1, at("open"))
	resourceNode(interactables, level, "F2_Medkit_1", "Medkit", 1, at("open"))
	resourceNode(interactables, level, "F2_Medkit_2", "Medkit", 1, at("open"))
	for i = 1, 20 do
		resourceNode(interactables, level, "F2_Scrap_" .. i, "Scrap", 1, at("open"))
	end
	resourceNode(interactables, level, "F2_Flashlight", "Flashlight", 1, at("open"), { unique = true })
	lootCrate(interactables, level, "F2_Crate_1", "Common", at("open"))
	lootCrate(interactables, level, "F2_Crate_2", "Common", at("open"))
	lootCrate(interactables, level, "F2_Crate_3", "Rare", at("open"))
end

local function buildFloor3(parent: Folder, interactables: Folder)
	local level = 3
	local floorY = levelY(level)
	local floor = Instance.new("Folder")
	floor.Name = "Floor03_Ventilation"
	floor.Parent = parent
	buildFloorShell(floor, level, false)

	-- Ventilation ducts on the ceiling and a few big fan boxes on the floor.
	pipe(floor, level, 20, -10, 30, false)
	pipe(floor, level, -20, 10, 30, false)
	for _, p in { { -26, -14 }, { 14, 12 }, { 26, -30 } } do
		onFloor(floor, "FanBox", level, p[1], p[2], Vector3.new(5, 4, 5), COLORS.metal, Enum.Material.Metal)
	end

	-- Toxic zone covers the east half; the stairwell and the west half stay safe for a retreat.
	local zoneMinX = HOLE_X + 3
	local half = World.FloorSize / 2
	local zoneSize = Vector3.new(half - zoneMinX, WALL_HEIGHT, World.FloorSize)
	local zone = block(
		floor,
		"ToxicZone",
		zoneSize,
		CFrame.new((zoneMinX + half) / 2, floorY + WALL_HEIGHT / 2, 0),
		COLORS.toxic,
		Enum.Material.SmoothPlastic
	)
	zone.Transparency = 0.88
	zone.CanCollide = false
	zone.CanQuery = false
	zone.CanTouch = false
	zone.CastShadow = false
	zone:SetAttribute("Hazard", "Toxic")
	local smoke = Instance.new("ParticleEmitter")
	smoke.Color = ColorSequence.new(COLORS.toxic)
	smoke.LightEmission = 0.3
	smoke.Size = NumberSequence.new(4, 8)
	smoke.Transparency = NumberSequence.new(0.6, 1)
	smoke.Rate = 12
	smoke.Lifetime = NumberRange.new(4, 6)
	smoke.Speed = NumberRange.new(0.5, 1.5)
	smoke.SpreadAngle = Vector2.new(180, 180)
	smoke.Parent = zone
	pointLight(zone, COLORS.toxic, 30, 0.4, true)
	-- Hazard stripes on the floor plus text signs, so danger is never shown by colour alone.
	local stripe = block(
		floor,
		"HazardStripe",
		Vector3.new(1, 0.1, World.FloorSize),
		CFrame.new(zoneMinX - 0.5, floorY + 0.05, 0),
		Color3.fromRGB(230, 200, 30),
		Enum.Material.SmoothPlastic
	)
	stripe.CanCollide = false
	for _, z in { -22, 0, 22 } do
		sign(
			floor,
			"sign.toxic",
			CFrame.new(zoneMinX - 0.4, floorY + 8, z) * CFrame.Angles(0, math.pi / 2, 0),
			Vector2.new(8, 2),
			Color3.fromRGB(140, 255, 90)
		)
	end

	furnish(floor, level)
	-- Items land somewhere new every match.
	local at = makePlacer(level, floor, {})
	resourceNode(interactables, level, "F3_Elec_1", "Electronics", 2, at("toxic"))
	resourceNode(interactables, level, "F3_Elec_2", "Electronics", 2, at("toxic"))
	resourceNode(interactables, level, "F3_Elec_3", "Electronics", 2, at("toxic"))
	resourceNode(interactables, level, "F3_Elec_4", "Electronics", 1, at("safe"))
	resourceNode(interactables, level, "F3_Elec_5", "Electronics", 1, at("safe"))
	resourceNode(interactables, level, "F3_Scrap_1", "Scrap", 2, at("safe"))
	resourceNode(interactables, level, "F3_Scrap_2", "Scrap", 2, at("safe"))
	resourceNode(interactables, level, "F3_Scrap_3", "Scrap", 1, at("safe"))
	lootCrate(interactables, level, "F3_Crate_1", "Rare", at("safe"))
	lootCrate(interactables, level, "F3_Crate_2", "Gold", at("toxic"))
	resourceNode(interactables, level, "F3_Food_1", "Food", 1, at("safe"))
end

local function buildFloor4(parent: Folder, interactables: Folder)
	local level = 4
	local floorY = levelY(level)
	local floor = Instance.new("Folder")
	floor.Name = "Floor04_Rubble"
	floor.Parent = parent
	buildFloorShell(floor, level, false)

	-- Locked door at the stairwell exit; opens per player once their Generator is built.
	local gate = block(
		interactables,
		"Floor04_Gate",
		Vector3.new(HOLE_X * 2 + 2, 12, 1),
		CFrame.new(0, floorY + 6, HOLE_MIN_Z - 1),
		Color3.fromRGB(70, 60, 50),
		Enum.Material.CorrodedMetal
	)
	gate:SetAttribute("InteractType", "Gate")
	gate:SetAttribute("RequiresUpgrade", "Generator")
	gate:SetAttribute("UpgradeVisual", "Generator")
	gate:SetAttribute("VisualMode", "Hide")
	addPrompt(gate, "prompt.open", "prompt.gate")
	sign(gate, "sign.gate", gate.CFrame * CFrame.new(0, 3, 0.7) * CFrame.Angles(0, math.pi, 0), Vector2.new(10, 1.5))

	cornerRoom(
		floor,
		interactables,
		level,
		-1,
		-1,
		"F4_Rubble_A",
		{ requiresTool = "Crowbar", requiresUpgrade = "Generator" }
	)
	cornerRoom(
		floor,
		interactables,
		level,
		1,
		1,
		"F4_Rubble_B",
		{ requiresTool = "Crowbar", requiresUpgrade = "Generator" }
	)
	-- Loose debris that players walk around.
	local rng = Random.new(404)
	for _ = 1, 10 do
		local x = rng:NextNumber(-30, 30)
		local z = rng:NextNumber(-30, 30)
		if math.abs(x) &gt; HOLE_X + 4 or math.abs(z) &gt; 20 then
			local s = rng:NextNumber(2, 4)
			local chunk =
				onFloor(floor, "Debris", level, x, z, Vector3.new(s, s * 0.6, s), COLORS.rubble, Enum.Material.Slate)
			chunk.CFrame = chunk.CFrame * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0.2)
		end
	end
	-- Collapsed beam hanging through the ceiling.
	block(
		floor,
		"FallenBeam",
		Vector3.new(2, 2, 26),
		CFrame.new(-14, floorY + 8, 0) * CFrame.Angles(0.5, 0.3, 0),
		COLORS.rust,
		Enum.Material.CorrodedMetal
	).CanCollide =
		false

	local gen = { requiresUpgrade = "Generator" }
	furnish(floor, level)
	-- Items land somewhere new every match.
	local at = makePlacer(level, floor, { "roomNN", "roomPP" })
	resourceNode(interactables, level, "F4_Cable_1", "Cable", 2, at("open"), gen)
	resourceNode(interactables, level, "F4_Cable_2", "Cable", 2, at("open"), gen)
	resourceNode(
		interactables,
		level,
		"F4_Motor_1",
		"Motor",
		1,
		at("roomNN"),
		{ requiresUpgrade = "Generator", requiresRubble = "F4_Rubble_A" }
	)
	resourceNode(
		interactables,
		level,
		"F4_Motor_2",
		"Motor",
		1,
		at("roomPP"),
		{ requiresUpgrade = "Generator", requiresRubble = "F4_Rubble_B" }
	)
	resourceNode(interactables, level, "F4_Scrap_1", "Scrap", 2, at("open"), gen)
	resourceNode(interactables, level, "F4_Scrap_2", "Scrap", 2, at("open"), gen)
	resourceNode(interactables, level, "F4_Scrap_3", "Scrap", 2, at("open"), gen)
	resourceNode(interactables, level, "F4_Scrap_4", "Scrap", 1, at("open"), gen)
	resourceNode(interactables, level, "F4_Elec_1", "Electronics", 2, at("open"), gen)
	resourceNode(interactables, level, "F4_Elec_2", "Electronics", 1, at("open"), gen)
	lootCrate(interactables, level, "F4_Crate_1", "Rare", at("open"), gen)
	lootCrate(interactables, level, "F4_Crate_2", "Gold", at("open"), gen)
	resourceNode(interactables, level, "F4_Food_1", "Food", 2, at("open"), gen)
	resourceNode(interactables, level, "F4_Food_2", "Food", 1, at("open"), gen)
	lootCrate(
		interactables,
		level,
		"F4_Crate_3",
		"Diamond",
		at("roomPP"),
		{ requiresUpgrade = "Generator", requiresRubble = "F4_Rubble_B" }
	)
end

-- Colour and material for Blender props, picked from the "&lt;Prop&gt;_&lt;Part&gt;_&lt;Paint&gt;" name suffix.
local PROP_PAINTS: { [string]: { color: Color3, material: Enum.Material } } = {
	Wood = { color = Color3.fromRGB(120, 80, 48), material = Enum.Material.WoodPlanks },
	Metal = { color = Color3.fromRGB(120, 124, 130), material = Enum.Material.Metal },
	Dark = { color = Color3.fromRGB(38, 40, 45), material = Enum.Material.Metal },
	Rust = { color = Color3.fromRGB(125, 65, 35), material = Enum.Material.CorrodedMetal },
	Yellow = { color = Color3.fromRGB(215, 160, 40), material = Enum.Material.Metal },
	Glow = { color = Color3.fromRGB(255, 150, 60), material = Enum.Material.Neon },
	Teal = { color = Color3.fromRGB(60, 130, 140), material = Enum.Material.Metal },
	Red = { color = Color3.fromRGB(180, 40, 35), material = Enum.Material.Metal },
}

-- Imported Blender models live in ReplicatedStorage.Models (see blender/README.md).
local function findPropModel(upgradeId: string): Instance?
	local models = ReplicatedStorage:FindFirstChild("Models")
	if not models then
		return nil
	end
	local found = models:FindFirstChild(upgradeId, true)
	if found and found:FindFirstChildWhichIsA("BasePart", true) then
		return found
	end
	return nil
end

-- Replaces the grey box with the Blender model when one has been imported.
-- The box stays as an invisible hitbox, so prompts and server checks do not change.
local function attachPropModel(visual: BasePart, upgradeId: string)
	local source = findPropModel(upgradeId)
	if not source then
		return
	end
	local model = Instance.new("Model")
	model.Name = upgradeId .. "_Model"
	for _, d in source:GetDescendants() do
		if d:IsA("BasePart") then
			local part = d:Clone()
			for _, child in part:GetChildren() do
				if not child:IsA("SpecialMesh") and not child:IsA("SurfaceAppearance") then
					child:Destroy()
				end
			end
			part.Anchored = true
			part.CanCollide = false
			part.CastShadow = true
			local paintName = string.match(d.Name, "_(%a+)$")
			local paint = paintName and PROP_PAINTS[paintName]
			if paint then
				part.Color = paint.color
				part.Material = paint.material
			end
			part:SetAttribute("UpgradeVisual", upgradeId)
			part:SetAttribute("VisualMode", "Show")
			part.Parent = model
		end
	end
	if not model:FindFirstChildWhichIsA("BasePart") then
		return
	end
	-- Fit the model into the hitbox footprint and stand it on the pad.
	local boxCFrame, boxSize = model:GetBoundingBox()
	local scale = math.min(visual.Size.X / boxSize.X, visual.Size.Y / boxSize.Y, visual.Size.Z / boxSize.Z)
	if scale &gt; 0 and scale &lt; math.huge then
		model.WorldPivot = boxCFrame
		model:ScaleTo(scale)
	end
	local _, fitted = model:GetBoundingBox()
	local bottom = visual.Position - Vector3.new(0, visual.Size.Y / 2, 0)
	model:PivotTo(CFrame.new(bottom + Vector3.new(0, fitted.Y / 2, 0)))
	model.Parent = visual
	visual.Transparency = 1
end

local function upgradePad(
	interactables: Folder,
	visuals: Folder,
	upgradeId: string,
	position: Vector3,
	visualSize: Vector3,
	visualColor: Color3
): (BasePart, BasePart)
	local pad = block(
		interactables,
		upgradeId .. "_Pad",
		Vector3.new(visualSize.X + 4, 0.4, visualSize.Z + 4),
		CFrame.new(position + Vector3.new(0, 0.2, 0)),
		Color3.fromRGB(60, 60, 64),
		Enum.Material.DiamondPlate
	)
	pad:SetAttribute("InteractType", "Upgrade")
	pad:SetAttribute("UpgradeId", upgradeId)
	addPrompt(pad, "prompt.build", "upgrade." .. upgradeId .. ".name", 0.5)

	local visual = block(
		visuals,
		upgradeId,
		visualSize,
		CFrame.new(position + Vector3.new(0, 0.4 + visualSize.Y / 2, 0)),
		visualColor,
		Enum.Material.Metal
	)
	visual:SetAttribute("UpgradeVisual", upgradeId)
	visual:SetAttribute("VisualMode", "Show")
	attachPropModel(visual, upgradeId)
	sign(
		visuals,
		"upgrade." .. upgradeId .. ".name",
		CFrame.new(position + Vector3.new(0, 0.4 + visualSize.Y + 1.5, 0)),
		Vector2.new(6, 1.2)
	)
	return pad, visual
end

local function buildRoof(parent: Folder, interactables: Folder)
	local roofY = World.RoofY
	local half = World.RoofSize / 2
	local roof = Instance.new("Folder")
	roof.Name = "RoofBase"
	roof.Parent = parent
	local visuals = Instance.new("Folder")
	visuals.Name = "UpgradeVisuals"
	visuals.Parent = roof

	slab(roof, "Roof", World.RoofSize, roofY, true, COLORS.roof)
	-- Railings on every edge, with a gap on the east side where the bridge starts.
	local railH = 4
	local gap = 5
	for _, side in { -1, 1 } do
		block(
			roof,
			"Railing",
			Vector3.new(World.RoofSize + 1, railH, 0.6),
			CFrame.new(0, roofY + railH / 2, side * half),
			COLORS.rail,
			Enum.Material.Metal
		)
	end
	block(
		roof,
		"Railing",
		Vector3.new(0.6, railH, World.RoofSize),
		CFrame.new(-half, roofY + railH / 2, 0),
		COLORS.rail,
		Enum.Material.Metal
	)
	local eastLen = half - gap
	for _, side in { -1, 1 } do
		block(
			roof,
			"Railing",
			Vector3.new(0.6, railH, eastLen),
			CFrame.new(half, roofY + railH / 2, side * (gap + eastLen / 2)),
			COLORS.rail,
			Enum.Material.Metal
		)
	end
	local barrier = block(
		visuals,
		"BridgeBarrier",
		Vector3.new(0.8, railH, gap * 2),
		CFrame.new(half, roofY + railH / 2, 0),
		Color3.fromRGB(200, 60, 40),
		Enum.Material.Metal
	)
	barrier:SetAttribute("UpgradeVisual", "Bridge")
	barrier:SetAttribute("VisualMode", "Hide")
	sign(
		visuals,
		"sign.bridgeBroken",
		CFrame.new(half - 0.5, roofY + railH + 1, 0) * CFrame.Angles(0, math.pi / 2, 0),
		Vector2.new(8, 1.5)
	)

	-- Spawn point and terminal.
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "RoofSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(8, 1, 8)
	spawn.CFrame = CFrame.new(0, roofY + 0.5, -38)
	spawn.Color = Color3.fromRGB(70, 110, 160)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = roof

	-- Workbench for bandages and weapons.
	local bench = block(
		interactables,
		"Workbench",
		Vector3.new(6, 3, 3),
		CFrame.new(-26, roofY + 1.5, 14),
		COLORS.wood,
		Enum.Material.WoodPlanks
	)
	bench:SetAttribute("InteractType", "Workbench")
	block(
		bench,
		"Vice",
		Vector3.new(1, 1, 1.2),
		bench.CFrame * CFrame.new(2.2, 2, 0),
		COLORS.metal,
		Enum.Material.Metal
	).CanCollide =
		false
	block(
		bench,
		"Tools",
		Vector3.new(3, 0.3, 1.5),
		bench.CFrame * CFrame.new(-0.8, 1.65, 0.2),
		COLORS.rust,
		Enum.Material.CorrodedMetal
	).CanCollide =
		false
	sign(bench, "craft.title", bench.CFrame * CFrame.new(0, 3.2, -1.6), Vector2.new(5, 1.2))
	addPrompt(bench, "prompt.craft", "prompt.workbench")

	local terminal = block(
		interactables,
		"EmergencyTerminal",
		Vector3.new(3, 5, 1.5),
		CFrame.new(-10, roofY + 2.5, -30),
		Color3.fromRGB(50, 55, 60),
		Enum.Material.Metal
	)
	terminal:SetAttribute("InteractType", "Terminal")
	addPrompt(terminal, "prompt.read", "prompt.terminal")
	local screen = block(
		terminal,
		"Screen",
		Vector3.new(2.4, 1.6, 0.1),
		terminal.CFrame * CFrame.new(0, 1, -0.8),
		Color3.fromRGB(80, 220, 120),
		Enum.Material.Neon
	)
	screen.CanCollide = false
	pointLight(screen, Color3.fromRGB(80, 220, 120), 8, 1, true)

	-- Upgrade spots. The storage crate is also the storage interaction once built.
	local _, storageVisual = upgradePad(
		interactables,
		visuals,
		"StorageCrate",
		Vector3.new(-32, roofY, -15),
		Vector3.new(6, 4, 4),
		COLORS.wood
	)
	storageVisual.Parent = interactables
	storageVisual.Name = "StorageCrate"
	storageVisual:SetAttribute("InteractType", "Storage")
	addPrompt(storageVisual, "prompt.open", "sign.teamChest")
	sign(
		storageVisual,
		"sign.teamChest",
		storageVisual.CFrame * CFrame.new(0, 4, 0) * CFrame.Angles(0, math.pi, 0),
		Vector2.new(10, 1.6)
	)
	upgradePad(
		interactables,
		visuals,
		"Generator",
		Vector3.new(32, roofY, -24),
		Vector3.new(6, 5, 4),
		Color3.fromRGB(180, 140, 40)
	)
	upgradePad(
		interactables,
		visuals,
		"AirFilter",
		Vector3.new(32, roofY, 18),
		Vector3.new(4, 7, 4),
		Color3.fromRGB(90, 130, 150)
	)
	upgradePad(
		interactables,
		visuals,
		"Bridge",
		Vector3.new(42, roofY, -12),
		Vector3.new(3, 3, 3),
		Color3.fromRGB(150, 150, 160)
	)

	-- Base lights: off until the player's Generator runs.
	for _, p in
		{
			Vector2.new(-40, -40),
			Vector2.new(40, -40),
			Vector2.new(-40, 40),
			Vector2.new(40, 40),
			Vector2.new(-20, 0),
			Vector2.new(20, 0),
		}
	do
		block(
			roof,
			"LampPost",
			Vector3.new(0.6, 9, 0.6),
			CFrame.new(p.X, roofY + 4.5, p.Y),
			COLORS.metal,
			Enum.Material.Metal
		)
		local bulb = block(
			roof,
			"LampBulb",
			Vector3.new(1.4, 1, 1.4),
			CFrame.new(p.X, roofY + 9.4, p.Y),
			Color3.fromRGB(90, 90, 80),
			Enum.Material.Glass
		)
		bulb.CanCollide = false
		bulb:SetAttribute("UpgradeLight", "Generator")
		pointLight(bulb, Color3.fromRGB(255, 220, 160), 34, 1.6, false)
	end

	-- Roof clutter that does not block walkways.
	local tank = block(
		roof,
		"WaterTank",
		Vector3.new(9, 10, 10),
		CFrame.new(-38, roofY + 4.5, 30) * CFrame.Angles(0, 0, math.pi / 2),
		COLORS.rust,
		Enum.Material.CorrodedMetal
	)
	tank.Shape = Enum.PartType.Cylinder
	for _, p in { { -20, 38 }, { 0, 40 }, { 20, 36 } } do
		onFloor(roof, "Vent", 0, p[1], p[2], Vector3.new(4, 3, 4), COLORS.metal, Enum.Material.Metal)
	end
	onFloor(roof, "Antenna", 0, 30, 44, Vector3.new(0.8, 25, 0.8), COLORS.metal, Enum.Material.Metal)

	-- Survivors' rooftop garden and plants creeping over the edges.
	local green = Random.new(396)
	for _, p in { { -42, -6 }, { -42, 12 }, { 10, 44 }, { -28, 42 } } do
		onFloor(roof, "Planter", 0, p[1], p[2], Vector3.new(6, 1.6, 6), COLORS.wood, Enum.Material.WoodPlanks)
		Scenery.Bush(roof, Vector3.new(p[1], roofY + 1.6, p[2]), 3.5, green)
	end
	Scenery.Tree(roof, Vector3.new(-44, roofY, -44), 16, green)
	Scenery.Tree(roof, Vector3.new(44, roofY, 44), 14, green)
	for _ = 1, 14 do
		local x = green:NextNumber(-46, 46)
		local z = green:NextNumber(-46, 46)
		-- Keep walkways, the stairwell and the build spots clear.
		if math.abs(x) &gt; 12 and math.abs(z + 38) &gt; 8 then
			Scenery.Grass(
				roof,
				Vector3.new(x, roofY, z),
				Vector2.new(green:NextNumber(4, 9), green:NextNumber(4, 9)),
				green
			)
		end
	end
	for _ = 1, 10 do
		local side = green:NextInteger(1, 4)
		local along = green:NextNumber(-45, 45)
		local edge = World.RoofSize / 2 + 0.4
		local pos, normal
		if side == 1 then
			pos, normal = Vector3.new(along, roofY, -edge), Vector3.new(0, 0, -1)
		elseif side == 2 then
			pos, normal = Vector3.new(along, roofY, edge), Vector3.new(0, 0, 1)
		elseif side == 3 then
			pos, normal = Vector3.new(-edge, roofY, along), Vector3.new(-1, 0, 0)
		else
			pos, normal = Vector3.new(edge, roofY, along), Vector3.new(1, 0, 0)
		end
		Scenery.Vine(roof, pos, green:NextNumber(8, 30), normal, green)
	end
end

local function buildNeighbor(parent: Folder)
	local roofY = World.RoofY
	local neighbor = Instance.new("Folder")
	neighbor.Name = "NeighborTower"
	neighbor.Parent = parent
	local cx = World.NeighborOffsetX
	local size = 60
	local bodyHeight = roofY - 20
	local bodyBottom = roofY - World.SlabThickness - bodyHeight
	block(
		neighbor,
		"TowerBody",
		Vector3.new(size, bodyHeight, size),
		CFrame.new(cx, bodyBottom + bodyHeight / 2, 0),
		COLORS.concrete
	).CastShadow =
		false
	Scenery.Dress(neighbor, Vector3.new(cx, bodyBottom, 0), size, size, bodyHeight, Random.new(150), false)
	local neighborGreen = Random.new(151)
	for _ = 1, 6 do
		Scenery.Grass(
			neighbor,
			Vector3.new(cx + neighborGreen:NextNumber(-24, 24), roofY, neighborGreen:NextNumber(-24, 24)),
			Vector2.new(neighborGreen:NextNumber(5, 10), neighborGreen:NextNumber(5, 10)),
			neighborGreen
		)
	end
	Scenery.Tree(neighbor, Vector3.new(cx + 18, roofY, 18), 15, neighborGreen)
	block(
		neighbor,
		"TowerRoof",
		Vector3.new(size, World.SlabThickness, size),
		CFrame.new(cx, roofY - World.SlabThickness / 2, 0),
		COLORS.roof
	)
	for _, side in { -1, 1 } do
		block(
			neighbor,
			"Railing",
			Vector3.new(size, 4, 0.6),
			CFrame.new(cx, roofY + 2, side * size / 2),
			COLORS.rail,
			Enum.Material.Metal
		)
	end
	block(
		neighbor,
		"Railing",
		Vector3.new(0.6, 4, size),
		CFrame.new(cx + size / 2, roofY + 2, 0),
		COLORS.rail,
		Enum.Material.Metal
	)
	sign(
		neighbor,
		"sign.tower2",
		CFrame.new(cx - size / 2 + 6, roofY + 9, 0) * CFrame.Angles(0, math.pi / 2, 0),
		Vector2.new(10, 3)
	)

	-- Broken bridge stubs on both towers; the full deck appears per player once built.
	local startX = World.RoofSize / 2
	local endX = cx - size / 2
	local length = endX - startX
	block(
		neighbor,
		"BridgeStub",
		Vector3.new(8, 1, 8),
		CFrame.new(startX + 4, roofY - 0.5, 0),
		COLORS.rust,
		Enum.Material.CorrodedMetal
	)
	block(
		neighbor,
		"BridgeStub",
		Vector3.new(8, 1, 8),
		CFrame.new(endX - 4, roofY - 0.5, 0),
		COLORS.rust,
		Enum.Material.CorrodedMetal
	)
	local deck = block(
		neighbor,
		"BridgeDeck",
		Vector3.new(length - 16, 1, 8),
		CFrame.new((startX + endX) / 2, roofY - 0.5, 0),
		COLORS.metal,
		Enum.Material.DiamondPlate
	)
	deck:SetAttribute("UpgradeVisual", "Bridge")
	deck:SetAttribute("VisualMode", "Show")
	for _, side in { -1, 1 } do
		local rail = block(
			deck,
			"DeckRail",
			Vector3.new(length - 16, 3, 0.5),
			deck.CFrame * CFrame.new(0, 2, side * 3.75),
			COLORS.rail,
			Enum.Material.Metal
		)
		rail:SetAttribute("UpgradeVisual", "Bridge")
		rail:SetAttribute("VisualMode", "Show")
	end

	local victory =
		block(neighbor, "VictoryZone", Vector3.new(size - 4, 12, size - 4), CFrame.new(cx, roofY + 6, 0), COLORS.toxic)
	victory.Transparency = 1
	victory.CanCollide = false
	victory.CanQuery = false
	victory.CanTouch = false

	-- Distant skyline: overgrown ruins all around, with a gap where the neighbour tower stands.
	Scenery.Skyline(neighbor, Vector3.zero, 16, 230, 420, 250, 470, 2026, { { Vector3.new(cx, 0, 0), 95 } })
end

local function collectRefs(root: Folder): WorldRefs
	local interactables = root:FindFirstChild("Interactables") :: Folder
	local roof = root:FindFirstChild("RoofBase") :: Folder
	local visuals = roof:FindFirstChild("UpgradeVisuals") :: Folder
	local neighbor = root:FindFirstChild("NeighborTower") :: Folder
	local toxicZones = {}
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("Hazard") == "Toxic" then
			table.insert(toxicZones, d)
		end
	end
	return {
		root = root,
		interactables = interactables,
		storagePart = interactables:FindFirstChild("StorageCrate") :: BasePart,
		generatorPart = visuals:FindFirstChild("Generator") :: BasePart,
		toxicZones = toxicZones,
		victoryZone = neighbor:FindFirstChild("VictoryZone") :: BasePart,
		roofDropPosition = Vector3.new(0, World.RoofY + 2, -28),
		workbench = interactables:FindFirstChild("Workbench") :: BasePart,
	}
end

-- Template places ship a SpawnLocation near the origin; players must only ever spawn on the roof.
local function disableOtherSpawns(root: Folder)
	for _, d in workspace:GetDescendants() do
		if d:IsA("SpawnLocation") and not d:IsDescendantOf(root) then
			d.Enabled = false
		end
	end
end

function WorldBuilder.Build(): WorldRefs
	local existing = workspace:FindFirstChild(World.FolderName)
	if existing and existing:IsA("Folder") then
		disableOtherSpawns(existing)
		return collectRefs(existing)
	end

	Atmosphere.Apply()
	PropLibrary.Load()
	local root = Instance.new("Folder")
	root.Name = World.FolderName
	local interactables = Instance.new("Folder")
	interactables.Name = "Interactables"
	interactables.Parent = root

	buildRoof(root, interactables)
	buildStairwell(root)
	buildFloor1(root, interactables)
	buildFloor2(root, interactables)
	buildFloor3(root, interactables)
	buildFloor4(root, interactables)
	buildNeighbor(root)

	-- Solid tower body under the bottom floor.
	local bottom = levelY(World.FloorCount) - World.SlabThickness
	local towerBody = block(
		root,
		"TowerBody",
		Vector3.new(World.FloorSize + 2, bottom, World.FloorSize + 2),
		CFrame.new(0, bottom / 2, 0),
		COLORS.concrete
	)
	towerBody.CastShadow = false
	Scenery.Dress(root, Vector3.zero, World.FloorSize + 2, World.FloorSize + 2, bottom, Random.new(1), false)

	root.Parent = workspace
	disableOtherSpawns(root)
	return collectRefs(root)
end

return WorldBuilder
