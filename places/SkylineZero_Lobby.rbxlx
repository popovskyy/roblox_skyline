      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">GameConfig</string>
          <string name="Source">--!strict
-- Balance and shared settings. Every tunable number lives here.

local GameConfig = {
	-- Inventory and storage
	MaxInventoryWeight = 20,
	StorageCapacity = 60,

	-- Health
	StartingHealth = 100,
	MedkitHeal = 60,

	-- Hazards
	FallDamageThreshold = 18,
	FallDamagePerStud = 2,
	ToxicDamagePerSecond = 8,
	ToxicGraceSeconds = 2,
	AirFilterToxicReduction = 0.75,
	HazardTickSeconds = 0.25,

	-- Food and hunger: each descent below the roof eats ExpeditionFoodCost Food.
	-- Without food, after HungerGraceSeconds below the roof health slowly drops.
	ExpeditionFoodCost = 1,
	HungerGraceSeconds = 180,
	HungerDamagePerSecond = 1,

	-- Flashlight: battery drains while switched on, charges next to a built Generator.
	FlashlightBatterySeconds = 240,
	FlashlightChargePerSecond = 20,
	FlashlightChargeRadius = 16,

	-- Interaction
	InteractionDistance = 12,
	InteractionCooldown = 0.35,
	PromptActivationDistance = 10,

	-- Resource nodes. Per player; normal nodes refill when the player returns to the roof.
	-- Unique nodes (Crowbar, Flashlight, notes) never refill.
	ResourceRespawnSeconds = 0,
	ResetNodesOnRoofReturn = true,

	-- Death: carried items except protected ones drop as a personal backpack at the death spot.
	DeathProtectedItems = {
		Crowbar = true,
		Flashlight = true,
	} :: { [string]: boolean },
	BackpackDropLifetimeSeconds = 900,
	RespawnDelaySeconds = 3,

	-- Testing: every upgrade costs 1 of each listed item. Never ship with this on.
	TestPrices = false,

	-- Server and saving
	MaxPlayersPerServer = 4,
	AutosaveIntervalSeconds = 120,
	DataStoreName = "SkylineZero_PlayerData_v1",
	SchemaVersion = 1,
	DataRetryAttempts = 3,
	DataRetryDelaySeconds = 2,

	-- World layout (studs). The building is lifted high so a default baseplate never overlaps it.
	World = {
		Mode = "Generated" :: "Generated" | "Manual",
		FolderName = "GeneratedWorld",
		RoofY = 396, -- top surface of the roof slab
		FloorSpacing = 24,
		FloorCount = 4,
		RoofSize = 100,
		FloorSize = 70,
		SlabThickness = 2,
		NeighborOffsetX = 150, -- centre of the neighbour tower roof
	},
}

return GameConfig
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">ItemDefinitions</string>
          <string name="Source">--!strict
-- Every item the game knows about. Unknown IDs are rejected everywhere.

export type ItemDef = {
	id: string,
	displayName: string,
	weight: number,
	startAmount: number,
	description: string,
	storable: boolean, -- tools stay with the player and never go into storage
	icon: string, -- emoji placeholder until real icons are drawn
	iconImage: string?, -- rbxassetid://... once an icon is uploaded; wins over the emoji
	color: Color3, -- slot accent colour
}

local Items: { [string]: ItemDef } = {
	Scrap = {
		id = "Scrap",
		icon = "🔩",
		color = Color3.fromRGB(150, 110, 80),
		displayName = "Металобрухт",
		weight = 1,
		startAmount = 0,
		description = "Основа для будь-якого поліпшення.",
		storable = true,
	},
	Electronics = {
		id = "Electronics",
		icon = "💾",
		color = Color3.fromRGB(70, 170, 110),
		displayName = "Електронні деталі",
		weight = 1,
		startAmount = 0,
		description = "Потрібні для генератора й фільтра.",
		storable = true,
	},
	Food = {
		id = "Food",
		icon = "🥫",
		color = Color3.fromRGB(220, 140, 50),
		displayName = "Їжа",
		weight = 1,
		startAmount = 2,
		description = "Кожен спуск з'їдає 1 їжу. Без неї через 3 хв почнеш слабшати.",
		storable = true,
	},
	Medkit = {
		id = "Medkit",
		icon = "🩹",
		color = Color3.fromRGB(220, 70, 70),
		displayName = "Аптечка",
		weight = 2,
		startAmount = 1,
		description = "Відновлює 35 здоров'я.",
		storable = true,
	},
	Cable = {
		id = "Cable",
		icon = "🧵",
		color = Color3.fromRGB(90, 90, 100),
		displayName = "Кабель",
		weight = 2,
		startAmount = 0,
		description = "Рідкісний. Лежить у руїнах 4 поверху. Потрібен для мосту.",
		storable = true,
	},
	Motor = {
		id = "Motor",
		icon = "⚙️",
		color = Color3.fromRGB(100, 130, 170),
		displayName = "Мотор",
		weight = 3,
		startAmount = 0,
		description = "Рідкісний. Захований за завалами 4 поверху. Потрібен для мосту.",
		storable = true,
	},
	Crowbar = {
		id = "Crowbar",
		icon = "🔧",
		color = Color3.fromRGB(180, 60, 50),
		displayName = "Лом",
		weight = 3,
		startAmount = 0,
		description = "Розбирає завали з позначкою «Лом».",
		storable = false,
	},
	Flashlight = {
		id = "Flashlight",
		icon = "🔦",
		color = Color3.fromRGB(230, 200, 60),
		displayName = "Ліхтарик",
		weight = 1,
		startAmount = 0,
		description = "Клавіша F. Заряджається біля генератора.",
		storable = false,
	},
}

-- Display order in the UI.
local Order = { "Scrap", "Electronics", "Food", "Medkit", "Cable", "Motor", "Crowbar", "Flashlight" }

local ItemDefinitions = {
	Items = Items,
	Order = Order,
}

function ItemDefinitions.Get(id: string): ItemDef?
	return Items[id]
end

function ItemDefinitions.IsValid(id: any): boolean
	return type(id) == "string" and Items[id] ~= nil
end

return ItemDefinitions
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Locale</string>
          <string name="Source">--!strict
-- All player-facing text in Ukrainian, Russian and English.
--
-- The server never sends finished sentences: it sends a message (a key, or { key, args... }) and every
-- client renders it in its own language. Arguments can be plain values or references:
--   Locale.Item("Scrap")      -&gt; the item's name
--   Locale.Upgrade("Bridge")  -&gt; the upgrade's name
--   Locale.Cost({ Scrap = 8 }) -&gt; "8 Scrap + ..."
-- Adding a language: add its code to Languages and a column to every entry below.

local ItemDefinitions = require(script.Parent.ItemDefinitions)

export type Lang = "uk" | "ru" | "en"
export type Message = string | { any }

local Locale = {}

Locale.Languages = { "uk", "ru", "en" } :: { Lang }
Locale.Default = "en" :: Lang
Locale.LanguageNames = { uk = "Українська", ru = "Русский", en = "English" }

type Entry = { uk: string, ru: string, en: string }

local S: { [string]: Entry } = {
	-- Items
	["item.Scrap.name"] = { uk = "Металобрухт", ru = "Металлолом", en = "Scrap" },
	["item.Scrap.desc"] = {
		uk = "Основа для будь-якого поліпшення.",
		ru = "Основа для любого улучшения.",
		en = "The base of every upgrade.",
	},
	["item.Electronics.name"] = { uk = "Електроніка", ru = "Электроника", en = "Electronics" },
	["item.Electronics.desc"] = {
		uk = "Потрібна для генератора й фільтра.",
		ru = "Нужна для генератора и фильтра.",
		en = "Needed for the generator and the filter.",
	},
	["item.Food.name"] = { uk = "Їжа", ru = "Еда", en = "Food" },
	["item.Food.desc"] = {
		uk = "Кожен спуск з'їдає 1 їжу. Без неї через 3 хв почнеш слабшати.",
		ru = "Каждый спуск съедает 1 еду. Без неё через 3 мин начнёшь слабеть.",
		en = "Each descent uses 1 food. Without it you start to weaken after 3 min.",
	},
	["item.Medkit.name"] = { uk = "Аптечка", ru = "Аптечка", en = "Medkit" },
	["item.Medkit.desc"] = {
		uk = "Відновлює 35 здоров'я.",
		ru = "Восстанавливает 35 здоровья.",
