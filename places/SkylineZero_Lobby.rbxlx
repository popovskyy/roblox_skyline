local function entry(key: string): Entry?
	return S[key]
end

function Locale.Has(key: string): boolean
	return S[key] ~= nil
end

-- Normalises a Roblox LocaleId ("uk-ua", "ru-ru", "en-us") or a saved code to one of our languages.
function Locale.Resolve(code: any): Lang
	if type(code) ~= "string" then
		return Locale.Default
	end
	local prefix = string.lower(string.sub(code, 1, 2))
	if prefix == "uk" or prefix == "ru" or prefix == "en" then
		return prefix :: Lang
	end
	return Locale.Default
end

function Locale.IsLanguage(code: any): boolean
	return code == "uk" or code == "ru" or code == "en"
end

-- Argument references, resolved in the reader's language.
function Locale.Item(itemId: string): { [string]: any }
	return { ref = "item." .. itemId .. ".name" }
end

function Locale.Upgrade(upgradeId: string): { [string]: any }
	return { ref = "upgrade." .. upgradeId .. ".name" }
end

function Locale.Cost(cost: { [string]: number }): { [string]: any }
	return { cost = cost }
end

local function raw(lang: Lang, key: string): string
	local e = entry(key)
	if not e then
		return key
	end
	return (e :: any)[lang] or e.en
end

local function resolveArg(lang: Lang, arg: any): any
	if type(arg) ~= "table" then
		return arg
	end
	if type(arg.ref) == "string" then
		return raw(lang, arg.ref)
	end
	if type(arg.cost) == "table" then
		local parts = {}
		for _, itemId in ItemDefinitions.Order do
			local amount = arg.cost[itemId]
			if type(amount) == "number" then
				table.insert(parts, ("%d %s"):format(amount, raw(lang, "item." .. itemId .. ".name")))
			end
		end
		return table.concat(parts, " + ")
	end
	return ""
end

function Locale.T(lang: Lang, key: string, ...: any): string
	local text = raw(lang, key)
	local count = select("#", ...)
	if count == 0 then
		return text
	end
	local args = table.pack(...)
	for i = 1, count do
		args[i] = resolveArg(lang, args[i])
	end
	local ok, result = pcall(string.format, text, table.unpack(args, 1, count))
	return if ok then result else text
end

-- Renders a message sent by the server: a key, or { key, arg1, arg2, ... }.
function Locale.Format(lang: Lang, message: any): string
	if type(message) == "string" then
		return Locale.T(lang, message)
	end
	if type(message) == "table" and type(message[1]) == "string" then
		return Locale.T(lang, message[1], table.unpack(message, 2))
	end
	return ""
end

function Locale.ItemName(lang: Lang, itemId: string): string
	return raw(lang, "item." .. itemId .. ".name")
end

function Locale.ItemDesc(lang: Lang, itemId: string): string
	return raw(lang, "item." .. itemId .. ".desc")
end

function Locale.UpgradeName(lang: Lang, upgradeId: string): string
	return raw(lang, "upgrade." .. upgradeId .. ".name")
end

-- The language a player reads in: their saved choice, else their Roblox locale.
function Locale.ForPlayer(player: Player): Lang
	local chosen = player:GetAttribute("Language")
	if Locale.IsLanguage(chosen) then
		return chosen :: Lang
	end
	return Locale.Resolve(player.LocaleId)
end

return Locale
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">MonetizationConfig</string>
          <string name="Source">--!strict
-- Monetization is OFF for the MVP. This file is the single place to switch it on later.
-- Planned direction (not final): cosmetic / light-convenience Game Passes and a
-- "backpack insurance" Developer Product. No paid resources and no paid floor skips.

export type PassDef = {
	id: number, -- Game Pass asset id from the Creator Dashboard (0 = not created yet)
	-- Effects the game understands. Leave a field nil for no effect.
	inventoryBonus: number?,
	cosmetic: string?,
}

export type ProductDef = {
	id: number, -- Developer Product id (0 = not created yet)
	-- Name of a handler registered in MonetizationService.RegisterProductHandler.
	handler: string,
}

local MonetizationConfig = {
	Enabled = false,

	GamePasses = {
		-- BiggerBackpack = { id = 0, inventoryBonus = 5 },
		-- LanternColors = { id = 0, cosmetic = "LanternColors" },
	} :: { [string]: PassDef },

	DeveloperProducts = {
		-- BackpackInsurance = { id = 0, handler = "BackpackInsurance" },
		-- Donation100 = { id = 0, handler = "Donation" },
	} :: { [string]: ProductDef },
}

return MonetizationConfig
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">MusicConfig</string>
          <string name="Source">--!strict
-- Background music. All tracks are free licensed audio from the Roblox Creator Store
-- (uploaded by the verified DistroKid / APM accounts), so they play in any experience.
-- Swap ids here to change the soundtrack.

local MusicConfig = {
	Volume = 0.12, -- quiet background so sound effects stay clear
	FadeSeconds = 3,

	-- Calm, melancholic tracks for the roof base and the neighbour tower.
	Roof = {
		124181322816807, -- Deserted Embers
		123927270887272, -- Fading World Strings
		71882714223295, -- Silent Ruins Motif
		103760117708996, -- Post Apocalyptic Lullaby
	},

	-- Tense drones for the floors below.
	Below = {
		106752035160966, -- Siberian Wasteland Underscore (Ambient Only)
		139935905572584, -- Corroded Industrial Drone
		140252461454906, -- Subterranean Steel Drones
	},
}

return MusicConfig
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">PlacesConfig</string>
          <string name="Source">--!strict
-- Place ids of the experience. Fill these in after publishing both places
-- (Creator Dashboard &gt; your experience &gt; Places). 0 = not published yet: teleports are disabled
-- and the tower runs every server as solo.

local PlacesConfig = {
	-- Shown in the lobby and printed on start, so it is easy to see which build is published.
	Build = "b17 · elevator-solo-modal",

	LobbyPlaceId = 128619231370772,
	TowerPlaceId = 104145307601846,

	-- Identical boarding lifts. Capacity is chosen in-dialog (MinPartySize..MaxPartySize), not by signs.
	Lifts = {
		{ id = "LiftA", countdown = 20, fullCountdown = 5 },
		{ id = "LiftB", countdown = 20, fullCountdown = 5 },
	},
	-- Solo allowed: 1..6 (owner playtest + UX update).
	MinPartySize = 1,
	MaxPartySize = 6,

	-- Party hand-off from the lobby to the reserved tower server.
	PartyMapName = "SkylineZero_Parties",
	PartyTtlSeconds = 600,
	TeleportRetries = 3,

	-- Leaderboard shown in the lobby: towers completed per player.
	LeaderboardStoreName = "SkylineZero_TowersCompleted",
	LeaderboardSize = 10,
	LeaderboardRefreshSeconds = 60,
}

return PlacesConfig
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">RemoteNames</string>
          <string name="Source">--!strict
-- Names of every RemoteEvent. The server creates them in ReplicatedStorage.Remotes.

local RemoteNames = {
	-- Server -&gt; client
	StateChanged = "StateChanged",
	Notify = "Notify",
	ShowNote = "ShowNote",
	OpenStorage = "OpenStorage",

	-- Client -&gt; server
	RequestState = "RequestState",
	StorageTransfer = "StorageTransfer",
	UseItem = "UseItem",
	ToggleFlashlight = "ToggleFlashlight",
	SetLanguage = "SetLanguage",
	ReturnToLobby = "ReturnToLobby",
}

return RemoteNames
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Theme</string>
          <string name="Source">--!strict
-- Fonts used across both places. Oswald for headings and big numbers, Montserrat for everything else.
-- Both families include Cyrillic, so Ukrainian and Russian text keeps the same look.

local function family(name: string, weight: Enum.FontWeight): Font
	return Font.new("rbxasset://fonts/families/" .. name .. ".json", weight)
end

local Theme = {
	Display = family("Oswald", Enum.FontWeight.Bold), -- titles, signs, counters
	Heading = family("Oswald", Enum.FontWeight.Medium),
	Bold = family("Montserrat", Enum.FontWeight.Bold), -- buttons, labels that must stand out
	Body = family("Montserrat", Enum.FontWeight.Medium), -- regular text
}

return Theme
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source">--!strict
-- Shared data shapes for server data and the state snapshot sent to clients.

export type ItemCounts = { [string]: number }

export type PlayerData = {
	schemaVersion: number,
	inventory: ItemCounts,
	storage: ItemCounts,
	upgrades: { [string]: boolean },
	flashlightCharge: number, -- seconds of battery left
	uniqueNodesTaken: { [string]: boolean },
	towerCompleted: boolean,
	tutorialStep: number,
	discoveredNotes: { [string]: boolean },
	language: string?, -- "uk" | "ru" | "en"; nil = follow the Roblox locale
	-- Monetization stubs, unused while MonetizationConfig.Enabled = false.
	ownedPasses: { [string]: boolean },
	processedReceipts: { [string]: boolean },
}

export type TutorialView = {
	step: number,
	total: number,
	text: string,
	done: boolean,
}

export type StateSnapshot = {
	inventory: ItemCounts,
	storage: ItemCounts,
	upgrades: { [string]: boolean },
	costs: { [string]: { [string]: number } },
	weight: number,
	maxWeight: number,
	storageWeight: number,
	storageCapacity: number,
	flashlightCharge: number,
	flashlightMax: number,
	depletedNodes: { [string]: boolean },
	clearedRubble: { [string]: boolean },
	uniqueNodesTaken: { [string]: boolean },
	backpack: Vector3?,
	tutorial: TutorialView?,
	acts: number,
	saveEnabled: boolean,
	towerCompleted: boolean,
}

return {}
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">UpgradeDefinitions</string>
          <string name="Source">--!strict
-- Base upgrades. Prices are read only from here; the client never sends a price.

local GameConfig = require(script.Parent.GameConfig)

export type UpgradeDef = {
	id: string,
	displayName: string,
	description: string,
	cost: { [string]: number },
	requires: { string }, -- upgrades that must be built first
	act: number?, -- story act this upgrade completes (terminal shows acts 0/3)
	order: number,
}

local Upgrades: { [string]: UpgradeDef } = {
	StorageCrate = {
		id = "StorageCrate",
		displayName = "Сховище",
		description = "Ящик на даху на 60 одиниць ваги.",
		cost = { Scrap = 8 },
		requires = {},
		order = 1,
	},
	Generator = {
		id = "Generator",
		displayName = "Генератор",
		description = "Вмикає світло бази, заряджає ліхтарик і відкриває двері на 4 поверх.",
		cost = { Scrap = 6, Electronics = 4 },
		requires = { "StorageCrate" },
		act = 1,
		order = 2,
	},
	AirFilter = {
		id = "AirFilter",
		displayName = "Фільтр повітря",
		description = "Зменшує шкоду від токсичного повітря на 75%.",
		cost = { Scrap = 5, Electronics = 5 },
		requires = { "Generator" },
		act = 2,
		order = 3,
	},
	Bridge = {
		id = "Bridge",
		displayName = "Міст до сусідньої вежі",
		description = "Полагодь міст і вибирайся з вежі.",
		cost = { Scrap = 10, Cable = 4, Motor = 2 },
		requires = { "Generator" },
		act = 3,
		order = 4,
	},
}

local Order = { "StorageCrate", "Generator", "AirFilter", "Bridge" }

local UpgradeDefinitions = {
	Upgrades = Upgrades,
	Order = Order,
}

function UpgradeDefinitions.Get(id: string): UpgradeDef?
	return Upgrades[id]
end

-- Price actually charged. GameConfig.TestPrices makes every listed item cost 1.
function UpgradeDefinitions.GetCost(def: UpgradeDef): { [string]: number }
	if not GameConfig.TestPrices then
		return def.cost
	end
	local cheap = {}
	for itemId in def.cost do
		cheap[itemId] = 1
	end
	return cheap
end

function UpgradeDefinitions.IsValid(id: any): boolean
	return type(id) == "string" and Upgrades[id] ~= nil
end

return UpgradeDefinitions
</string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="14">
      <Properties>
        <string name="Name">LeaderboardService</string>
        <string name="Source">--!strict
-- "Towers completed" board in the lobby, read from the OrderedDataStore the tower writes on a first completion.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PlacesConfig = require(ReplicatedStorage.Shared.PlacesConfig)

local LeaderboardService = {}

local names: { [number]: string } = {}

local function nameOf(userId: number): string
	if names[userId] then
		return names[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok and type(name) == "string" then name else ("#" .. tostring(userId))
	names[userId] = result
	return result
end

local function refresh(rows: { TextLabel })
	local ok, pages = pcall(function()
		local store = DataStoreService:GetOrderedDataStore(PlacesConfig.LeaderboardStoreName)
		return store:GetSortedAsync(false, PlacesConfig.LeaderboardSize)
	end)
	local entries = if ok and pages then pages:GetCurrentPage() else {}
	for i, row in rows do
		local entry = entries[i]
		if entry then
			row:SetAttribute("TextKey", nil)
			row.Text = ("%d.  %s  —  %d"):format(i, nameOf(tonumber(entry.key) or 0), entry.value)
		elseif i == 1 then
			-- The client translates it.
			row:SetAttribute("TextKey", "lobby.leadersEmpty")
			row.Text = "—"
		else
			row:SetAttribute("TextKey", nil)
			row.Text = ""
		end
	end
	if not ok then
		warn("[Leaderboard] could not read the board:", pages)
	end
end

function LeaderboardService.Start(rows: { TextLabel })
	task.spawn(function()
		while true do
			refresh(rows)
			task.wait(PlacesConfig.LeaderboardRefreshSeconds)
		end
	end)
end

return LeaderboardService
</string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="15">
      <Properties>
        <string name="Name">LiftService</string>
        <string name="Source">--!strict
-- Lobby lifts. Standing inside a lift's zone joins it; walking out leaves it. The first player in is the leader
-- and must pick a party size (1–6, solo allowed) before the countdown starts. When the countdown ends the
-- server reserves a private tower server, stores the party in MemoryStore and teleports everyone together.

local MemoryStoreService = game:GetService("MemoryStoreService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")

local PlacesConfig = require(ReplicatedStorage.Shared.PlacesConfig)

local LiftService = {}

type LiftDef = { id: string, countdown: number, fullCountdown: number }

type Lift = {
	def: LiftDef,
	zone: BasePart,
	statusLabel: TextLabel,
	members: { Player }, -- join order; members[1] is the leader
	capacity: number?, -- set by the leader via ChooseLiftSize
	deadline: number?,
	launching: boolean,
	blocked: { [Player]: boolean }, -- after a failed start: must step out before rejoining
	pendingLeader: Player?, -- inside the empty lift, waiting to pick a size
}

type Notify = (player: Player, message: any, kind: string?) -&gt; ()

local lifts: { Lift } = {}
local notify: Notify = function(_player, _message, _kind) end
local TICK = 0.25
local chooseRemote: RemoteEvent? = nil
local openPickRemote: RemoteEvent? = nil

local function isInside(part: BasePart, position: Vector3): boolean
	local p = part.CFrame:PointToObjectSpace(position)
	local half = part.Size / 2
	return math.abs(p.X) &lt;= half.X and math.abs(p.Y) &lt;= half.Y and math.abs(p.Z) &lt;= half.Z
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function liftOf(player: Player): Lift?
	for _, lift in lifts do
		if table.find(lift.members, player) then
			return lift
		end
	end
	return nil
end

local function clearPickPrompt(player: Player)
	player:SetAttribute("LiftPickOpen", nil)
	player:SetAttribute("LiftPickId", nil)
end

local function clearRider(player: Player)
	player:SetAttribute("LiftSeconds", nil)
	player:SetAttribute("LiftCount", nil)
	player:SetAttribute("LiftCapacity", nil)
	clearPickPrompt(player)
end

local function updateStatus(lift: Lift)
	local count = #lift.members
	local capacity = lift.capacity
	if capacity then
		lift.statusLabel.Text = ("%d / %d"):format(count, capacity)
	else
		lift.statusLabel.Text = "—"
	end
	local seconds = if lift.deadline then math.max(0, math.ceil(lift.deadline - os.clock())) else nil
	for _, player in lift.members do
		player:SetAttribute("LiftSeconds", if lift.launching then 0 else seconds)
		player:SetAttribute("LiftCount", count)
		player:SetAttribute("LiftCapacity", capacity)
	end
	if lift.pendingLeader and lift.pendingLeader.Parent == Players then
		lift.pendingLeader:SetAttribute("LiftPickOpen", true)
		lift.pendingLeader:SetAttribute("LiftPickId", lift.def.id)
	end
end

local function clearPending(lift: Lift)
	local pending = lift.pendingLeader
	lift.pendingLeader = nil
	if pending and pending.Parent == Players and not liftOf(pending) then
		clearPickPrompt(pending)
	end
end

local function removeMember(lift: Lift, player: Player)
	local index = table.find(lift.members, player)
	if not index then
		return
	end
	table.remove(lift.members, index)
	clearRider(player)
	if #lift.members == 0 then
		lift.deadline = nil
		lift.capacity = nil
	end
	updateStatus(lift)
end

local function addMember(lift: Lift, player: Player)
	table.insert(lift.members, player)
	clearPickPrompt(player)
	local capacity = lift.capacity
	local now = os.clock()
	if #lift.members == 1 and capacity then
		lift.deadline = now + lift.def.countdown
	end
	if capacity and #lift.members &gt;= capacity and lift.deadline then
		lift.deadline = math.min(lift.deadline, now + lift.def.fullCountdown)
	end
	updateStatus(lift)
end

local function withRetries(fn: () -&gt; any): (boolean, any)
	local lastError = nil
	for attempt = 1, PlacesConfig.TeleportRetries do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastError = result
		warn(("[Lift] attempt %d failed: %s"):format(attempt, tostring(result)))
		task.wait(attempt)
	end
	return false, lastError
end

local function launch(lift: Lift)
	local party = table.clone(lift.members)
	lift.launching = true
	lift.deadline = nil

	local function fail(message: string)
		for _, player in party do
			if player.Parent then
				notify(player, message, "warning")
			end
		end
		lift.launching = false
		for _, player in lift.members do
			lift.blocked[player] = true
			clearRider(player)
		end
		table.clear(lift.members)
		lift.capacity = nil
		clearPending(lift)
		updateStatus(lift)
	end

	if PlacesConfig.TowerPlaceId == 0 then
		fail("lobby.notPublished")
		return
	end
	if RunService:IsStudio() then
		fail("lobby.studio")
		return
	end
	for _, player in party do
		notify(player, "lobby.starting", "success")
	end

	local reserved, result = withRetries(function()
		local code, serverId = TeleportService:ReserveServer(PlacesConfig.TowerPlaceId)
		return { code = code, serverId = serverId }
	end)
	if not reserved then
		fail("lobby.failed")
		return
	end
	local accessCode: string = result.code
	local privateServerId: string = result.serverId

	local userIds = {}
	for _, player in party do
		table.insert(userIds, player.UserId)
	end
	local partyMap = MemoryStoreService:GetHashMap(PlacesConfig.PartyMapName)
	local stored = withRetries(function()
		partyMap:SetAsync(privateServerId, {
			leaderUserId = userIds[1],
			partyUserIds = userIds,
		}, PlacesConfig.PartyTtlSeconds)
	end)
	if not stored then
		fail("lobby.failed")
		return
	end

	-- Only players still in the lobby can travel.
	local travellers = {}
	for _, player in party do
		if player.Parent == Players then
			table.insert(travellers, player)
		end
	end
	local options = Instance.new("TeleportOptions")
	options.ReservedServerAccessCode = accessCode
	local teleported = withRetries(function()
		TeleportService:TeleportAsync(PlacesConfig.TowerPlaceId, travellers, options)
	end)
	if not teleported then
		fail("lobby.failed")
		return
	end
	-- Teleporting players stay in the lift until they disappear, so nobody else can take their slot.
	task.delay(15, function()
		lift.launching = false
		for _, player in lift.members do
			if player.Parent then
				clearRider(player)
			end
		end
		table.clear(lift.members)
		lift.capacity = nil
		clearPending(lift)
		updateStatus(lift)
	end)
end

local function beginPick(lift: Lift, player: Player)
	if lift.pendingLeader and lift.pendingLeader ~= player then
		return
	end
	lift.pendingLeader = player
	-- Attribute for clients that poll it; remote so the modal opens even if AttributeChanged is missed.
	player:SetAttribute("LiftPickOpen", true)
	player:SetAttribute("LiftPickId", lift.def.id)
	if openPickRemote then
		openPickRemote:FireClient(player, lift.def.id)
	end
	notify(player, "lobby.pickSizeHint", "info")
	updateStatus(lift)
end

function LiftService.ChooseSize(player: Player, size: any)
	if type(size) ~= "number" or size ~= size or size % 1 ~= 0 then
		return
	end
	local minSize = PlacesConfig.MinPartySize
	local maxSize = PlacesConfig.MaxPartySize
	if size &lt; minSize or size &gt; maxSize then
		notify(player, "lobby.badSize", "warning")
		return
	end
	local liftId = player:GetAttribute("LiftPickId")
	if type(liftId) ~= "string" then
		return
	end
	local lift: Lift? = nil
	for _, candidate in lifts do
		if candidate.def.id == liftId then
			lift = candidate
			break
		end
	end
	if not lift or lift.launching or lift.capacity ~= nil then
		return
	end
	if lift.pendingLeader ~= player then
		return
	end
	local root = rootOf(player)
	if not root or not isInside(lift.zone, root.Position) then
		clearPending(lift)
		clearPickPrompt(player)
		return
	end
	lift.capacity = size
	lift.pendingLeader = nil
	clearPickPrompt(player)
	addMember(lift, player)
	notify(player, { "lobby.sizeChosen", size }, "success")
	-- Solo (1): leave almost immediately after pick so a lone player is not stuck waiting 20s.
	if size == 1 and lift.deadline then
		lift.deadline = math.min(lift.deadline, os.clock() + lift.def.fullCountdown)
		updateStatus(lift)
	end
end

local function tick()
	local now = os.clock()
	for _, lift in lifts do
		if not lift.launching then
			-- Leave: anyone no longer inside the zone.
			for i = #lift.members, 1, -1 do
				local player = lift.members[i]
				local root = rootOf(player)
				if player.Parent ~= Players or not root or not isInside(lift.zone, root.Position) then
					removeMember(lift, player)
					if player.Parent == Players then
						notify(player, "lobby.left", "info")
					end
				end
			end
			-- Pending leader left before picking a size.
			if lift.pendingLeader then
				local pending = lift.pendingLeader
				local root = rootOf(pending)
				if pending.Parent ~= Players or not root or not isInside(lift.zone, root.Position) then
					clearPending(lift)
					if pending.Parent == Players then
						clearPickPrompt(pending)
						notify(pending, "lobby.left", "info")
					end
				end
			end
			-- Join / start size pick.
			for _, player in Players:GetPlayers() do
				local root = rootOf(player)
				local inside = root ~= nil and isInside(lift.zone, root.Position)
				if not inside then
					lift.blocked[player] = nil
				elseif not lift.blocked[player] and not liftOf(player) then
					if lift.capacity == nil then
						if lift.pendingLeader == nil then
							beginPick(lift, player)
						end
					elseif #lift.members &lt; (lift.capacity :: number) then
						addMember(lift, player)
					elseif not liftOf(player) then
						-- Full: only toast once per stay via blocked flag after notify.
						if not lift.blocked[player] then
							notify(player, "lobby.full", "warning")
							lift.blocked[player] = true
						end
					end
				end
			end
			if lift.deadline and now &gt;= lift.deadline and #lift.members &gt; 0 then
				task.spawn(launch, lift)
			else
				updateStatus(lift)
			end
		end
	end
end

-- zones[id] = { zone = part, statusLabel = label } from LobbyWorld.
function LiftService.Start(zones: { [string]: { zone: BasePart, statusLabel: TextLabel } }, notifyFn: Notify)
	notify = notifyFn
	for _, def in PlacesConfig.Lifts do
		local refs = zones[def.id]
		if refs then
			local lift: Lift = {
				def = def,
				zone = refs.zone,
				statusLabel = refs.statusLabel,
				members = {},
				capacity = nil,
				deadline = nil,
				launching = false,
				blocked = {},
				pendingLeader = nil,
			}
			table.insert(lifts, lift)
			updateStatus(lift)
		end
	end

	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if remotes then
		local existing = remotes:FindFirstChild("ChooseLiftSize")
		if existing and existing:IsA("RemoteEvent") then
			chooseRemote = existing
		else
			local remote = Instance.new("RemoteEvent")
			remote.Name = "ChooseLiftSize"
			remote.Parent = remotes
			chooseRemote = remote
		end
		local openExisting = remotes:FindFirstChild("OpenLiftSizePick")
		if openExisting and openExisting:IsA("RemoteEvent") then
			openPickRemote = openExisting
		else
			local openRemote = Instance.new("RemoteEvent")
			openRemote.Name = "OpenLiftSizePick"
			openRemote.Parent = remotes
			openPickRemote = openRemote
		end
		(chooseRemote :: RemoteEvent).OnServerEvent:Connect(function(player, size)
			LiftService.ChooseSize(player, size)
		end)
	end

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator &gt;= TICK then
			accumulator = 0
			tick()
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		local lift = liftOf(player)
		if lift then
			removeMember(lift, player)
		end
		for _, l in lifts do
			l.blocked[player] = nil
			if l.pendingLeader == player then
				clearPending(l)
			end
		end
		clearRider(player)
	end)

	-- ProximityPrompt on each cabin zone: opens the size modal if the lift still needs a leader pick.
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		if prompt.Name ~= "LiftEnterPrompt" then
			return
		end
		for _, lift in lifts do
			if prompt:IsDescendantOf(lift.zone) or prompt.Parent == lift.zone then
				if lift.launching or lift.blocked[player] then
					return
				end
				if lift.capacity == nil and (lift.pendingLeader == nil or lift.pendingLeader == player) then
					beginPick(lift, player)
				elseif lift.capacity and not liftOf(player) and #lift.members &lt; (lift.capacity :: number) then
					addMember(lift, player)
				elseif lift.capacity and #lift.members &gt;= (lift.capacity :: number) then
					notify(player, "lobby.full", "warning")
				end
				return
			end
		end
	end)
end

return LiftService
</string>
      </Properties>
    </Item>
    <Item class="Script" referent="16">
      <Properties>
        <string name="Name">LobbyMain</string>
        <token name="RunContext">0</token>
        <string name="Source">--!strict
-- Lobby place entry point: builds the plaza, starts the lifts and the leaderboard.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Atmosphere = require(script.Parent.Atmosphere)
local LeaderboardService = require(script.Parent.LeaderboardService)
local LiftService = require(script.Parent.LiftService)
local LobbyWorld = require(script.Parent.LobbyWorld)

Players.CharacterAutoLoads = true

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local notifyRemote = Instance.new("RemoteEvent")
notifyRemote.Name = "Notify"
notifyRemote.Parent = remotes
local setLanguage = Instance.new("RemoteEvent")
setLanguage.Name = "SetLanguage"
setLanguage.Parent = remotes
local chooseLiftSize = Instance.new("RemoteEvent")
chooseLiftSize.Name = "ChooseLiftSize"
chooseLiftSize.Parent = remotes
local openLiftPick = Instance.new("RemoteEvent")
openLiftPick.Name = "OpenLiftSizePick"
openLiftPick.Parent = remotes
remotes.Parent = ReplicatedStorage

-- The lobby keeps the language choice only for this visit; the tower saves it with the player's progress.
setLanguage.OnServerEvent:Connect(function(player, code)
	if code == "uk" or code == "ru" or code == "en" then
		player:SetAttribute("Language", code)
	end
end)

Atmosphere.Apply()
local world = LobbyWorld.Build()
LiftService.Start(world.lifts, function(player, message, kind)
	notifyRemote:FireClient(player, message, kind or "info")
end)
LeaderboardService.Start(world.leaderboardRows)

local PlacesConfig = require(ReplicatedStorage.Shared.PlacesConfig)
print(("[Skyline Zero] Lobby ready, build %s, tower place %d"):format(PlacesConfig.Build, PlacesConfig.TowerPlaceId))
</string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="17">
      <Properties>
        <string name="Name">LobbyWorld</string>
        <string name="Source">--!strict
-- Builds the lobby: a ruined plaza at the foot of the tower, four lifts, a leaderboard and a how-to-play board.
-- Text in the world carries a Locale key (TextKey attribute) so each client shows it in its own language.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Theme = require(ReplicatedStorage.Shared.Theme)
local Locale = require(ReplicatedStorage.Shared.Locale)
local PlacesConfig = require(ReplicatedStorage.Shared.PlacesConfig)
local Scenery = require(script.Parent.Scenery)

local LobbyWorld = {}

export type LiftRefs = { zone: BasePart, statusLabel: TextLabel }
export type Refs = {
	lifts: { [string]: LiftRefs },
	leaderboardRows: { TextLabel },
}

local COLORS = {
	ground = Color3.fromRGB(92, 88, 84),
	concrete = Color3.fromRGB(120, 116, 110),
	dark = Color3.fromRGB(45, 46, 52),
	metal = Color3.fromRGB(110, 115, 122),
	glow = Color3.fromRGB(255, 160, 70),
	rubble = Color3.fromRGB(100, 92, 84),
	silhouette = Color3.fromRGB(40, 42, 50),
}

local function block(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.Concrete
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function textLabel(parent: Instance, key: string?, size: UDim2, position: UDim2, textSize: number?): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = size
	label.Position = position
	label.FontFace = Theme.Bold
	label.TextColor3 = Color3.fromRGB(255, 225, 170)
	label.TextStrokeTransparency = 0.4
	label.TextWrapped = true
	if textSize then
		label.TextSize = textSize
	else
		label.TextScaled = true
	end
	if key then
		label.Text = Locale.T("en", key)
		label:SetAttribute("TextKey", key)
	else
		label.Text = ""
	end
	label.Parent = parent
	return label
end

local function board(parent: Instance, name: string, size: Vector2, cframe: CFrame): SurfaceGui
	local part = block(parent, name, Vector3.new(size.X, size.Y, 0.6), cframe, COLORS.dark, Enum.Material.Metal)
	local frame = block(
		parent,
		name .. "Frame",
		Vector3.new(size.X + 1, size.Y + 1, 0.4),
		cframe * CFrame.new(0, 0, 0.3),
		COLORS.metal,
		Enum.Material.Metal
	)
	frame.CanCollide = false
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0.2
	gui.Parent = part
	return gui
end

local function buildLift(parent: Instance, def: { id: string }, x: number, z: number): LiftRefs
	local folder = Instance.new("Folder")
	folder.Name = "Lift_" .. def.id
	folder.Parent = parent
	-- All boarding lifts share the same look — party size is chosen in UI, not by painted capacity signs.
	local accent = COLORS.glow

	block(folder, "Floor", Vector3.new(10, 0.6, 10), CFrame.new(x, 0.3, z), COLORS.metal, Enum.Material.DiamondPlate)
	local edge = block(folder, "Edge", Vector3.new(10.4, 0.2, 10.4), CFrame.new(x, 0.05, z), accent, Enum.Material.Neon)
	edge.CanCollide = false
	-- Cabin: back and side walls, roof; the front faces the plaza.
	block(folder, "Back", Vector3.new(10, 12, 0.6), CFrame.new(x, 6, z + 5), COLORS.dark, Enum.Material.Metal)
	for _, side in { -1, 1 } do
		local wall = block(
			folder,
			"Side",
			Vector3.new(0.6, 12, 10),
			CFrame.new(x + side * 5, 6, z),
			COLORS.metal,
			Enum.Material.Glass
		)
		wall.Transparency = 0.5
	end
	block(folder, "Roof", Vector3.new(11, 0.8, 11), CFrame.new(x, 12.4, z), COLORS.dark, Enum.Material.Metal)
	local lamp = block(folder, "Lamp", Vector3.new(6, 0.2, 6), CFrame.new(x, 11.9, z), accent, Enum.Material.Neon)
	lamp.CanCollide = false
	local light = Instance.new("PointLight")
	light.Color = accent
	light.Range = 16
	light.Brightness = 1.5
	light.Parent = lamp
	-- Cables running up into the dark, so it reads as a lift shaft.
	for _, side in { -1, 1 } do
		local cable = block(
			folder,
			"Cable",
			Vector3.new(0.3, 60, 0.3),
			CFrame.new(x + side * 3, 42.8, z + 3),
			COLORS.dark,
			Enum.Material.Metal
		)
		cable.CanCollide = false
	end

	-- Tall roomy trigger so standing anywhere in the cabin counts (R15 root ~3 studs up).
	local zone = block(folder, "Zone", Vector3.new(10, 12, 10), CFrame.new(x, 6, z), accent)
	zone.Transparency = 1
	zone.CanCollide = false
	zone.CanQuery = false
	zone.CanTouch = false

	-- Backup interact if zone edge-cases miss a step-in (mobile especially).
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "LiftEnterPrompt"
	prompt.ActionText = "ЛІФТ"
	prompt.ObjectText = "Skyline Zero"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = zone

	-- Head count only (e.g. "2 / 4"); no Solo/2/4/6 capacity signs on the cabin.
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(140, 60)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 15.5, 0)
	billboard.LightInfluence = 0
	billboard.MaxDistance = 140
	billboard.Adornee = zone
	billboard.Parent = zone
	local status = textLabel(billboard, nil, UDim2.fromScale(1, 1), UDim2.new())
	status.FontFace = Theme.Display
	status.TextColor3 = accent
	status.TextStrokeTransparency = 0.2
	status.Text = "—"
	return { zone = zone, statusLabel = status }
end

function LobbyWorld.Build(): Refs
	local root = Instance.new("Folder")
	root.Name = "LobbyWorld"

	-- Plaza and debris.
	block(root, "Ground", Vector3.new(240, 2, 240), CFrame.new(0, -1, 0), COLORS.ground, Enum.Material.Asphalt)
	block(root, "Plaza", Vector3.new(110, 0.4, 90), CFrame.new(0, 0.2, 5), COLORS.concrete, Enum.Material.Concrete)
	local rng = Random.new(77)
	for _ = 1, 26 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local dist = rng:NextNumber(62, 110)
		local s = rng:NextNumber(3, 9)
		local chunk = block(
			root,
			"Debris",
			Vector3.new(s, s * rng:NextNumber(0.4, 1), s * rng:NextNumber(0.6, 1.4)),
			CFrame.new(math.cos(angle) * dist, s * 0.3, math.sin(angle) * dist)
				* CFrame.Angles(0, rng:NextNumber(0, 3), rng:NextNumber(-0.3, 0.3)),
			COLORS.rubble,
			Enum.Material.Slate
		)
		chunk.CastShadow = true
	end

	-- The tower itself rises behind the lifts and disappears into the haze, overgrown like the rest of the city.
	block(root, "Tower", Vector3.new(130, 420, 40), CFrame.new(0, 210, 78), COLORS.concrete, Enum.Material.Concrete).CastShadow =
		false
	Scenery.Dress(root, Vector3.new(0, 0, 78), 130, 40, 420, Random.new(5), false)
	Scenery.Skyline(root, Vector3.zero, 12, 170, 260, 120, 320, 9, { { Vector3.new(0, 0, 78), 120 } })

	-- Street around the plaza: lamps that still work, wrecked cars, plants pushing through the asphalt.
	local street = Random.new(31)
	for _, x in { -52, -26, 26, 52 } do
		for _, z in { -36, 20 } do
			block(root, "LampPost", Vector3.new(0.6, 12, 0.6), CFrame.new(x, 6, z), COLORS.dark, Enum.Material.Metal)
			local bulb = block(
				root,
				"LampBulb",
				Vector3.new(1.6, 0.8, 1.6),
				CFrame.new(x, 12.2, z),
				Color3.fromRGB(255, 226, 170),
				Enum.Material.Neon
			)
			bulb.CanCollide = false
			local glow = Instance.new("PointLight")
			glow.Color = Color3.fromRGB(255, 214, 160)
			glow.Range = 30
			glow.Brightness = 1.6
			glow.Shadows = true
			glow.Parent = bulb
		end
	end
	for _, car in { { -40, -8, 0.4 }, { 44, -28, -0.6 }, { -18, -52, 1.2 } } do
		local carColor = Color3.fromHSV(street:NextNumber(), 0.35, 0.45)
		local body = block(
			root,
			"WreckedCar",
			Vector3.new(6, 2.4, 13),
			CFrame.new(car[1], 1.5, car[2]) * CFrame.Angles(0, car[3], 0.06),
			carColor,
			Enum.Material.CorrodedMetal
		)
		block(
			root,
			"CarRoof",
			Vector3.new(5.4, 1.8, 6),
			body.CFrame * CFrame.new(0, 2, 0.5),
			carColor,
			Enum.Material.CorrodedMetal
		)
		Scenery.Grass(root, Vector3.new(car[1], 0, car[2]), Vector2.new(9, 15), street)
	end
	for _ = 1, 18 do
		local x = street:NextNumber(-70, 70)
		local z = street:NextNumber(-60, 30)
		if math.abs(x) &gt; 30 or z &lt; -40 then
			Scenery.Grass(
				root,
				Vector3.new(x, 0.4, z),
				Vector2.new(street:NextNumber(5, 12), street:NextNumber(5, 12)),
				street
			)
		end
	end
	for _, p in { { -60, -20 }, { 62, 4 }, { -64, 26 }, { 58, -44 }, { -30, -58 } } do
		Scenery.Tree(root, Vector3.new(p[1], 0, p[2]), street:NextNumber(18, 26), street)
	end
	for _, p in { { -36, 28 }, { 36, 28 }, { -12, -44 }, { 14, -46 } } do
		Scenery.Bush(root, Vector3.new(p[1], 0.4, p[2]), 4, street)
	end

	-- Floodlights on the lifts so the boarding area reads as the safe, lit place.
	for _, x in { -30, 0, 30 } do
		local flood = block(
			root,
			"Floodlight",
			Vector3.new(2, 1, 1),
			CFrame.new(x, 20, 34) * CFrame.Angles(math.rad(-40), 0, 0),
			COLORS.metal,
			Enum.Material.Metal
		)
		local beam = Instance.new("SpotLight")
		beam.Face = Enum.NormalId.Front
		beam.Angle = 80
		beam.Range = 40
		beam.Brightness = 2.2
		beam.Color = Color3.fromRGB(255, 236, 205)
		beam.Parent = flood
	end

	-- Two identical boarding lifts; party size 1–6 is chosen in a ScreenGui modal after stepping in.
	local lifts: { [string]: LiftRefs } = {}
	local count = #PlacesConfig.Lifts
	for i, def in PlacesConfig.Lifts do
		local x = (i - (count + 1) / 2) * 18
		lifts[def.id] = buildLift(root, def, x, 40)
	end

	-- Spawn facing the lifts.
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(0, 0.5, -25)
	spawn.Color = Color3.fromRGB(70, 110, 160)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = root

	-- Title, hint, how to play, leaderboard.
	local titleGui = board(root, "TitleBoard", Vector2.new(40, 8), CFrame.new(0, 26, 57.5))
	textLabel(titleGui, "lobby.title", UDim2.fromScale(1, 0.62), UDim2.new()).FontFace = Theme.Display
	textLabel(titleGui, "lobby.hint", UDim2.fromScale(1, 0.32), UDim2.fromScale(0, 0.64))

	local howGui =
		board(root, "HowToPlay", Vector2.new(16, 12), CFrame.new(46, 7, 0) * CFrame.Angles(0, math.pi / 2, 0))
	textLabel(howGui, "lobby.howTitle", UDim2.fromScale(1, 0.16), UDim2.fromScale(0, 0.02))
	local howBody = textLabel(howGui, "lobby.howBody", UDim2.fromScale(0.92, 0.78), UDim2.fromScale(0.04, 0.2))
	howBody.TextXAlignment = Enum.TextXAlignment.Left
	howBody.TextYAlignment = Enum.TextYAlignment.Top
	howBody.FontFace = Theme.Body
	howBody.TextColor3 = Color3.fromRGB(235, 235, 235)

	local leadersGui =
		board(root, "Leaderboard", Vector2.new(16, 14), CFrame.new(-46, 8, 0) * CFrame.Angles(0, -math.pi / 2, 0))
	textLabel(leadersGui, "lobby.leaders", UDim2.fromScale(1, 0.13), UDim2.fromScale(0, 0.02))
	local rows = {}
	for i = 1, PlacesConfig.LeaderboardSize do
		local row =
			textLabel(leadersGui, nil, UDim2.fromScale(0.9, 0.08), UDim2.fromScale(0.05, 0.16 + (i - 1) * 0.083))
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.FontFace = Theme.Body
		row.TextColor3 = Color3.fromRGB(235, 235, 235)
		rows[i] = row
	end

	root.Parent = workspace
	return { lifts = lifts, leaderboardRows = rows }
end

return LobbyWorld
</string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="18">
      <Properties>
        <string name="Name">Atmosphere</string>
        <string name="Source">--!strict
-- Shared look: gloomy post-apoc (The Last of Us), not a bright botanical afternoon.
-- Lobby matches the tower grade so the elevator drop does not flip the lighting mood.

local Lighting = game:GetService("Lighting")

local Atmosphere = {}

function Atmosphere.Apply()
	Lighting.ClockTime = 17.2
	Lighting.GeographicLatitude = 35
	Lighting.Brightness = 1.6
	Lighting.ExposureCompensation = -0.15
	Lighting.Ambient = Color3.fromRGB(42, 44, 48)
	Lighting.OutdoorAmbient = Color3.fromRGB(88, 90, 96)
	Lighting.ColorShift_Top = Color3.fromRGB(180, 175, 165)
	Lighting.ColorShift_Bottom = Color3.fromRGB(40, 42, 48)
	Lighting.EnvironmentDiffuseScale = 0.35
	Lighting.EnvironmentSpecularScale = 0.2
	Lighting.ShadowSoftness = 0.45
	Lighting.GlobalShadows = true

	for _, child in Lighting:GetChildren() do
		if child:IsA("Atmosphere") or child:IsA("Sky") or child:IsA("PostEffect") then
			child:Destroy()
		end
	end

	local sky = Instance.new("Sky")
	sky.SunAngularSize = 8
	sky.MoonAngularSize = 0
	sky.StarCount = 0
	sky.Parent = Lighting

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.38
	atmosphere.Offset = 0.15
	atmosphere.Haze = 2.4
	atmosphere.Glare = 0.12
	atmosphere.Color = Color3.fromRGB(140, 138, 132)
	atmosphere.Decay = Color3.fromRGB(70, 72, 68)
	atmosphere.Parent = Lighting

	local terrain = workspace.Terrain
	local clouds = terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover = 0.78
	clouds.Density = 0.65
	clouds.Color = Color3.fromRGB(160, 160, 158)
	clouds.Parent = terrain

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.02
	rays.Spread = 0.35
	rays.Parent = Lighting

	local grading = Instance.new("ColorCorrectionEffect")
	grading.TintColor = Color3.fromRGB(235, 232, 225)
	grading.Saturation = -0.12
	grading.Contrast = 0.08
	grading.Brightness = -0.04
	grading.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.12
	bloom.Size = 18
	bloom.Threshold = 2.2
	bloom.Parent = Lighting

	local blur = Instance.new("DepthOfFieldEffect")
	blur.FarIntensity = 0.15
	blur.FocusDistance = 40
	blur.InFocusRadius = 50
	blur.NearIntensity = 0
	blur.Parent = Lighting
end

return Atmosphere
</string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="19">
      <Properties>
        <string name="Name">Scenery</string>
        <string name="Source">--!strict
-- Post-apocalyptic set dressing shared by the lobby and the tower: ruined high-rises taken over by plants,
-- grass patches, bushes, trees and hanging vines. Plain Parts only, built once at server start.

local Scenery = {}

local PALETTE = {
	concrete = { Color3.fromRGB(150, 142, 128), Color3.fromRGB(128, 122, 112), Color3.fromRGB(112, 104, 96) },
	brick = Color3.fromRGB(122, 78, 58),
	window = Color3.fromRGB(38, 44, 48),
	lit = Color3.fromRGB(255, 196, 120),
	rust = Color3.fromRGB(124, 72, 44),
	moss = Color3.fromRGB(86, 110, 52),
	leaf = { Color3.fromRGB(78, 112, 48), Color3.fromRGB(96, 128, 56), Color3.fromRGB(64, 92, 44) },
	grass = Color3.fromRGB(104, 124, 62),
	bark = Color3.fromRGB(84, 64, 46),
}

local function part(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material
): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function pick&lt;T&gt;(rng: Random, list: { T }): T
	return list[rng:NextInteger(1, #list)]
end

-- Ivy hanging down a wall from `top`, `length` studs long, on a face whose outward normal is `normal`.
function Scenery.Vine(parent: Instance, top: Vector3, length: number, normal: Vector3, rng: Random)
	local width = rng:NextNumber(1.5, 4)
	local strand = part(
		parent,
		"Vine",
		Vector3.new(width, length, 0.3),
		CFrame.lookAt(top - Vector3.new(0, length / 2, 0) + normal * 0.25, top - Vector3.new(0, length / 2, 0) + normal),
		pick(rng, PALETTE.leaf),
		Enum.Material.Grass
	)
	strand.CanCollide = false
	strand.CastShadow = false
	return strand
end

-- Low patch of overgrown grass lying on a surface.
function Scenery.Grass(parent: Instance, center: Vector3, size: Vector2, rng: Random)
	local patch = part(
		parent,
		"Grass",
		Vector3.new(size.X, 0.25, size.Y),
		CFrame.new(center + Vector3.new(0, 0.125, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0),
		PALETTE.grass:Lerp(pick(rng, PALETTE.leaf), rng:NextNumber()),
		Enum.Material.Grass
	)
	patch.CanCollide = false
	patch.CastShadow = false
	return patch
end

function Scenery.Bush(parent: Instance, base: Vector3, size: number, rng: Random)
	for i = 1, 3 do
		local s = size * rng:NextNumber(0.6, 1)
		local ball = part(
			parent,
			"Bush",
			Vector3.new(s, s * 0.8, s),
			CFrame.new(
				base + Vector3.new(rng:NextNumber(-size, size) * 0.4, s * 0.35, rng:NextNumber(-size, size) * 0.4)
			),
			pick(rng, PALETTE.leaf),
			Enum.Material.Grass
		)
		ball.Shape = Enum.PartType.Ball
		ball.CanCollide = i == 1
	end
end

function Scenery.Tree(parent: Instance, base: Vector3, height: number, rng: Random)
	local trunk = part(
		parent,
		"Trunk",
		Vector3.new(height * 0.08, height * 0.6, height * 0.08),
		CFrame.new(base + Vector3.new(0, height * 0.3, 0))
			* CFrame.Angles(rng:NextNumber(-0.08, 0.08), 0, rng:NextNumber(-0.08, 0.08)),
		PALETTE.bark,
		Enum.Material.Wood
	)
	trunk.CastShadow = true
	for _ = 1, 4 do
		local s = height * rng:NextNumber(0.35, 0.5)
		local crown = part(
			parent,
			"Leaves",
			Vector3.new(s, s * 0.85, s),
			CFrame.new(
				base
					+ Vector3.new(
						rng:NextNumber(-1, 1) * s * 0.4,
						height * rng:NextNumber(0.62, 0.85),
						rng:NextNumber(-1, 1) * s * 0.4
					)
			),
			pick(rng, PALETTE.leaf),
			Enum.Material.Grass
		)
		crown.Shape = Enum.PartType.Ball
		crown.CanCollide = false
	end
end

-- A ruined high-rise: window bands, a few lit windows, a broken crown, rooftop junk and plants growing over it.
function Scenery.Building(parent: Instance, base: Vector3, width: number, depth: number, height: number, rng: Random)
	local model = Instance.new("Model")
	model.Name = "Ruin"
	model.Parent = parent
	local body = part(
		model,
		"Body",
		Vector3.new(width, height, depth),
		CFrame.new(base + Vector3.new(0, height / 2, 0)),
		if rng:NextNumber() &lt; 0.25 then PALETTE.brick else pick(rng, PALETTE.concrete),
		Enum.Material.Concrete
	)
	body.CastShadow = false
	Scenery.Dress(model, base, width, depth, height, rng, true)
	return model
end

-- Window bands, lit windows, ivy and (optionally) a broken crown with a green roof around an existing box
-- whose bottom centre is `base`. Used for skyline ruins and for the bodies of the two playable towers.
function Scenery.Dress(
	model: Instance,
	base: Vector3,
	width: number,
	depth: number,
	height: number,
	rng: Random,
	withCrown: boolean
)
	local bodyColor = pick(rng, PALETTE.concrete)
	-- Window bands wrap all four sides in one part each.
	local floorHeight = rng:NextNumber(10, 14)
	local y = 8
	while y &lt; height - 10 do
		local band = part(
			model,
			"Windows",
			Vector3.new(width + 0.4, floorHeight * 0.45, depth + 0.4),
			CFrame.new(base + Vector3.new(0, y, 0)),
			PALETTE.window,
			Enum.Material.Glass
		)
		band.CastShadow = false
		y += floorHeight
	end
	for _ = 1, rng:NextInteger(3, 8) do
		local side = rng:NextInteger(0, 3)
		local h = rng:NextNumber(10, height - 12)
		local offset = rng:NextNumber(-0.4, 0.4)
		local pos, size
		if side &lt; 2 then
			pos = Vector3.new(offset * width, h, (side * 2 - 1) * (depth / 2 + 0.25))
			size = Vector3.new(3, 3, 0.2)
		else
			pos = Vector3.new((side * 2 - 5) * (width / 2 + 0.25), h, offset * depth)
			size = Vector3.new(0.2, 3, 3)
		end
		local lit = part(model, "Lit", size, CFrame.new(base + pos), PALETTE.lit, Enum.Material.Neon)
		lit.CanCollide = false
		lit.CastShadow = false
	end

	-- Ivy down the walls.
	local normals = {
		{ Vector3.new(0, 0, -1), Vector3.new(0, 0, -depth / 2) },
		{ Vector3.new(0, 0, 1), Vector3.new(0, 0, depth / 2) },
		{ Vector3.new(-1, 0, 0), Vector3.new(-width / 2, 0, 0) },
		{ Vector3.new(1, 0, 0), Vector3.new(width / 2, 0, 0) },
	}
	for _ = 1, rng:NextInteger(3, 7) do
		local face = normals[rng:NextInteger(1, 4)]
		local along = Vector3.new(face[1].Z, 0, face[1].X) * rng:NextNumber(-0.4, 0.4) * math.max(width, depth)
		local length = rng:NextNumber(height * 0.15, height * 0.6)
		local startY = rng:NextNumber(length, height)
		Scenery.Vine(model, base + face[2] + along + Vector3.new(0, startY, 0) + face[1] * 0.3, length, face[1], rng)
	end
	if not withCrown then
		return
	end

	-- Broken crown: slabs knocked askew and a leaning rooftop tank.
	local top = base + Vector3.new(0, height, 0)
	for _ = 1, rng:NextInteger(2, 4) do
		local s =
			Vector3.new(width * rng:NextNumber(0.25, 0.5), rng:NextNumber(3, 8), depth * rng:NextNumber(0.25, 0.5))
		part(
			model,
			"Crown",
			s,
			CFrame.new(
				top + Vector3.new(rng:NextNumber(-0.3, 0.3) * width, s.Y / 2 - 1, rng:NextNumber(-0.3, 0.3) * depth)
			) * CFrame.Angles(rng:NextNumber(-0.2, 0.2), rng:NextNumber(0, 1), rng:NextNumber(-0.2, 0.2)),
			bodyColor:Lerp(Color3.new(0, 0, 0), 0.15),
			Enum.Material.Concrete
		).CastShadow =
			false
	end
	if rng:NextNumber() &lt; 0.6 then
		local tank = part(
			model,
			"Tank",
			Vector3.new(8, 7, 7),
			CFrame.new(top + Vector3.new(rng:NextNumber(-0.3, 0.3) * width, 4.5, rng:NextNumber(-0.3, 0.3) * depth))
				* CFrame.Angles(0, 0, math.pi / 2 + rng:NextNumber(-0.15, 0.15)),
			PALETTE.rust,
			Enum.Material.CorrodedMetal
		)
		tank.Shape = Enum.PartType.Cylinder
		tank.CastShadow = false
	end

	-- Nature taking it back: a green roof.
	Scenery.Grass(model, top, Vector2.new(width * 0.8, depth * 0.8), rng)
	if rng:NextNumber() &lt; 0.5 then
		Scenery.Tree(
			model,
			top + Vector3.new(rng:NextNumber(-0.25, 0.25) * width, 0, rng:NextNumber(-0.25, 0.25) * depth),
			rng:NextNumber(10, 18),
			rng
		)
	end
end

-- A ring of ruins around `center`, skipping anything inside `keepClear` (a list of { center, radius }).
function Scenery.Skyline(
	parent: Instance,
	center: Vector3,
	count: number,
	minDistance: number,
	maxDistance: number,
	minHeight: number,
	maxHeight: number,
	seed: number,
	keepClear: { { Vector3 | number } }?
)
	local folder = Instance.new("Folder")
	folder.Name = "Skyline"
	folder.Parent = parent
	local rng = Random.new(seed)
	for i = 1, count do
		local angle = (i / count) * math.pi * 2 + rng:NextNumber(-0.15, 0.15)
		local distance = rng:NextNumber(minDistance, maxDistance)
		local pos = center + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
		local clear = true
		if keepClear then
			for _, zone in keepClear do
				local zc = zone[1] :: Vector3
				local zr = zone[2] :: number
				if (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(zc.X, 0, zc.Z)).Magnitude &lt; zr then
					clear = false
				end
			end
		end
		if clear then
			Scenery.Building(
				folder,
				pos,
				rng:NextNumber(36, 70),
				rng:NextNumber(36, 70),
				rng:NextNumber(minHeight, maxHeight),
				rng
			)
		end
	end
	return folder
end

return Scenery
</string>
      </Properties>
    </Item>
  </Item>
  <Item class="SoundService" referent="20">
