      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Lang</string>
          <string name="Source">--!strict
-- Client-side translation helpers. Static labels register with Lang.Bind and refresh on a language change;
-- everything else re-renders from the state snapshot (Lang.Changed re-fires it).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Locale = require(ReplicatedStorage.Shared.Locale)

local Lang = {}

local player = Players.LocalPlayer
local changed = Instance.new("BindableEvent")
Lang.Changed = changed.Event

type Binding = { key: string, args: { any } }
local bindings: { [Instance]: Binding } = {}

function Lang.Get(): Locale.Lang
	return Locale.ForPlayer(player)
end

function Lang.T(key: string, ...: any): string
	return Locale.T(Lang.Get(), key, ...)
end

function Lang.Format(message: any): string
	return Locale.Format(Lang.Get(), message)
end

-- Keeps a TextLabel / TextButton translated: Text = T(key, ...), now and after every language change.
function Lang.Bind(instance: Instance, key: string, ...: any)
	local target: any = instance
	target.Text = Lang.T(key, ...)
	bindings[instance] = { key = key, args = { ... } }
	instance.Destroying:Once(function()
		bindings[instance] = nil
	end)
end

function Lang.Cycle(): Locale.Lang
	local current = Lang.Get()
	local list = Locale.Languages
	local index = table.find(list, current) or 0
	return list[index % #list + 1]
end

function Lang.Set(code: Locale.Lang)
	-- Applied locally right away; the server saves it and sets the same attribute for everyone.
	player:SetAttribute("Language", code)
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local remote = remotes and remotes:FindFirstChild("SetLanguage")
	if remote and remote:IsA("RemoteEvent") then
		remote:FireServer(code)
	end
end

local last = Lang.Get()
player:GetAttributeChangedSignal("Language"):Connect(function()
	local now = Lang.Get()
	if now == last then
		return
	end
	last = now
	for instance, binding in bindings do
		local target: any = instance
		target.Text = Lang.T(binding.key, table.unpack(binding.args))
	end
	changed:Fire(now)
end)

return Lang
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">UIKit</string>
          <string name="Source">--!strict
-- Tiny helpers for building UI in code with a consistent look.

local Theme = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Theme"))
local Players = game:GetService("Players")

local UIKit = {}

UIKit.Colors = {
	panel = Color3.fromRGB(22, 24, 28),
	panelLight = Color3.fromRGB(38, 41, 47),
	text = Color3.fromRGB(235, 235, 235),
	muted = Color3.fromRGB(165, 168, 175),
	accent = Color3.fromRGB(255, 196, 64),
	good = Color3.fromRGB(110, 210, 120),
	warn = Color3.fromRGB(255, 170, 60),
	bad = Color3.fromRGB(235, 80, 70),
	health = Color3.fromRGB(200, 60, 60),
	toxic = Color3.fromRGB(140, 230, 80),
}

function UIKit.New(className: string, props: { [string]: any }, children: { Instance }?): any
	local instance = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			(instance :: any)[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function UIKit.Corner(radius: number?): UICorner
	return UIKit.New("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

function UIKit.Padding(px: number): UIPadding
	return UIKit.New("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
	})
end

function UIKit.Panel(props: { [string]: any }): Frame
	local merged = {
		BackgroundColor3 = UIKit.Colors.panel,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
	}
	for k, v in props do
		merged[k] = v
	end
	return UIKit.New("Frame", merged, { UIKit.Corner(10) })
end

function UIKit.Label(props: { [string]: any }): TextLabel
	local merged = {
		BackgroundTransparency = 1,
		FontFace = Theme.Body,
		TextColor3 = UIKit.Colors.text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	}
	for k, v in props do
		merged[k] = v
	end
	return UIKit.New("TextLabel", merged)
end

function UIKit.Button(props: { [string]: any }): TextButton
	local merged = {
		BackgroundColor3 = UIKit.Colors.panelLight,
		BorderSizePixel = 0,
		FontFace = Theme.Bold,
		TextColor3 = UIKit.Colors.text,
		TextSize = 16,
		AutoButtonColor = true,
	}
	for k, v in props do
		merged[k] = v
	end
	return UIKit.New("TextButton", merged, { UIKit.Corner(8) })
end

-- Single ScreenGui shared by all controllers.
local screen: ScreenGui? = nil
function UIKit.Screen(): ScreenGui
	if screen then
		return screen
	end
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gui = UIKit.New("ScreenGui", {
		Name = "SkylineUI",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})
	-- Scale the whole UI down on small screens (phones) and keep it 1:1 on PC, tablets and TVs.
	local scale = UIKit.New("UIScale", { Parent = gui })
	local function updateScale()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local viewport = camera.ViewportSize
		scale.Scale = math.clamp(math.min(viewport.X / 1100, viewport.Y / 620), 0.6, 1)
	end
	updateScale()
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(updateScale)
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
	screen = gui
	return gui
end

return UIKit
</string>
        </Properties>
      </Item>
    </Item>
  </Item>
